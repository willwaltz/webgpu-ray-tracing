+// found in the LICENSE file.
+
+// Non-standard, see gpu_acceleration_structure.idl.
+
+// Bits: ALLOW_UPDATE = 0x1, PREFER_FAST_TRACE = 0x2, PREFER_FAST_BUILD = 0x4,
+// LOW_MEMORY = 0x8.
+typedef [EnforceRange] unsigned long GPUAccelerationStructureFlags;
+// Bits: OPAQUE = 0x1, NO_DUPLICATE_ANY_HIT = 0x2.
+typedef [EnforceRange] unsigned long GPUAccelerationStructureGeometryFlags;
+
+enum GPUAccelerationStructureGeometryType {
+    "triangles",
+    "aabbs",
+};
+
+// The largest geometry a bottom-level structure can be built from.
+dictionary GPUAccelerationStructureGeometryLayout {
+    required GPUAccelerationStructureGeometryType type;
+    GPUAccelerationStructureGeometryFlags flags = 0;
+    GPUVertexFormat vertexFormat = "float32x3";
+    GPUSize32 maxVertexCount = 0;
+    GPUIndexFormat indexFormat;
+    required GPUSize32 maxPrimitiveCount;
+};
+
+dictionary GPUAccelerationStructureDescriptor : GPUObjectDescriptorBase {
+    required GPUAccelerationStructureType type;
+    GPUAccelerationStructureFlags flags = 2;
+    // Bottom level only.
+    sequence<GPUAccelerationStructureGeometryLayout> geometries = [];
+    // Top level only.
+    GPUSize32 maxInstanceCount = 0;
+};
