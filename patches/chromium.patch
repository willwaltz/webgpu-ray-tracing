+namespace {
+
+wgpu::AccelerationStructureType AsDawnEnum(
+    V8GPUAccelerationStructureType::Enum type) {
+  switch (type) {
+    case V8GPUAccelerationStructureType::Enum::kBottomLevel:
+      return wgpu::AccelerationStructureType::BottomLevel;
+    case V8GPUAccelerationStructureType::Enum::kTopLevel:
+      return wgpu::AccelerationStructureType::TopLevel;
+  }
+}
+
+wgpu::AccelerationStructureGeometryType AsDawnEnum(
+    V8GPUAccelerationStructureGeometryType::Enum type) {
+  switch (type) {
+    case V8GPUAccelerationStructureGeometryType::Enum::kTriangles:
+      return wgpu::AccelerationStructureGeometryType::Triangles;
+    case V8GPUAccelerationStructureGeometryType::Enum::kAabbs:
+      return wgpu::AccelerationStructureGeometryType::AABBs;
+  }
+}
+
+wgpu::AccelerationStructureBuildMode AsDawnEnum(
+    V8GPUAccelerationStructureBuildMode::Enum mode) {
+  switch (mode) {
+    case V8GPUAccelerationStructureBuildMode::Enum::kBuild:
+      return wgpu::AccelerationStructureBuildMode::Build;
+    case V8GPUAccelerationStructureBuildMode::Enum::kUpdate:
+      return wgpu::AccelerationStructureBuildMode::Update;
+  }
+}
+
+wgpu::AccelerationStructureGeometryLayout AsDawnType(
+    const GPUAccelerationStructureGeometryLayout* webgpu_layout) {
+  wgpu::AccelerationStructureGeometryLayout dawn_layout = {
+      .type = AsDawnEnum(webgpu_layout->type().AsEnum()),
+      .flags = static_cast<wgpu::AccelerationStructureGeometryFlags>(
+          webgpu_layout->flags()),
+      .vertexFormat = blink::AsDawnEnum(webgpu_layout->vertexFormat()),
+      .maxVertexCount = webgpu_layout->maxVertexCount(),
+      .maxPrimitiveCount = webgpu_layout->maxPrimitiveCount(),
+  };
+  if (webgpu_layout->hasIndexFormat()) {
+    dawn_layout.indexFormat = blink::AsDawnEnum(webgpu_layout->indexFormat());
+  }
+  return dawn_layout;
+}
+
+wgpu::AccelerationStructureGeometryData AsDawnType(
+    const GPUAccelerationStructureGeometryData* webgpu_data) {
+  wgpu::AccelerationStructureGeometryData dawn_data = {
+      .vertexOffset = webgpu_data->vertexOffset(),
+      .vertexStride = webgpu_data->vertexStride(),
+      .vertexCount = webgpu_data->vertexCount(),
+      .indexOffset = webgpu_data->indexOffset(),
+      .AABBOffset = webgpu_data->aabbOffset(),
+      .AABBStride = webgpu_data->aabbStride(),
+      .primitiveCount = webgpu_data->primitiveCount(),
+  };
+  if (webgpu_data->hasVertexBuffer()) {
+    dawn_data.vertexBuffer = webgpu_data->vertexBuffer()->GetHandle();
+  }
+  if (webgpu_data->hasIndexBuffer()) {
+    dawn_data.indexBuffer = webgpu_data->indexBuffer()->GetHandle();
+  }
+  if (webgpu_data->hasAabbBuffer()) {
+    dawn_data.AABBBuffer = webgpu_data->aabbBuffer()->GetHandle();
+  }
+  return dawn_data;
+}
+
+}  // namespace
+
+// static
+GPUAccelerationStructure* GPUAccelerationStructure::Create(
+    GPUDevice* device,
+    const GPUAccelerationStructureDescriptor* webgpu_desc,
+    ExceptionState& exception_state) {
+  DCHECK(device);
+  DCHECK(webgpu_desc);
+
+  constexpr auto kRayQuery =
+      V8GPUFeatureName::Enum::kChromiumExperimentalRayQuery;
+  if (!device->features()->Has(kRayQuery)) {
+    exception_state.ThrowTypeError(
+        StrCat({"Acceleration structures require the '",
+                V8GPUFeatureName(kRayQuery).AsStringView(),
+                "' feature to be enabled on ", device->GetFormattedLabel(),
+                "."}));
+    return nullptr;
+  }
+
+  std::vector<wgpu::AccelerationStructureGeometryLayout> geometries;
+  geometries.reserve(webgpu_desc->geometries().size());
+  for (const auto& layout : webgpu_desc->geometries()) {
+    geometries.push_back(AsDawnType(layout.Get()));
+  }
+
+  V8GPUAccelerationStructureType::Enum type = webgpu_desc->type().AsEnum();
+  wgpu::AccelerationStructureDescriptor dawn_desc = {
+      .type = AsDawnEnum(type),
+      .flags = static_cast<wgpu::AccelerationStructureFlags>(
+          webgpu_desc->flags()),
+      .geometryCount = geometries.size(),
+      .geometries = geometries.data(),
+      .maxInstanceCount = webgpu_desc->maxInstanceCount(),
+  };
+
+  std::string label = webgpu_desc->label().Utf8();
+  if (!label.empty()) {
+    dawn_desc.label = label.c_str();
+  }
+
+  return MakeGarbageCollected<GPUAccelerationStructure>(
+      device, device->GetHandle().CreateAccelerationStructure(&dawn_desc),
+      type, webgpu_desc->label());
+}
+
+// static
+void GPUAccelerationStructure::EncodeBuild(
+    const wgpu::CommandEncoder& encoder,
+    const GPUAccelerationStructureBuildDescriptor* webgpu_desc) {
+  std::vector<wgpu::AccelerationStructureGeometryData> geometries;
+  geometries.reserve(webgpu_desc->geometries().size());
+  for (const auto& data : webgpu_desc->geometries()) {
+    geometries.push_back(AsDawnType(data.Get()));
+  }
+
+  wgpu::AccelerationStructureBuildDescriptor dawn_desc = {
+      .destination = webgpu_desc->destination()->GetHandle(),
+      .mode = AsDawnEnum(webgpu_desc->mode().AsEnum()),
+      .geometryCount = geometries.size(),
+      .geometries = geometries.data(),
+      .instanceCount = webgpu_desc->instanceCount(),
+  };
+  encoder.BuildAccelerationStructure(&dawn_desc);
+}
+
+GPUAccelerationStructure::GPUAccelerationStructure(
+    GPUDevice* device,
+    wgpu::AccelerationStructure acceleration_structure,
+    V8GPUAccelerationStructureType::Enum type,
+    const String& label)
+    : DawnObject<wgpu::AccelerationStructure>(device,
+                                              std::move(acceleration_structure),
+                                              label),
+      type_(type) {}
+
+void GPUAccelerationStructure::destroy() {
+  GetHandle().Destroy();
+}
