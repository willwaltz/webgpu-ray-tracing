+void GPUQueue::writeAccelerationStructureInstances(
+    ScriptState* script_state,
+    GPUAccelerationStructure* destination,
+    uint32_t first_instance,
+    const HeapVector<Member<GPUAccelerationStructure>>& blases,
+    const MaybeShared<DOMArrayBufferView>& data,
+    ExceptionState& exception_state) {
+  // Dawn validates the records themselves (the bottom levels they name, the
+  // room in the destination); here only that they are whole.
+  constexpr size_t kInstanceBytes = 64;
+  base::span<const uint8_t> bytes = data->ByteSpanMaybeShared();
+  if (bytes.size() % kInstanceBytes != 0) {
+    exception_state.ThrowDOMException(
+        DOMExceptionCode::kOperationError,
+        "Instance data must be a whole number of 64-byte records");
+    return;
+  }
+  std::vector<wgpu::AccelerationStructure> dawn_blases;
+  dawn_blases.reserve(blases.size());
+  for (const auto& blas : blases) {
+    dawn_blases.push_back(blas->GetHandle());
+  }
+  GetHandle().WriteAccelerationStructureInstances(
+      destination->GetHandle(), first_instance, dawn_blases.size(),
+      dawn_blases.data(), bytes.data(), bytes.size());
+  EnsureFlush(ToEventLoop(script_state));
+}
