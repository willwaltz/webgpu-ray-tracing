+dictionary GPUAccelerationStructureGeometryData {
+    GPUBuffer vertexBuffer;
+    GPUSize64 vertexOffset = 0;
+    GPUSize64 vertexStride = 0;
+    GPUSize32 vertexCount = 0;
+    GPUBuffer indexBuffer;
+    GPUSize64 indexOffset = 0;
+    GPUBuffer aabbBuffer;
+    GPUSize64 aabbOffset = 0;
+    GPUSize64 aabbStride = 24;
+    required GPUSize32 primitiveCount;
+};
+
+dictionary GPUAccelerationStructureBuildDescriptor {
+    required GPUAccelerationStructure destination;
+    GPUAccelerationStructureBuildMode mode = "build";
+    // Bottom level only.
+    sequence<GPUAccelerationStructureGeometryData> geometries = [];
+    // Top level only: instances [0, instanceCount) of the structure's
+    // instance table, written with GPUQueue.writeAccelerationStructureInstances.
+    GPUSize32 instanceCount = 0;
+};
