+TEST_F(SpirvWriterRayQueryTest, Initialize_ValidatesRay) {
+    // The ray descriptor is a function parameter, as the builder folds the validation of a constant
+    // ray descriptor into a constant.
+    auto* tlas = Tlas();
+    auto* desc = b.FunctionParam("desc", RayDesc());
+    auto* fn = b.Function("foo", ty.void_());
+    fn->SetParams({desc});
+    b.Append(fn->Block(), [&] {
+        auto* rq = b.Var("rq", ty.ptr(function, ty.ray_query()));
+        b.Call(ty.void_(), core::BuiltinFn::kRayQueryInitialize, rq, b.Load(tlas), desc);
+        b.Return(fn);
+    });
+    auto* ep = b.ComputeFunction("main");
+    b.Append(ep->Block(), [&] {
+        b.Call(fn, b.Zero(RayDesc()));
+        b.Return(ep);
+    });
+
+    auto result = Generate();
+    ASSERT_EQ(result, Success) << result.Failure() << output_;
+    // Skip triangles and skip AABBs are mutually exclusive.
+    EXPECT_INST("%uint_768");
+    // At most one of skip triangles, cull back facing, cull front facing.
+    EXPECT_INST("%uint_304");
+    // At most one of opaque, no opaque, cull opaque, cull no opaque.
+    EXPECT_INST("%uint_195");
+    // Exponent mask, used to check that the origin and direction are finite.
+    EXPECT_INST("%uint_2139095040");
+    EXPECT_INST("OpFOrdGreaterThanEqual %bool");
+    EXPECT_INST("OpFOrdLessThanEqual %bool");
+}
