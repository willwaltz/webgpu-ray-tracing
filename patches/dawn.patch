+// Validates the acceleration structures used by a command buffer at submit time. `buildsInSubmit`
+// contains the builds of the previous command buffers of the submit and is updated with the builds
+// of this command buffer.
+MaybeError ValidateAccelerationStructureUsages(
+    const CommandBufferResourceUsage& usages,
+    AccelerationStructureBuildsInSubmit& buildsInSubmit) {
+    // The first build of each acceleration structure in this command buffer.
+    absl::flat_hash_map<const AccelerationStructureBase*, const AccelerationStructureBuildRecord*>
+        firstBuilds;
+    for (const AccelerationStructureBuildRecord& build : usages.accelerationStructureBuilds) {
+        firstBuilds.try_emplace(build.accelerationStructure, &build);
+    }
+
+    // Top-level acceleration structures used by passes must not be destroyed, and neither must the
+    // BLASes they reference. The BLASes referenced are the ones of the instances at the time of
+    // the last build of the TLAS before the pass.
+    auto ValidateUsedInPass = [&](AccelerationStructureBase* tlas,
+                                  auto IsBuildBeforePass) -> MaybeError {
+        DAWN_TRY(tlas->ValidateCanUseInSubmitNow());
+        bool builtBeforePass = buildsInSubmit.contains(tlas);
+        if (!builtBeforePass) {
+            auto it = firstBuilds.find(tlas);
+            builtBeforePass = it != firstBuilds.end() && IsBuildBeforePass(*it->second);
+        }
+        if (builtBeforePass) {
+            // The instances cannot change during a submit, so this TLAS references the BLASes
+            // currently referenced by its instances.
+            DAWN_TRY(tlas->ValidateInstanceBlasesAreAlive());
+        } else {
+            DAWN_TRY(tlas->ValidateBuiltBlasesAreAlive());
+        }
+        return {};
+    };
+    for (PassIndex pass : Range(usages.renderPasses.size())) {
+        for (AccelerationStructureBase* tlas : usages.renderPasses[pass].accelerationStructures) {
+            DAWN_TRY(
+                ValidateUsedInPass(tlas, [pass](const AccelerationStructureBuildRecord& build) {
+                    return build.renderPassesBefore <= pass;
+                }));
+        }
+    }
+    for (PassIndex pass : Range(usages.computePasses.size())) {
+        for (AccelerationStructureBase* tlas :
+             usages.computePasses[pass].referencedAccelerationStructures) {
+            DAWN_TRY(
+                ValidateUsedInPass(tlas, [pass](const AccelerationStructureBuildRecord& build) {
+                    return build.computePassesBefore <= pass;
+                }));
+        }
+    }
+
+    // Validate builds in queue order to validate updates against the build they update.
+    for (const AccelerationStructureBuildRecord& build : usages.accelerationStructureBuilds) {
+        AccelerationStructureBase* accelerationStructure = build.accelerationStructure;
+        DAWN_TRY(accelerationStructure->ValidateCanUseInSubmitNow());
+        if (accelerationStructure->IsTopLevel()) {
+            DAWN_TRY(accelerationStructure->ValidateInstanceBlasesAreAlive());
+        }
+
+        auto previousBuild = buildsInSubmit.find(accelerationStructure);
+        if (build.mode == wgpu::AccelerationStructureBuildMode::Update) {
+            const AccelerationStructureBuildShape& previousShape =
+                previousBuild != buildsInSubmit.end() ? *previousBuild->second
+                                                      : accelerationStructure->GetLastBuildShape();
+            DAWN_TRY(ValidateAccelerationStructureUpdateShape(accelerationStructure, previousShape,
+                                                              build.shape));
+            // A previous build in this submit used the current instances, which cannot change in
+            // a submit.
+            if (accelerationStructure->IsTopLevel() && previousBuild == buildsInSubmit.end()) {
+                DAWN_TRY(accelerationStructure->ValidateUpdateKeepsInstanceActivity());
+            }
+        }
