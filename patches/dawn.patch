+namespace tint::spirv::writer::raise {
+namespace {
+
+using namespace tint::core::fluent_types;     // NOLINT
+using namespace tint::core::number_suffixes;  // NOLINT
+
+class SpirvWriter_RayQueryTest : public core::ir::transform::TransformTest {
+  protected:
+    /// @returns the RayDesc structure type
+    const core::type::Struct* RayDesc() { return core::type::CreateRayDesc(ty, mod.symbols); }
+
+    /// @returns the RayIntersection structure type
+    const core::type::Struct* RayIntersection() {
+        return core::type::CreateRayIntersection(ty, mod.symbols);
+    }
+
+    /// Builds a function `foo` that declares the ray query `rq`, and then calls @p cb.
+    /// Note: The ray query is not initialized, to keep the expected output short.
+    template <typename CALLBACK>
+    void Build(CALLBACK&& cb) {
+        auto* fn = b.Function("foo", ty.void_());
+        b.Append(fn->Block(), [&] {
+            auto* rq = b.Var("rq", ty.ptr(function, ty.ray_query()));
+            cb(rq);
+            b.Return(fn);
+        });
+    }
+};
+
+TEST_F(SpirvWriter_RayQueryTest, NoModify) {
+    auto* v = b.Var("v", ty.ptr(private_, ty.u32()));
+    mod.root_block->Append(v);
+    auto* fn = b.Function("foo", ty.u32());
+    b.Append(fn->Block(), [&] { b.Return(fn, b.Load(v)); });
+
+    auto* src = R"(
+$B1: {  # root
+  %v:ptr<private, u32, read_write> = var undef
+}
+
+%foo = func():u32 {
+  $B2: {
+    %3:u32 = load %v
+    ret %3
+  }
+}
+)";
+    EXPECT_EQ(src, str());
+
+    auto* expect = src;
+
+    Run(RayQuery);
+
+    EXPECT_EQ(expect, str());
+}
+
+TEST_F(SpirvWriter_RayQueryTest, Initialize) {
+    auto* tlas = b.Var("tlas", ty.ptr(handle, ty.acceleration_structure(), read));
+    tlas->SetBindingPoint(0, 0);
+    mod.root_block->Append(tlas);
+
+    auto* desc = b.FunctionParam("desc", RayDesc());
+    auto* fn = b.Function("foo", ty.void_());
+    fn->SetParams({desc});
+    b.Append(fn->Block(), [&] {
+        auto* rq = b.Var("rq", ty.ptr(function, ty.ray_query()));
+        b.Call(ty.void_(), core::BuiltinFn::kRayQueryInitialize, rq, b.Load(tlas), desc);
+        b.Return(fn);
+    });
+
+    auto* src = R"(
+RayDesc = struct @align(16) {
+  flags:u32 @offset(0)
+  cull_mask:u32 @offset(4)
