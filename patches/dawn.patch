+constexpr std::string_view kEnable = "enable chromium_experimental_ray_query;\n";
+constexpr std::string_view kTlas = "@group(0) @binding(0) var tlas : acceleration_structure;\n";
+
+class ResolverRayQueryWgslTest : public testing::Test {
+  protected:
+    /// Parses and resolves @p wgsl.
+    /// @returns the diagnostics, formatted without the file name or source lines
+    std::string Resolve(std::string_view wgsl) {
+        wgsl::reader::Options options{
+            .allowed_features = wgsl::AllowedFeatures::Everything(),
+        };
+        Source::File file("", wgsl);
+        auto program = wgsl::reader::Parse(&file, std::move(options));
+        valid_ = program.IsValid();
+        diag::Formatter fmt{{
+            .print_file = false,
+            .print_severity = true,
+            .print_line = false,
+            .print_newline_at_end = false,
+        }};
+        return fmt.Format(program.Diagnostics()).Plain();
+    }
+
+    /// Expects that @p wgsl resolves without any diagnostics.
+    void ExpectValid(std::string_view wgsl) {
+        auto diags = Resolve(wgsl);
+        EXPECT_TRUE(valid_) << diags << "\n" << wgsl;
+        EXPECT_EQ(diags, "") << wgsl;
+    }
+
+    /// Expects that @p wgsl fails to resolve with the error @p expected.
+    void ExpectError(std::string_view wgsl, std::string_view expected) {
+        auto diags = Resolve(wgsl);
+        EXPECT_FALSE(valid_) << wgsl;
+        EXPECT_EQ(diags, expected) << wgsl;
+    }
+
+    /// Expects that @p wgsl fails to resolve with an error containing @p expected.
+    void ExpectErrorContains(std::string_view wgsl, std::string_view expected) {
+        auto diags = Resolve(wgsl);
+        EXPECT_FALSE(valid_) << wgsl;
+        EXPECT_THAT(diags, HasSubstr(std::string(expected))) << wgsl;
+    }
+
+    /// @returns @p src prefixed with the enable directive
+    static std::string WithEnable(std::string_view src) {
+        return std::string(kEnable) + std::string(src);
+    }
+
+    /// @returns @p src prefixed with the enable directive and the `tlas` declaration
+    static std::string WithTlas(std::string_view src) {
+        return std::string(kEnable) + std::string(kTlas) + std::string(src);
+    }
+
+  private:
+    bool valid_ = false;
+};
