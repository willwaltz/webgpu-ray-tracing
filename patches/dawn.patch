+// Tests tracing rays against acceleration structures with WGSL ray queries.
+class RayQueryTests : public AccelerationStructureTestBase {
+  protected:
+    void SetUp() override {
+        AccelerationStructureTestBase::SetUp();
+        if (IsSkipped()) {
+            return;
+        }
+
+        // The ray query WGSL extension might not be implemented by Tint, in which case shader
+        // module creation fails: skip the tests instead of failing.
+        device.PushErrorScope(wgpu::ErrorFilter::Validation);
+        utils::CreateShaderModule(device, R"(
+            enable chromium_experimental_ray_query;
+            @group(0) @binding(0) var tlas : acceleration_structure;
+            @compute @workgroup_size(1) fn main() {
+                var rq : ray_query;
+                rayQueryInitialize(&rq, tlas, RayDesc(0u, 0xFFu, 0.0, 1.0, vec3f(), vec3f(0, 0, 1)));
+                _ = rayQueryProceed(&rq);
+            }
+        )");
+        bool done = false;
+        std::string error;
+        device.PopErrorScope(
+            wgpu::CallbackMode::AllowProcessEvents,
+            [&](wgpu::PopErrorScopeStatus, wgpu::ErrorType type, wgpu::StringView message) {
+                if (type != wgpu::ErrorType::NoError) {
+                    error = std::string(message);
+                }
+                done = true;
+            });
+        while (!done) {
+            WaitABit();
+        }
+        if (!error.empty()) {
+            GTEST_SKIP() << "WGSL ray queries are not supported (creating a shader module with "
+                            "`enable chromium_experimental_ray_query;` failed): "
+                         << error;
+        }
+    }
+
+    struct Hit {
+        uint32_t kind;
+        float t;
+        uint32_t instanceCustomData;
+        uint32_t instanceIndex;
+        uint32_t geometryIndex;
+        uint32_t primitiveIndex;
+        std::array<float, 2> barycentrics;
+        std::array<float, 3> translation;
+        uint32_t frontFace;
+    };
+    static_assert(sizeof(Hit) == 48);
+
+    static constexpr uint32_t kKindNone = 0;
+    static constexpr uint32_t kKindTriangle = 1;
+    static constexpr uint32_t kKindGenerated = 2;
+
+    // A ray going in the +Z direction from `origin`. AABB candidates are committed with a
+    // generated hit at `generatedT`.
+    struct Ray {
+        std::array<float, 3> origin;
+        float generatedT = 0.0;
+    };
+
+    // Traces rays against the TLAS with a compute shader and returns the committed hits.
+    std::vector<Hit> Trace(const wgpu::AccelerationStructure& tlas, const std::vector<Ray>& rays) {
+        if (!mPipeline) {
+            wgpu::ComputePipelineDescriptor descriptor;
+            descriptor.compute.module = utils::CreateShaderModule(device, R"(
+                enable chromium_experimental_ray_query;
+
+                struct Hit {
+                    kind : u32,
+                    t : f32,
+                    instance_custom_data : u32,
+                    instance_index : u32,
+                    geometry_index : u32,
+                    primitive_index : u32,
+                    barycentrics : vec2f,
+                    translation : vec3f,
+                    front_face : u32,
+                }
+
+                @group(0) @binding(0) var tlas : acceleration_structure;
+                @group(0) @binding(1) var<storage, read> rays : array<vec4f>;
+                @group(0) @binding(2) var<storage, read_write> hits : array<Hit>;
+
+                @compute @workgroup_size(1)
+                fn main(@builtin(global_invocation_id) id : vec3u) {
+                    let ray = rays[id.x];
+                    var rq : ray_query;
+                    rayQueryInitialize(&rq, tlas,
+                                       RayDesc(0u, 0xFFu, 0.0, 100.0, ray.xyz, vec3f(0, 0, 1)));
+                    while (rayQueryProceed(&rq)) {
+                        let candidate = rayQueryGetCandidateIntersection(&rq);
+                        if (candidate.kind == 1u) {
+                            rayQueryConfirmIntersection(&rq);
+                        } else if (candidate.kind == 3u) {
+                            rayQueryGenerateIntersection(&rq, ray.w);
+                        }
+                    }
+
+                    let hit = rayQueryGetCommittedIntersection(&rq);
+                    var result : Hit;
+                    result.kind = hit.kind;
+                    if (hit.kind != 0u) {
+                        result.t = hit.t;
+                        result.instance_custom_data = hit.instance_custom_data;
+                        result.instance_index = hit.instance_index;
+                        result.geometry_index = hit.geometry_index;
+                        result.primitive_index = hit.primitive_index;
+                        result.translation = hit.object_to_world[3];
+                    }
+                    if (hit.kind == 1u) {
+                        result.barycentrics = hit.barycentrics;
+                        result.front_face = select(0u, 1u, hit.front_face);
+                    }
+                    hits[id.x] = result;
+                }
+            )");
+            mPipeline = device.CreateComputePipeline(&descriptor);
+        }
+
+        std::vector<float> rayData;
+        for (const Ray& ray : rays) {
+            rayData.insert(rayData.end(),
+                           {ray.origin[0], ray.origin[1], ray.origin[2], ray.generatedT});
+        }
+        wgpu::Buffer rayBuffer = utils::CreateBufferFromData(
+            device, rayData.data(), rayData.size() * sizeof(float), wgpu::BufferUsage::Storage);
+        const uint64_t hitsSize = rays.size() * sizeof(Hit);
+        wgpu::Buffer hitBuffer =
+            CreateBuffer(hitsSize, wgpu::BufferUsage::Storage | wgpu::BufferUsage::CopySrc);
+        wgpu::Buffer readback =
+            CreateBuffer(hitsSize, wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst);
+
+        wgpu::AccelerationStructureBindingEntry accelerationStructureEntry;
+        accelerationStructureEntry.accelerationStructure = tlas;
+        std::array<wgpu::BindGroupEntry, 3> entries;
+        entries[0].binding = 0;
+        entries[0].nextInChain = &accelerationStructureEntry;
+        entries[1].binding = 1;
+        entries[1].buffer = rayBuffer;
+        entries[2].binding = 2;
+        entries[2].buffer = hitBuffer;
+        wgpu::BindGroupDescriptor bindGroupDescriptor;
+        bindGroupDescriptor.layout = mPipeline.GetBindGroupLayout(0);
+        bindGroupDescriptor.entryCount = entries.size();
+        bindGroupDescriptor.entries = entries.data();
+        wgpu::BindGroup bindGroup = device.CreateBindGroup(&bindGroupDescriptor);
+
+        wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+        wgpu::ComputePassEncoder pass = encoder.BeginComputePass();
+        pass.SetPipeline(mPipeline);
+        pass.SetBindGroup(0, bindGroup);
+        pass.DispatchWorkgroups(uint32_t(rays.size()));
+        pass.End();
+        encoder.CopyBufferToBuffer(hitBuffer, 0, readback, 0, hitsSize);
+        wgpu::CommandBuffer commands = encoder.Finish();
+        queue.Submit(1, &commands);
+
+        MapAsyncAndWait(readback, wgpu::MapMode::Read, 0, hitsSize);
+        std::vector<Hit> hits(rays.size());
+        DAWN_UNSAFE_TODO(memcpy(hits.data(), readback.GetConstMappedRange(0, hitsSize), hitsSize));
+        readback.Unmap();
+        return hits;
+    }
+
+    void ExpectTriangleHit(const Hit& hit,
+                           float t,
+                           uint32_t instanceIndex,
+                           uint32_t instanceCustomData,
+                           uint32_t geometryIndex,
+                           uint32_t primitiveIndex,
+                           std::array<float, 2> barycentrics) {
+        EXPECT_EQ(hit.kind, kKindTriangle);
+        EXPECT_NEAR(hit.t, t, 1e-4);
+        EXPECT_EQ(hit.instanceIndex, instanceIndex);
+        EXPECT_EQ(hit.instanceCustomData, instanceCustomData);
+        EXPECT_EQ(hit.geometryIndex, geometryIndex);
+        EXPECT_EQ(hit.primitiveIndex, primitiveIndex);
+        EXPECT_NEAR(hit.barycentrics[0], barycentrics[0], 1e-4);
+        EXPECT_NEAR(hit.barycentrics[1], barycentrics[1], 1e-4);
+    }
+
+    wgpu::ComputePipeline mPipeline;
+};
+
+// Closest hits against triangles with instance transforms and flags, and generated hits against
+// AABBs.
+TEST_P(RayQueryTests, TrianglesAndAABBs) {
+    // Two non-opaque triangles with opposite windings: [0, 1]x[0, 1] and [2, 3]x[0, 1] at z = 1.
+    std::vector<float> vertices = {0, 0, 1, 1, 0, 1, 0, 1, 1, 2, 0, 1, 2, 1, 1, 3, 0, 1};
+    wgpu::Buffer vertexBuffer = CreateInputBuffer(vertices);
+    wgpu::AccelerationStructure triangles = CreateBlas(
+        {TriangleLayout(6, 2, wgpu::IndexFormat::Undefined, wgpu::VertexFormat::Float32x3,
+                        wgpu::AccelerationStructureGeometryFlags::None)});
+    Build(triangles, {TriangleData(vertexBuffer, 6, 2)});
+
+    // A unit cube AABB.
+    std::vector<float> aabb = {0, 0, 0, 1, 1, 1};
+    wgpu::Buffer aabbBuffer = CreateInputBuffer(aabb);
+    wgpu::AccelerationStructure aabbs = CreateBlas({AABBLayout(1)});
+    Build(aabbs, {AABBData(aabbBuffer, 1)});
+
+    wgpu::AccelerationStructure tlas = CreateTlas(4);
+    WriteInstances(tlas, 0, {triangles, aabbs},
+                   {
+                       MakeInstance(0, 7, {0, 0, 1}),
+                       MakeInstance(0, 8, {0, 10, 1}, kInstanceFlagFlipFacing),
+                       MakeInstance(1, 9, {0, 20, 0}),
+                       MakeInstance(kInactiveInstance, 10, {0, 30, 1}),
+                   });
+    Build(tlas, {}, 4);
+
+    std::vector<Hit> hits = Trace(tlas, {
+                                            {{0.25, 0.5, -1}},
+                                            {{2.25, 0.5, -1}},
+                                            {{0.25, 10.5, -1}},
+                                            {{0.5, 20.5, -1}, 1.5},
+                                            {{0.25, 30.5, -1}},
+                                            {{50, 50, -1}},
+                                        });
+
+    // The triangles are at z = 2 in world space.
+    ExpectTriangleHit(hits[0], 3.0, 0, 7, 0, 0, {0.25, 0.5});
+    EXPECT_EQ(hits[0].translation, (std::array<float, 3>{0, 0, 1}));
+    ExpectTriangleHit(hits[1], 3.0, 0, 7, 0, 1, {0.5, 0.25});
+    ExpectTriangleHit(hits[2], 3.0, 1, 8, 0, 0, {0.25, 0.5});
+    EXPECT_EQ(hits[2].translation, (std::array<float, 3>{0, 10, 1}));
+
+    // The second triangle has the opposite winding, and the second instance flips the facing.
+    EXPECT_NE(hits[0].frontFace, hits[1].frontFace);
+    EXPECT_NE(hits[0].frontFace, hits[2].frontFace);
+
+    EXPECT_EQ(hits[3].kind, kKindGenerated);
+    EXPECT_NEAR(hits[3].t, 1.5, 1e-4);
+    EXPECT_EQ(hits[3].instanceIndex, 2u);
+    EXPECT_EQ(hits[3].instanceCustomData, 9u);
+    EXPECT_EQ(hits[3].primitiveIndex, 0u);
+    EXPECT_EQ(hits[3].translation, (std::array<float, 3>{0, 20, 0}));
+
+    // Inactive instances and empty space are missed.
+    EXPECT_EQ(hits[4].kind, kKindNone);
+    EXPECT_EQ(hits[5].kind, kKindNone);
+}
+
+// Hits against indexed triangles with vertex offsets and strides, in multiple geometries.
+TEST_P(RayQueryTests, IndexedGeometries) {
