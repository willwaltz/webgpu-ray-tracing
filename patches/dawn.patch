+TEST_F(SpirvWriter_RayQueryTest, PointerParameters) {
+    // fn bar(a : ptr<function, ray_query>, x : u32, b : ptr<private, ray_query>) {
+    //   rayQueryTerminate(a);
+    //   let c = b;
+    //   rayQueryTerminate(c);
+    // }
+    auto* param_a = b.FunctionParam("a", ty.ptr(function, ty.ray_query()));
+    auto* param_x = b.FunctionParam("x", ty.u32());
+    auto* param_b = b.FunctionParam("b", ty.ptr(private_, ty.ray_query()));
+    auto* bar = b.Function("bar", ty.void_());
+    bar->SetParams({param_a, param_x, param_b});
+    b.Append(bar->Block(), [&] {
+        b.Call(ty.void_(), core::BuiltinFn::kRayQueryTerminate, param_a);
+        auto* c = b.Let("c", param_b);
+        b.Call(ty.void_(), core::BuiltinFn::kRayQueryTerminate, c);
+        b.Return(bar);
+    });
+
+    auto* prq = b.Var("prq", ty.ptr(private_, ty.ray_query()));
+    mod.root_block->Append(prq);
+
+    auto* fn = b.Function("foo", ty.void_());
+    b.Append(fn->Block(), [&] {
+        auto* rq = b.Var("rq", ty.ptr(function, ty.ray_query()));
+        b.Call(ty.void_(), bar, rq, 1_u, prq);
+        b.Call(ty.void_(), bar, rq, 2_u, prq);
+        b.Return(fn);
+    });
+
+    auto* src = R"(
+$B1: {  # root
+  %prq:ptr<private, ray_query, read_write> = var undef
+}
+
+%bar = func(%a:ptr<function, ray_query, read_write>, %x:u32, %b:ptr<private, ray_query, read_write>):void {
+  $B2: {
+    %6:void = rayQueryTerminate %a
+    %c:ptr<private, ray_query, read_write> = let %b
+    %8:void = rayQueryTerminate %c
+    ret
+  }
+}
+%foo = func():void {
+  $B3: {
+    %rq:ptr<function, ray_query, read_write> = var undef
+    %11:void = call %bar, %rq, 1u, %prq
+    %12:void = call %bar, %rq, 2u, %prq
+    ret
+  }
+}
+)";
+    EXPECT_EQ(src, str());
+
+    auto* expect = R"(
+tint_ray_query_state = struct @align(4) {
+  state:u32 @offset(0)
+  t_max:f32 @offset(4)
+}
+
+$B1: {  # root
+  %prq:ptr<private, ray_query, read_write> = var undef
+  %prq_state:ptr<private, tint_ray_query_state, read_write> = var undef
+}
+
+%bar = func(%a:ptr<function, ray_query, read_write>, %x:u32, %b:ptr<private, ray_query, read_write>, %a_state:ptr<function, tint_ray_query_state, read_write>, %b_state:ptr<private, tint_ray_query_state, read_write>):void {
+  $B2: {
+    %9:ptr<function, u32, read_write> = access %a_state, 0u
+    %10:u32 = load %9
+    %11:bool = eq %10, 2u
+    if %11 [t: $B3] {  # if_1
+      $B3: {  # true
+        %12:void = spirv.ray_query_terminate %a
+        exit_if  # if_1
+      }
+    }
+    %13:bool = eq %10, 1u
+    %14:bool = or %13, %11
+    if %14 [t: $B4] {  # if_2
+      $B4: {  # true
+        %15:ptr<function, u32, read_write> = access %a_state, 0u
+        store %15, 3u
+        exit_if  # if_2
+      }
+    }
+    %c:ptr<private, ray_query, read_write> = let %b
+    %17:ptr<private, u32, read_write> = access %b_state, 0u
+    %18:u32 = load %17
+    %19:bool = eq %18, 2u
+    if %19 [t: $B5] {  # if_3
+      $B5: {  # true
+        %20:void = spirv.ray_query_terminate %c
+        exit_if  # if_3
+      }
+    }
+    %21:bool = eq %18, 1u
+    %22:bool = or %21, %19
+    if %22 [t: $B6] {  # if_4
+      $B6: {  # true
+        %23:ptr<private, u32, read_write> = access %b_state, 0u
+        store %23, 3u
+        exit_if  # if_4
+      }
+    }
+    ret
+  }
+}
+%foo = func():void {
+  $B7: {
+    %rq:ptr<function, ray_query, read_write> = var undef
+    %rq_state:ptr<function, tint_ray_query_state, read_write> = var tint_ray_query_state(0u, 0.0f)
+    %27:void = call %bar, %rq, 1u, %prq, %rq_state, %prq_state
+    %28:void = call %bar, %rq, 2u, %prq, %rq_state, %prq_state
+    ret
