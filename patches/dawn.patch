+MaybeError ValidateAccelerationStructureBinding(DeviceBase* device,
+                                                const UnpackedPtr<BindGroupEntry>& entry) {
+    const AccelerationStructureBindingEntry* accelerationStructureEntry =
+        entry.Get<AccelerationStructureBindingEntry>();
+    DAWN_INVALID_IF(accelerationStructureEntry == nullptr,
+                    "Expected an AccelerationStructureBindingEntry.");
+
+    DAWN_TRY(entry.ValidateSubset<AccelerationStructureBindingEntry>());
+    DAWN_INVALID_IF(
+        entry->buffer != nullptr || entry->sampler != nullptr || entry->textureView != nullptr,
+        "Expected only accelerationStructure to be set for binding entry.");
+
+    AccelerationStructureBase* accelerationStructure =
+        accelerationStructureEntry->accelerationStructure;
+    DAWN_INVALID_IF(accelerationStructure == nullptr,
+                    "Binding entry accelerationStructure not set.");
+    DAWN_TRY(device->ValidateObject(accelerationStructure));
+    DAWN_INVALID_IF(!accelerationStructure->IsTopLevel(),
+                    "%s is not a top-level acceleration structure (its type is %s). Only "
+                    "top-level acceleration structures can be bound.",
+                    accelerationStructure, accelerationStructure->GetAccelerationStructureType());
+    return {};
+}
