+    // Vertices with a 16-byte stride, starting at offset 32.
+    std::vector<float> vertices(8 + 4 * 4, 0.0f);
+    for (uint32_t i = 0; i < 4; ++i) {
+        vertices[8 + i * 4 + 0] = float(i & 1);
+        vertices[8 + i * 4 + 1] = float(i >> 1);
+        vertices[8 + i * 4 + 2] = 1.0f;
+    }
+    wgpu::Buffer vertexBuffer = CreateInputBuffer(vertices);
+    // The indices start at offset 2. The size of buffer writes must be a multiple of 4.
+    std::vector<uint16_t> indices = {0xFFFF, 0, 1, 2, 2, 1, 3, 0xFFFF};
+    wgpu::Buffer indexBuffer = CreateInputBuffer(indices);
+
+    wgpu::AccelerationStructure blas =
+        CreateBlas({TriangleLayout(4, 2, wgpu::IndexFormat::Uint16), TriangleLayout(3, 1),
+                    TriangleLayout(0, 0)},
+                   wgpu::AccelerationStructureFlags::PreferFastBuild);
+
+    wgpu::AccelerationStructureGeometryData indexed = TriangleData(vertexBuffer, 4, 2, indexBuffer);
+    indexed.vertexOffset = 32;
+    indexed.vertexStride = 16;
+    indexed.indexOffset = 2;
+    wgpu::AccelerationStructureGeometryData nonIndexed = TriangleData(vertexBuffer, 3, 1);
+    nonIndexed.vertexOffset = 32;
+    nonIndexed.vertexStride = 16;
+    Build(blas, {indexed, nonIndexed, TriangleData(nullptr, 0, 0)});
+
+    std::vector<float> aabbs(4 + 6 * 2, 0.0f);
+    wgpu::Buffer aabbBuffer = CreateInputBuffer(aabbs);
+    wgpu::AccelerationStructure aabbBlas =
+        CreateBlas({AABBLayout(2), AABBLayout(1)}, wgpu::AccelerationStructureFlags::LowMemory);
+    wgpu::AccelerationStructureGeometryData aabbData = AABBData(aabbBuffer, 2);
+    aabbData.AABBOffset = 16;
+    aabbData.AABBStride = 24;
+    Build(aabbBlas, {aabbData, AABBData(aabbBuffer, 1)});
+
+    wgpu::AccelerationStructure tlas = CreateTlas(4);
+    WriteInstances(tlas, 0, {blas, aabbBlas},
+                   {MakeInstance(0), MakeInstance(1), MakeInstance(kInactiveInstance),
+                    MakeInstance(0, 0, {0, 0, 0},
+                                 kInstanceFlagCullDisable | kInstanceFlagFlipFacing |
+                                     kInstanceFlagForceOpaque)});
+    Build(tlas, {}, 4);
+    CheckTlasCanBeUsedInComputePass(tlas);
+}
+
+// Build BLASes with all the supported vertex formats.
+TEST_P(AccelerationStructureBuildTests, VertexFormats) {
+    wgpu::Buffer vertexBuffer = CreateInputBuffer(std::vector<uint32_t>(16, 0x3C00'3C00u));
+    std::vector<wgpu::AccelerationStructure> blases;
+    for (wgpu::VertexFormat format :
+         {wgpu::VertexFormat::Float32x2, wgpu::VertexFormat::Float32x3,
+          wgpu::VertexFormat::Float16x2, wgpu::VertexFormat::Float16x4,
+          wgpu::VertexFormat::Snorm16x2, wgpu::VertexFormat::Snorm16x4}) {
+        wgpu::AccelerationStructure blas =
+            CreateBlas({TriangleLayout(3, 1, wgpu::IndexFormat::Undefined, format)});
