+// Validation of acceleration structure bindings.
+TEST_P(AccelerationStructureValidationTests, Bindings) {
+    // Binding arrays of acceleration structures aren't supported.
+    {
+        wgpu::AccelerationStructureBindingLayout accelerationStructureLayout;
+        wgpu::BindGroupLayoutEntry entry;
+        entry.binding = 0;
+        entry.visibility = wgpu::ShaderStage::Compute;
+        entry.bindingArraySize = 2;
+        entry.nextInChain = &accelerationStructureLayout;
+        wgpu::BindGroupLayoutDescriptor descriptor;
+        descriptor.entryCount = 1;
+        descriptor.entries = &entry;
+        ASSERT_DEVICE_ERROR(device.CreateBindGroupLayout(&descriptor));
+
+        // Binding type must be exclusive.
+        entry.bindingArraySize = 0;
+        entry.buffer.type = wgpu::BufferBindingType::Storage;
+        ASSERT_DEVICE_ERROR(device.CreateBindGroupLayout(&descriptor));
+    }
+
+    // Acceleration structures can be visible to all stages.
+    CreateAccelerationStructureBindGroupLayout(
+        wgpu::ShaderStage::Vertex | wgpu::ShaderStage::Fragment | wgpu::ShaderStage::Compute,
+        false);
+
+    wgpu::BindGroupLayout layout = CreateAccelerationStructureBindGroupLayout();
+    wgpu::Buffer storage = CreateResultBuffer();
+    wgpu::AccelerationStructure blas = CreateBuiltTriangleBlas();
+    wgpu::AccelerationStructure tlas = CreateBuiltTlas(blas);
+    CreateAccelerationStructureBindGroup(layout, tlas, storage);
+
+    // Only TLASes can be bound.
+    ASSERT_DEVICE_ERROR(CreateAccelerationStructureBindGroup(layout, blas, storage));
+
+    // The acceleration structure must be valid.
+    {
+        wgpu::AccelerationStructure errorTlas;
+        ASSERT_DEVICE_ERROR(errorTlas = CreateTlas(0));
+        ASSERT_DEVICE_ERROR(CreateAccelerationStructureBindGroup(layout, errorTlas, storage));
+    }
+
+    // The acceleration structure must be set.
+    {
+        std::array<wgpu::BindGroupEntry, 2> entries;
+        entries[0].binding = 0;
+        entries[1].binding = 1;
+        entries[1].buffer = storage;
+        wgpu::BindGroupDescriptor descriptor;
+        descriptor.layout = layout;
+        descriptor.entryCount = entries.size();
+        descriptor.entries = entries.data();
+        ASSERT_DEVICE_ERROR(device.CreateBindGroup(&descriptor));
+
+        wgpu::AccelerationStructureBindingEntry accelerationStructureEntry;
+        entries[0].nextInChain = &accelerationStructureEntry;
+        // The wire client can't serialize null non-optional objects.
+        if (!UsesWire()) {
+            ASSERT_DEVICE_ERROR(device.CreateBindGroup(&descriptor));
+        }
+
+        // Only the acceleration structure can be set.
+        accelerationStructureEntry.accelerationStructure = tlas;
+        device.CreateBindGroup(&descriptor);
+        entries[0].buffer = storage;
+        ASSERT_DEVICE_ERROR(device.CreateBindGroup(&descriptor));
+
+        // Acceleration structures can't be used for other binding types.
+        entries[0].buffer = nullptr;
+        device.CreateBindGroup(&descriptor);
+        entries[1].buffer = nullptr;
+        entries[1].nextInChain = &accelerationStructureEntry;
+        ASSERT_DEVICE_ERROR(device.CreateBindGroup(&descriptor));
+    }
+}
