+TEST_F(SpirvWriterRayQueryTest, PrivateRayQuery) {
+    auto* tlas = Tlas();
+    auto* rq = b.Var("rq", ty.ptr(private_, ty.ray_query()));
+    mod.root_block->Append(rq);
+
+    auto* ep = b.ComputeFunction("main");
+    b.Append(ep->Block(), [&] {
+        b.Call(ty.void_(), core::BuiltinFn::kRayQueryInitialize, rq, b.Load(tlas),
+               b.Zero(RayDesc()));
+        b.Call(ty.bool_(), core::BuiltinFn::kRayQueryProceed, rq);
+        b.Return(ep);
+    });
+
