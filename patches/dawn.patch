+TEST_F(SpirvWriterRayQueryTest, Initialize_OperandOrder) {
+    auto* tlas = Tlas();
+    auto* desc = b.FunctionParam("desc", RayDesc());
+    auto* fn = b.Function("foo", ty.void_());
+    fn->SetParams({desc});
+    b.Append(fn->Block(), [&] {
+        auto* rq = b.Var("rq", ty.ptr(function, ty.ray_query()));
+        b.Call(ty.void_(), core::BuiltinFn::kRayQueryInitialize, rq, b.Load(tlas), desc);
+        b.Return(fn);
+    });
+    auto* ep = b.ComputeFunction("main");
+    b.Append(ep->Block(), [&] {
+        b.Call(fn, b.Zero(RayDesc()));
+        b.Return(ep);
+    });
+
+    auto result = Generate();
+    ASSERT_EQ(result, Success) << result.Failure() << output_;
+
+    // Find the IDs of the members extracted from the ray descriptor.
+    std::map<int, std::string> members;
+    std::regex extract_re(R"((%\w+) = OpCompositeExtract %\w+ %desc (\d+))");
+    for (auto it = std::sregex_iterator(output_.begin(), output_.end(), extract_re);
+         it != std::sregex_iterator(); ++it) {
+        members[std::stoi((*it)[2].str())] = (*it)[1].str();
+    }
+    ASSERT_EQ(members.size(), 6u) << output_;
+
+    // The ray flags are masked to the flags that do not require additional capabilities.
+    std::smatch match;
+    std::regex mask_re("(%\\w+) = OpBitwiseAnd %uint " + members[0] + " %uint_1023");
+    ASSERT_TRUE(std::regex_search(output_, match, mask_re)) << output_;
+    auto flags = match[1].str();
+
+    // OpRayQueryInitializeKHR %rq %accel %flags %cull_mask %origin %t_min %dir %t_max
+    std::regex init_re("OpRayQueryInitializeKHR %rq %\\w+ " + flags + " " + members[1] + " " +
+                       members[4] + " " + members[2] + " " + members[5] + " " + members[3] + "\n");
+    EXPECT_TRUE(std::regex_search(output_, init_re)) << output_;
+}
