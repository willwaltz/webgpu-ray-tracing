+using RayQueryTest = TestHelper;
+
+TEST_F(RayQueryTest, Creation) {
+    Manager ty;
+    auto* a = ty.ray_query();
+    auto* b = ty.ray_query();
+    EXPECT_EQ(a, b);
+}
+
+TEST_F(RayQueryTest, Hash) {
+    Manager ty;
+    auto* a = ty.ray_query();
+    auto* b = ty.ray_query();
+    EXPECT_EQ(a->unique_hash, b->unique_hash);
+}
+
+TEST_F(RayQueryTest, Equals) {
+    Manager ty;
+    auto* a = ty.ray_query();
+    auto* b = ty.ray_query();
+    EXPECT_TRUE(a->Equals(*b));
+    EXPECT_FALSE(a->Equals(Void{}));
+    EXPECT_FALSE(a->Equals(AccelerationStructure{}));
+}
+
+TEST_F(RayQueryTest, FriendlyName) {
+    RayQuery rq;
+    EXPECT_EQ(rq.FriendlyName(), "ray_query");
+}
+
+TEST_F(RayQueryTest, Flags) {
+    Manager ty;
+    auto* rq = ty.ray_query();
+    EXPECT_FALSE(rq->IsHandle());
+    EXPECT_FALSE(rq->IsConstructible());
+    EXPECT_TRUE(rq->HasCreationFixedFootprint());
+    EXPECT_TRUE(rq->HasFixedFootprint());
+}
+
+TEST_F(RayQueryTest, Clone) {
+    Manager ty;
+    auto* a = ty.ray_query();
+
+    core::type::Manager mgr;
+    core::type::CloneContext ctx{{nullptr}, {nullptr, &mgr}};
+
+    auto* b = a->Clone(ctx);
+    ASSERT_TRUE(b->Is<RayQuery>());
+    EXPECT_EQ(b, mgr.ray_query());
+}
+
+TEST_F(RayQueryTest, RayDesc) {
+    Manager ty;
+    SymbolTable symbols;
+    auto* desc = CreateRayDesc(ty, symbols);
+    ASSERT_NE(desc, nullptr);
+    EXPECT_EQ(desc, CreateRayDesc(ty, symbols));
+    EXPECT_TRUE(IsRayDesc(desc));
+    EXPECT_FALSE(IsRayIntersection(desc));
+    EXPECT_TRUE(desc->IsWgslInternal());
+    EXPECT_TRUE(desc->IsConstructible());
+    EXPECT_EQ(desc->Name().NameView(), "RayDesc");
+
+    auto members = desc->Members();
+    ASSERT_EQ(members.Length(), 6u);
+    EXPECT_EQ(members[0]->Name().NameView(), "flags");
+    EXPECT_EQ(members[0]->Type(), ty.u32());
+    EXPECT_EQ(members[1]->Name().NameView(), "cull_mask");
+    EXPECT_EQ(members[1]->Type(), ty.u32());
+    EXPECT_EQ(members[2]->Name().NameView(), "t_min");
+    EXPECT_EQ(members[2]->Type(), ty.f32());
+    EXPECT_EQ(members[3]->Name().NameView(), "t_max");
+    EXPECT_EQ(members[3]->Type(), ty.f32());
+    EXPECT_EQ(members[4]->Name().NameView(), "origin");
+    EXPECT_EQ(members[4]->Type(), ty.vec3f());
+    EXPECT_EQ(members[5]->Name().NameView(), "dir");
+    EXPECT_EQ(members[5]->Type(), ty.vec3f());
+}
+
+TEST_F(RayQueryTest, RayIntersection) {
+    Manager ty;
+    SymbolTable symbols;
+    auto* intersection = CreateRayIntersection(ty, symbols);
+    ASSERT_NE(intersection, nullptr);
+    EXPECT_EQ(intersection, CreateRayIntersection(ty, symbols));
+    EXPECT_TRUE(IsRayIntersection(intersection));
+    EXPECT_FALSE(IsRayDesc(intersection));
+    EXPECT_TRUE(intersection->IsWgslInternal());
+    EXPECT_TRUE(intersection->IsConstructible());
+    EXPECT_EQ(intersection->Name().NameView(), "RayIntersection");
+
+    auto members = intersection->Members();
+    ASSERT_EQ(members.Length(), 11u);
+    EXPECT_EQ(members[0]->Name().NameView(), "kind");
+    EXPECT_EQ(members[0]->Type(), ty.u32());
+    EXPECT_EQ(members[1]->Name().NameView(), "t");
+    EXPECT_EQ(members[1]->Type(), ty.f32());
+    EXPECT_EQ(members[2]->Name().NameView(), "instance_custom_data");
+    EXPECT_EQ(members[2]->Type(), ty.u32());
+    EXPECT_EQ(members[3]->Name().NameView(), "instance_index");
+    EXPECT_EQ(members[3]->Type(), ty.u32());
+    EXPECT_EQ(members[4]->Name().NameView(), "sbt_record_offset");
+    EXPECT_EQ(members[4]->Type(), ty.u32());
+    EXPECT_EQ(members[5]->Name().NameView(), "geometry_index");
+    EXPECT_EQ(members[5]->Type(), ty.u32());
+    EXPECT_EQ(members[6]->Name().NameView(), "primitive_index");
+    EXPECT_EQ(members[6]->Type(), ty.u32());
+    EXPECT_EQ(members[7]->Name().NameView(), "barycentrics");
+    EXPECT_EQ(members[7]->Type(), ty.vec2f());
+    EXPECT_EQ(members[8]->Name().NameView(), "front_face");
+    EXPECT_EQ(members[8]->Type(), ty.bool_());
+    EXPECT_EQ(members[9]->Name().NameView(), "object_to_world");
+    EXPECT_EQ(members[9]->Type(), ty.mat4x3(ty.f32()));
+    EXPECT_EQ(members[10]->Name().NameView(), "world_to_object");
+    EXPECT_EQ(members[10]->Type(), ty.mat4x3(ty.f32()));
+}
+
+TEST_F(RayQueryTest, UserStructsAreNotRayStructs) {
+    Manager ty;
+    SymbolTable symbols;
+    // A user declared structure with the same name is not a builtin ray structure.
+    auto* user = ty.Struct(symbols.New("RayDesc"), {{symbols.New("x"), ty.f32()}});
+    EXPECT_FALSE(IsRayDesc(user));
+    EXPECT_FALSE(IsRayIntersection(user));
+    EXPECT_FALSE(IsRayDesc(ty.u32()));
+    EXPECT_FALSE(IsRayIntersection(ty.ray_query()));
+}
