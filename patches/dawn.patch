+// Validation of Queue::WriteAccelerationStructureInstances.
+TEST_P(AccelerationStructureValidationTests, WriteInstances) {
+    wgpu::AccelerationStructure blas = CreateBuiltTriangleBlas();
+    wgpu::AccelerationStructure tlas = CreateTlas(2);
+
+    // Success cases.
+    WriteInstances(tlas, 0, {blas}, {MakeInstance(0), MakeInstance(0)});
+    WriteInstances(tlas, 1, {blas}, {MakeInstance(0)});
+    WriteInstances(tlas, 0, {}, {MakeInstance(kInactiveInstance)});
+    WriteInstances(tlas, 0, {blas, blas}, {MakeInstance(1, 0xFF'FFFF, {1, 2, 3}, 0xF)});
+    WriteInstances(tlas, 2, {}, {});
+
+    // The destination must be a valid TLAS.
+    ASSERT_DEVICE_ERROR(WriteInstances(blas, 0, {blas}, {MakeInstance(0)}));
+    {
+        wgpu::AccelerationStructure errorTlas;
+        ASSERT_DEVICE_ERROR(errorTlas = CreateTlas(0));
+        ASSERT_DEVICE_ERROR(WriteInstances(errorTlas, 0, {}, {MakeInstance(kInactiveInstance)}));
+    }
+
+    // The size must be a multiple of the record size.
+    {
+        InstanceRecord record = MakeInstance(0);
+        wgpu::AccelerationStructure blases[] = {blas};
+        ASSERT_DEVICE_ERROR(
+            queue.WriteAccelerationStructureInstances(tlas, 0, 1, blases, &record, 60));
+    }
+
+    // The instances must fit in the TLAS.
+    ASSERT_DEVICE_ERROR(WriteInstances(tlas, 2, {blas}, {MakeInstance(0)}));
+    ASSERT_DEVICE_ERROR(
+        WriteInstances(tlas, 0, {blas}, {MakeInstance(0), MakeInstance(0), MakeInstance(0)}));
+    ASSERT_DEVICE_ERROR(WriteInstances(tlas, 0xFFFF'FFFFu, {blas}, {MakeInstance(0)}));
+
+    // The BLAS index must be in bounds.
+    ASSERT_DEVICE_ERROR(WriteInstances(tlas, 0, {blas}, {MakeInstance(1)}));
+    ASSERT_DEVICE_ERROR(WriteInstances(tlas, 0, {}, {MakeInstance(0)}));
+
+    // The BLASes must be valid bottom-level acceleration structures.
+    ASSERT_DEVICE_ERROR(WriteInstances(tlas, 0, {tlas}, {MakeInstance(0)}));
+    {
+        wgpu::AccelerationStructure errorBlas;
+        ASSERT_DEVICE_ERROR(errorBlas = CreateBlas({}));
+        ASSERT_DEVICE_ERROR(
+            WriteInstances(tlas, 0, {errorBlas}, {MakeInstance(kInactiveInstance)}));
+    }
+
+    // Unknown instance flags and non-zero reserved members are errors.
+    ASSERT_DEVICE_ERROR(WriteInstances(tlas, 0, {blas}, {MakeInstance(0, 0, {0, 0, 0}, 0x10)}));
+    {
+        InstanceRecord record = MakeInstance(0);
+        record.reserved = 1;
+        ASSERT_DEVICE_ERROR(WriteInstances(tlas, 0, {blas}, {record}));
+    }
+
+    // The BLASes and the TLAS must not be destroyed.
+    {
+        wgpu::AccelerationStructure destroyedBlas = CreateBuiltTriangleBlas();
+        destroyedBlas.Destroy();
+        ASSERT_DEVICE_ERROR(
+            WriteInstances(tlas, 0, {destroyedBlas}, {MakeInstance(kInactiveInstance)}));
+    }
+    tlas.Destroy();
+    ASSERT_DEVICE_ERROR(WriteInstances(tlas, 0, {blas}, {MakeInstance(0)}));
+}
