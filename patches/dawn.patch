+TEST_F(ResolverRayQueryTest, RayQueryVarAndBuiltins) {
+    Enable(wgsl::Extension::kChromiumExperimentalRayQuery);
+    GlobalVar("tlas", ty.AsType("acceleration_structure"), Group(0_a), Binding(0_a));
+
+    auto* rq = Var("rq", ty.AsType("ray_query"));
+    auto* init = Call("rayQueryInitialize", AddressOf("rq"), "tlas", Call("RayDesc"));
+    auto* proceed = Call("rayQueryProceed", AddressOf("rq"));
+    auto* generate = Call("rayQueryGenerateIntersection", AddressOf("rq"), 1_f);
+    auto* confirm = Call("rayQueryConfirmIntersection", AddressOf("rq"));
+    auto* terminate = Call("rayQueryTerminate", AddressOf("rq"));
+    auto* committed = Call("rayQueryGetCommittedIntersection", AddressOf("rq"));
+    auto* candidate = Call("rayQueryGetCandidateIntersection", AddressOf("rq"));
+    WrapInFunction(rq, CallStmt(init), Decl(Let("p", proceed)), CallStmt(generate),
+                   CallStmt(confirm), CallStmt(terminate), Decl(Let("c", committed)),
+                   Decl(Let("d", candidate)));
+
+    ASSERT_TRUE(r()->Resolve()) << r()->error();
+
+    auto* rq_sem = Sem().Get<sem::LocalVariable>(rq);
+    ASSERT_NE(rq_sem, nullptr);
+    EXPECT_TRUE(rq_sem->Type()->UnwrapRef()->Is<core::type::RayQuery>());
+    EXPECT_EQ(rq_sem->AddressSpace(), core::AddressSpace::kFunction);
+
+    auto check = [&](const ast::CallExpression* call, wgsl::BuiltinFn fn) {
+        auto* sem = Sem().Get<sem::Call>(call);
+        ASSERT_NE(sem, nullptr);
+        auto* builtin = sem->Target()->As<sem::BuiltinFn>();
+        ASSERT_NE(builtin, nullptr);
+        EXPECT_EQ(builtin->Fn(), fn);
+        EXPECT_TRUE(builtin->IsRayQuery());
+    };
+    check(init, wgsl::BuiltinFn::kRayQueryInitialize);
+    check(proceed, wgsl::BuiltinFn::kRayQueryProceed);
+    check(generate, wgsl::BuiltinFn::kRayQueryGenerateIntersection);
+    check(confirm, wgsl::BuiltinFn::kRayQueryConfirmIntersection);
+    check(terminate, wgsl::BuiltinFn::kRayQueryTerminate);
+    check(committed, wgsl::BuiltinFn::kRayQueryGetCommittedIntersection);
+    check(candidate, wgsl::BuiltinFn::kRayQueryGetCandidateIntersection);
+
+    EXPECT_TRUE(TypeOf(init)->Is<core::type::Void>());
+    EXPECT_TRUE(TypeOf(proceed)->Is<core::type::Bool>());
+    EXPECT_TRUE(TypeOf(generate)->Is<core::type::Void>());
+    EXPECT_TRUE(TypeOf(confirm)->Is<core::type::Void>());
+    EXPECT_TRUE(TypeOf(terminate)->Is<core::type::Void>());
+    EXPECT_TRUE(core::type::IsRayIntersection(TypeOf(committed)));
+    EXPECT_TRUE(core::type::IsRayIntersection(TypeOf(candidate)));
+    EXPECT_EQ(TypeOf(committed), TypeOf(candidate));
+}
