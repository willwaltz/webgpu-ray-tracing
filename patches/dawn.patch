+// Copies the transforms of `count` instances (tightly packed row-major 3x4 matrices of floats) to
+// the transforms at the start of the backend's 64-byte instance records, and nothing else of the
+// records. Infinities and NaNs become 0 and magnitudes are clamped to 2^50, so that the bounds of
+// the instances stay finite. The offsets are in vec4s from the starts of the bound ranges.
+static const char sCopyAccelerationStructureTransforms[] = DAWN_MULTILINE(
+    struct Params {
+        count : u32,
+        source : u32,
+        destination : u32,
+        pad : u32,
+    }
+
+    @group(0) @binding(0) var<storage, read> source : array<vec4u>;
+    @group(0) @binding(1) var<storage, read_write> destination : array<vec4u>;
+    @group(0) @binding(2) var<uniform> params : Params;
+
+    fn sanitize(v : vec4u) -> vec4u {
+        let exponent = (v >> vec4u(23u)) & vec4u(0xFFu);
+        // (127 + 50) << 23 is 2^50.
+        let clamped = select(v, (v & vec4u(0x80000000u)) | vec4u(0x58800000u),
+                             exponent >= vec4u(177u));
+        return select(clamped, vec4u(0u), exponent == vec4u(0xFFu));
+    }
+
+    @compute @workgroup_size(64, 1, 1)
+    fn main(@builtin(global_invocation_id) id : vec3u) {
+        if (id.x >= params.count) {
+            return;
+        }
+        let s = params.source + 3u * id.x;
+        let d = params.destination + 4u * id.x;
+        destination[d] = sanitize(source[s]);
+        destination[d + 1u] = sanitize(source[s + 1u]);
+        destination[d + 2u] = sanitize(source[s + 2u]);
+    }
+);
+
+ResultOrError<ComputePipelineBase*> GetOrCreateAccelerationStructureTransformsPipeline(
+    DeviceBase* device) {
+    InternalPipelineStore* store = device->GetInternalPipelineStore();
+    if (store->accelerationStructureTransformsPipeline == nullptr) {
+        Ref<ShaderModuleBase> module;
+        DAWN_TRY_ASSIGN(module,
+                        utils::CreateShaderModule(device, sCopyAccelerationStructureTransforms));
+
+        Ref<BindGroupLayoutBase> bgl;
+        DAWN_TRY_ASSIGN(
+            bgl, utils::MakeBindGroupLayout(
+                     device,
+                     {
+                         {0, wgpu::ShaderStage::Compute, wgpu::BufferBindingType::ReadOnlyStorage},
+                         {1, wgpu::ShaderStage::Compute, wgpu::BufferBindingType::Storage},
+                         {2, wgpu::ShaderStage::Compute, wgpu::BufferBindingType::Uniform},
+                     },
+                     /* allowInternalBinding */ false));
+        Ref<PipelineLayoutBase> layout;
+        DAWN_TRY_ASSIGN(layout, utils::MakeBasicPipelineLayout(device, bgl));
+
+        ComputePipelineDescriptor descriptor = {};
+        descriptor.layout = layout.Get();
+        descriptor.compute.module = module.Get();
+        descriptor.compute.entryPoint = "main";
+        DAWN_TRY_ASSIGN(store->accelerationStructureTransformsPipeline,
+                        device->CreateComputePipeline(&descriptor));
+    }
+    return store->accelerationStructureTransformsPipeline.Get();
+}
+
+// Records the compute passes of a (validated) CopyBufferToAccelerationStructureTransforms.
+MaybeError EncodeCopyBufferToAccelerationStructureTransforms(CommandEncoder* encoder,
+                                                             BufferBase* source,
+                                                             uint64_t sourceOffset,
+                                                             AccelerationStructureBase* destination,
+                                                             uint32_t firstInstance,
+                                                             uint32_t instanceCount) {
+    DeviceBase* device = encoder->GetDevice();
+    DAWN_ASSERT(device->IsLockedByCurrentThreadIfNeeded());
+    constexpr uint64_t kRecordSize = 64;
+    constexpr uint64_t kVec4Size = 16;
+
+    ComputePipelineBase* pipeline;
+    DAWN_TRY_ASSIGN(pipeline, GetOrCreateAccelerationStructureTransformsPipeline(device));
+    Ref<BindGroupLayoutBase> layout;
+    DAWN_TRY_ASSIGN(layout, pipeline->GetBindGroupLayout(0));
+    BufferBase* instances = destination->GetInstanceBuffer();
+
+    // The bound ranges start at offsets aligned for storage bindings (and for vec4s), and are
+    // split in chunks that fit in the binding size limit and the workgroup count limit.
+    const uint64_t alignment =
+        std::max(uint64_t(device->GetLimits().v1.minStorageBufferOffsetAlignment), kVec4Size);
+    const uint32_t maxChunk = static_cast<uint32_t>(std::min(
+        uint64_t(1) << 20,
+        (uint64_t(device->GetLimits().v1.maxStorageBufferBindingSize) - alignment) / kRecordSize));
+
+    for (uint32_t done = 0; done < instanceCount;) {
+        const uint32_t count = std::min(instanceCount - done, maxChunk);
+        const uint64_t sourceStart =
+            sourceOffset + uint64_t(done) * kAccelerationStructureTransformSize;
+        const uint64_t sourceBind = sourceStart / alignment * alignment;
+        const uint64_t destinationStart = (uint64_t(firstInstance) + done) * kRecordSize;
+        const uint64_t destinationBind = destinationStart / alignment * alignment;
+
+        struct Params {
+            uint32_t count;
+            uint32_t source;
+            uint32_t destination;
+            uint32_t pad;
+        };
+        const Params params = {count, static_cast<uint32_t>((sourceStart - sourceBind) / kVec4Size),
+                               static_cast<uint32_t>((destinationStart - destinationBind) / kVec4Size),
+                               0};
+        BufferDescriptor paramsDesc = {};
+        paramsDesc.usage = wgpu::BufferUsage::Uniform | wgpu::BufferUsage::CopyDst;
+        paramsDesc.size = sizeof(params);
+        Ref<BufferBase> paramsBuffer;
+        DAWN_TRY_ASSIGN(paramsBuffer, device->CreateBuffer(&paramsDesc));
+        DAWN_TRY(device->GetQueue()->WriteBuffer(paramsBuffer.Get(), 0, ByteSpanFromRef(params)));
+
+        Ref<BindGroupBase> bindGroup;
+        DAWN_TRY_ASSIGN(
+            bindGroup,
+            utils::MakeBindGroup(
+                device, layout,
+                {{0, source, sourceBind,
+                  sourceStart - sourceBind + uint64_t(count) * kAccelerationStructureTransformSize},
+                 {1, instances, destinationBind,
+                  destinationStart - destinationBind + uint64_t(count) * kRecordSize},
+                 {2, paramsBuffer}},
+                UsageValidationMode::Internal));
+
+        Ref<ComputePassEncoder> pass = encoder->BeginComputePass();
+        pass->APISetPipeline(pipeline);
+        pass->APISetBindGroup(0, bindGroup.Get());
+        pass->APIDispatchWorkgroups((count + 63) / 64);
+        pass->APIEnd();
+        done += count;
+    }
+    return {};
+}
