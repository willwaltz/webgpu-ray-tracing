+#ifndef SRC_DAWN_NATIVE_ACCELERATIONSTRUCTURE_H_
+#define SRC_DAWN_NATIVE_ACCELERATIONSTRUCTURE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+#include "absl/container/flat_hash_map.h"
+#include "src/dawn/common/Ref.h"
+#include "src/dawn/native/Error.h"
+#include "src/dawn/native/Forward.h"
+#include "src/dawn/native/ObjectBase.h"
+#include "src/dawn/native/PassResourceUsage.h"
+#include "src/dawn/native/dawn_platform.h"
+
+namespace dawn::native {
+
+// Size in bytes of one instance record passed to Queue::WriteAccelerationStructureInstances.
+inline constexpr uint64_t kAccelerationStructureInstanceRecordSize = 64;
+// Value of AccelerationStructureInstanceRecord::blasIndex for inactive instances.
+inline constexpr uint32_t kInactiveAccelerationStructureInstance = 0xFFFF'FFFFu;
+// The instance flags that can be set in bits 24-31 of sbtOffsetFlags. They match the values of
+// VkGeometryInstanceFlagBitsKHR and D3D12_RAYTRACING_INSTANCE_FLAGS.
+inline constexpr uint32_t kAccelerationStructureInstanceFlagCullDisable = 0x1;
+inline constexpr uint32_t kAccelerationStructureInstanceFlagFlipFacing = 0x2;
+inline constexpr uint32_t kAccelerationStructureInstanceFlagForceOpaque = 0x4;
+inline constexpr uint32_t kAccelerationStructureInstanceFlagForceNoOpaque = 0x8;
+inline constexpr uint32_t kAccelerationStructureInstanceFlagsMask = 0xF;
+// The stride of AABBs if not specified, which is the size of an AABB (6 floats).
+inline constexpr uint64_t kAccelerationStructureAABBSize = 24;
+// Size in bytes of one transform read by CommandEncoder::CopyBufferToAccelerationStructureTransforms
+// (a row-major 3x4 matrix of floats, as in the instance records).
+inline constexpr uint64_t kAccelerationStructureTransformSize = 48;
+
+// The layout of the instance records passed to Queue::WriteAccelerationStructureInstances.
+struct AccelerationStructureInstanceRecord {
+    // Row-major 3x4 object-to-world transform.
+    float transform[12];
+    // Index in the `blases` array of the BLAS for this instance or
+    // kInactiveAccelerationStructureInstance.
+    uint32_t blasIndex;
+    // Bits 0-23 are the instance custom index, bits 24-31 are the instance visibility mask.
+    uint32_t customIndexMask;
+    // Bits 0-23 are the SBT record offset, bits 24-31 are the instance flags.
+    uint32_t sbtOffsetFlags;
+    // Must be 0.
+    uint32_t reserved;
+};
+static_assert(sizeof(AccelerationStructureInstanceRecord) ==
+              kAccelerationStructureInstanceRecordSize);
+static_assert(offsetof(AccelerationStructureInstanceRecord, blasIndex) == 48);
+
+// Limits of the acceleration structures supported by the device.
+struct AccelerationStructureLimits {
+    uint64_t maxGeometryCount = 0;
+    uint64_t maxInstanceCount = 0;
+    uint64_t maxPrimitiveCount = 0;
+};
+
+// Returns the size in bytes of the vertex format as used for acceleration structure builds, and
+// the size of its smallest component (which is the required alignment of the vertex data).
+uint32_t GetAccelerationStructureVertexFormatSize(wgpu::VertexFormat format);
+uint32_t GetAccelerationStructureVertexFormatComponentSize(wgpu::VertexFormat format);
+// Returns the size in bytes of an index of `format`, which must be Uint16 or Uint32.
+uint32_t GetAccelerationStructureIndexFormatSize(wgpu::IndexFormat format);
+
+MaybeError ValidateAccelerationStructureDescriptor(
+    DeviceBase* device,
+    const UnpackedPtr<AccelerationStructureDescriptor>& descriptor);
+
+// Validates `descriptor`, which must have had WithTrivialFrontendDefaults applied.
+MaybeError ValidateAccelerationStructureBuildDescriptor(
+    DeviceBase* device,
+    const AccelerationStructureBuildDescriptor& descriptor);
+
+// Computes the shape of a build, which must stay the same for updates.
+AccelerationStructureBuildShape ComputeAccelerationStructureBuildShape(
+    const AccelerationStructureBuildDescriptor& descriptor);
+
+// Validates that an update of `accelerationStructure` with `updateShape` has the same shape as
+// the build that it updates.
+MaybeError ValidateAccelerationStructureUpdateShape(
+    const AccelerationStructureBase* accelerationStructure,
+    const AccelerationStructureBuildShape& previousShape,
+    const AccelerationStructureBuildShape& updateShape);
+
+// Validates the parameters of Queue::WriteAccelerationStructureInstances.
+MaybeError ValidateWriteAccelerationStructureInstances(
+    DeviceBase* device,
+    AccelerationStructureBase* destination,
+    uint32_t firstInstance,
+    Span<AccelerationStructureBase* const> blases,
+    Span<const std::byte> data);
+
+// Validates the parameters of CommandEncoder::CopyBufferToAccelerationStructureTransforms.
+MaybeError ValidateCopyBufferToAccelerationStructureTransforms(
+    DeviceBase* device,
+    BufferBase* source,
+    uint64_t sourceOffset,
+    AccelerationStructureBase* destination,
+    uint32_t firstInstance,
+    uint32_t instanceCount);
+
+class AccelerationStructureBase : public ApiObjectBase {
+  public:
+    static Ref<AccelerationStructureBase> MakeError(DeviceBase* device,
+                                                    const AccelerationStructureDescriptor* desc);
+
+    ObjectType GetType() const override;
+
+    wgpu::AccelerationStructureType GetAccelerationStructureType() const;
+    bool IsTopLevel() const;
+    bool IsBottomLevel() const;
+    wgpu::AccelerationStructureFlags GetFlags() const;
+    // The (defaulted) layouts of the geometries of a bottom-level acceleration structure.
+    const std::vector<AccelerationStructureGeometryLayout>& GetGeometryLayouts() const;
+    uint32_t GetMaxInstanceCount() const;
+
+    bool IsDestroyed() const;
+    // Checks that the acceleration structure is not destroyed.
+    MaybeError ValidateCanUseInSubmitNow() const;
+    // For top-level acceleration structures: checks that all the BLASes currently referenced by
+    // the instance buffer are alive, which is required to build the TLAS.
+    MaybeError ValidateInstanceBlasesAreAlive() const;
+    // For top-level acceleration structures: checks that all the BLASes that were referenced by
+    // the instance buffer at the time of the last build of the TLAS are alive, which is required
+    // to trace rays against the TLAS.
+    MaybeError ValidateBuiltBlasesAreAlive() const;
+    // For top-level acceleration structures: checks that none of the instances of the last build
+    // changed between active and inactive since then, which is required to update the TLAS.
+    MaybeError ValidateUpdateKeepsInstanceActivity() const;
+
+    // The shape of the last build in queue order, used to validate updates.
+    const AccelerationStructureBuildShape& GetLastBuildShape() const;
+    // Called in queue order when a submit containing a build of this acceleration structure is
+    // executed.
+    void OnBuildSubmitted(const AccelerationStructureBuildShape& shape);
+
+    // Writes instances to the internal instance buffer of a top-level acceleration structure and
+    // updates the references to the BLASes. The parameters must have been validated already.
+    MaybeError WriteInstances(uint32_t firstInstance,
+                              Span<AccelerationStructureBase* const> blases,
+                              Span<const std::byte> data);
+
+    // For top-level acceleration structures: the internal buffer of the backend's instance
+    // records, which have their 48-byte transform at the start of each 64-byte record. GPU
+    // commands write the transforms there (and only them). Null if the backend doesn't support
+    // that, and after the acceleration structure is destroyed.
+    virtual BufferBase* GetInstanceBuffer() const;
+
+    // Dawn API
+    void APIDestroy();
+    wgpu::AccelerationStructureType APIGetType() const;
+
+  protected:
+    AccelerationStructureBase(DeviceBase* device,
+                              const UnpackedPtr<AccelerationStructureDescriptor>& descriptor);
+    AccelerationStructureBase(DeviceBase* device,
+                              const AccelerationStructureDescriptor* descriptor,
+                              ObjectBase::ErrorTag tag);
+    ~AccelerationStructureBase() override;
+
+    void DestroyImpl(DestroyReason reason) override;
+
+    // Writes the instance records in `data` (that start at `firstInstance`) to the instance
+    // buffer. `blases` are the bottom-level acceleration structures they reference.
+    virtual MaybeError WriteInstancesImpl(uint32_t firstInstance,
+                                          Span<AccelerationStructureBase* const> blases,
+                                          Span<const std::byte> data) = 0;
+
+  private:
+    void SetInstanceBlas(uint32_t instance, AccelerationStructureBase* blas);
+
+    wgpu::AccelerationStructureType mType = wgpu::AccelerationStructureType::Undefined;
+    wgpu::AccelerationStructureFlags mFlags = wgpu::AccelerationStructureFlags::None;
+    std::vector<AccelerationStructureGeometryLayout> mGeometryLayouts;
+    uint32_t mMaxInstanceCount = 0;
+
+    enum class State { Error, Alive, Destroyed };
+    State mState = State::Error;
+
+    AccelerationStructureBuildShape mLastBuildShape;
+
+    // For top-level acceleration structures: the BLAS referenced by each instance of the instance
+    // buffer (as of the queue timeline), along with how many instances reference each BLAS. The
+    // refs keep the BLASes alive while they are referenced.
+    std::vector<AccelerationStructureBase*> mInstanceBlases;
+    struct BlasReference {
+        Ref<AccelerationStructureBase> blas;
+        uint32_t instanceCount = 0;
+    };
+    absl::flat_hash_map<AccelerationStructureBase*, BlasReference> mReferencedBlases;
+    // The BLASes that were referenced by the instance buffer when the TLAS was last built, which
+    // are the BLASes that the contents of the TLAS actually reference.
+    std::vector<Ref<AccelerationStructureBase>> mBuiltBlases;
+    // Whether each of the instances of the last build of the TLAS was active, and how many of
+    // these instances changed between active and inactive since then.
+    std::vector<bool> mBuiltInstanceActivity;
+    uint32_t mInstanceActivityMismatchCount = 0;
+};
+
+}  // namespace dawn::native
+
+#endif  // SRC_DAWN_NATIVE_ACCELERATIONSTRUCTURE_H_
