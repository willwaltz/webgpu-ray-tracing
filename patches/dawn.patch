+class SpirvWriterRayQueryTest : public SpirvWriterTest {
+  protected:
+    /// Declares the `tlas` acceleration structure at @group(0) @binding(1).
+    core::ir::Var* Tlas() {
+        if (!tlas_) {
+            tlas_ = b.Var("tlas", ty.ptr(handle, ty.acceleration_structure(), core::Access::kRead));
+            tlas_->SetBindingPoint(0, 1);
+            mod.root_block->Append(tlas_);
+        }
+        return tlas_;
+    }
+
+    /// @returns the RayDesc structure type
+    const core::type::Struct* RayDesc() { return core::type::CreateRayDesc(ty, mod.symbols); }
+
+    /// @returns the RayIntersection structure type
+    const core::type::Struct* RayIntersection() {
+        return core::type::CreateRayIntersection(ty, mod.symbols);
+    }
+
+    /// Creates a function-scope ray query, initializes it, and then calls @p cb with the ray
+    /// query pointer, in a compute shader entry point.
+    template <typename CALLBACK>
+    void ComputeWithRayQuery(CALLBACK&& cb) {
+        auto* tlas = Tlas();
+        auto* ep = b.ComputeFunction("main");
+        b.Append(ep->Block(), [&] {
+            auto* rq = b.Var("rq", ty.ptr(function, ty.ray_query()));
+            b.Call(ty.void_(), core::BuiltinFn::kRayQueryInitialize, rq, b.Load(tlas),
+                   b.Zero(RayDesc()));
+            cb(rq);
+            b.Return(ep);
+        });
+    }
+
+  private:
+    core::ir::Var* tlas_ = nullptr;
+};
