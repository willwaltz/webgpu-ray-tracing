+// TLAS updates can't change whether instances are active.
+TEST_P(AccelerationStructureValidationTests, TlasUpdateInstanceActivity) {
+    constexpr auto kUpdate = wgpu::AccelerationStructureBuildMode::Update;
+    wgpu::AccelerationStructure blasA = CreateBuiltTriangleBlas();
+    wgpu::AccelerationStructure blasB = CreateBuiltTriangleBlas();
+    wgpu::AccelerationStructure tlas = CreateTlas(3, wgpu::AccelerationStructureFlags::AllowUpdate);
+
+    WriteInstances(tlas, 0, {blasA, blasB}, {MakeInstance(0), MakeInstance(1)});
+    Build(tlas, {}, 3);
+
+    // Changing the BLAS or the transform of active instances is allowed.
+    WriteInstances(tlas, 0, {blasB}, {MakeInstance(0, 1, {1, 2, 3})});
+    Build(tlas, {}, 3, kUpdate);
+
+    // Deactivating an instance isn't.
+    WriteInstances(tlas, 1, {}, {MakeInstance(kInactiveInstance)});
+    wgpu::CommandBuffer commands = EncodeBuildCommands(tlas, {}, 3, kUpdate);
+    ASSERT_DEVICE_ERROR(queue.Submit(1, &commands));
+
+    // Reactivating it fixes the update.
+    WriteInstances(tlas, 1, {blasA}, {MakeInstance(0)});
+    Build(tlas, {}, 3, kUpdate);
+
+    // Activating an instance that was inactive in the build isn't allowed.
+    WriteInstances(tlas, 2, {blasA}, {MakeInstance(0)});
+    commands = EncodeBuildCommands(tlas, {}, 3, kUpdate);
+    ASSERT_DEVICE_ERROR(queue.Submit(1, &commands));
+
+    // Unless the TLAS is built first.
+    {
+        wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+        EncodeBuild(encoder, tlas, {}, 3);
+        EncodeBuild(encoder, tlas, {}, 3, kUpdate);
+        commands = encoder.Finish();
+        queue.Submit(1, &commands);
+    }
+    Build(tlas, {}, 3, kUpdate);
+
+    // Instances past the instance count of the build can change.
+    Build(tlas, {}, 1);
+    WriteInstances(tlas, 1, {}, {MakeInstance(kInactiveInstance), MakeInstance(kInactiveInstance)});
+    Build(tlas, {}, 1, kUpdate);
+}
