+// Validation of the number of geometries, primitives and vertices of BLAS builds.
+TEST_P(AccelerationStructureValidationTests, BuildCounts) {
+    wgpu::Buffer vertices = CreateInputBuffer(TriangleVertices(1.0));
+    wgpu::AccelerationStructure blas = CreateBlas({TriangleLayout(3, 1)});
+
+    // Success case.
+    Build(blas, {TriangleData(vertices, 3, 1)});
+    // Fewer primitives or vertices than the maximum are allowed.
+    Build(blas, {TriangleData(vertices, 3, 0)});
+    Build(blas, {TriangleData(nullptr, 0, 0)});
+
+    // The number of geometries must match.
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {}));
+    ASSERT_DEVICE_ERROR(
+        EncodeBuildCommands(blas, {TriangleData(vertices, 3, 1), TriangleData(vertices, 3, 1)}));
+
+    // The counts must be at most the maximums of the layout.
+    wgpu::Buffer moreVertices = CreateInputBuffer(std::vector<float>(18, 0.0f));
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {TriangleData(moreVertices, 6, 2)}));
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {TriangleData(moreVertices, 4, 1)}));
+
+    // Non-indexed triangles need 3 vertices each.
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {TriangleData(vertices, 2, 1)}));
+
+    // A TLAS build can't have geometries.
+    wgpu::AccelerationStructure tlas = CreateTlas(2);
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(tlas, {TriangleData(vertices, 3, 1)}, 1));
+
+    // The instance count of TLAS builds is at most the maximum.
+    Build(tlas, {}, 2);
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(tlas, {}, 3));
+
+    // BLAS builds have no instances.
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {TriangleData(vertices, 3, 1)}, 1));
+}
+
+// Validation of the vertex and index buffers of triangle geometries.
+TEST_P(AccelerationStructureValidationTests, BuildTriangleBuffers) {
+    // 4 vertices with a 16-byte stride.
+    wgpu::Buffer vertices = CreateBuffer(64);
+    wgpu::AccelerationStructure blas = CreateBlas({TriangleLayout(4, 1)});
+
+    auto Data = [&](uint64_t offset, uint64_t stride, uint32_t vertexCount,
+                    uint32_t primitiveCount = 1) {
+        wgpu::AccelerationStructureGeometryData data =
+            TriangleData(vertices, vertexCount, primitiveCount);
+        data.vertexOffset = offset;
+        data.vertexStride = stride;
+        return data;
+    };
+
+    // Success cases, the last vertex can end at the end of the buffer.
+    Build(blas, {Data(0, 16, 4)});
+    Build(blas, {Data(4, 16, 3)});
+    Build(blas, {Data(64 - 12, 0, 1, 0)});
+    // Tightly packed vertices.
+    Build(blas, {Data(64 - 36, 0, 3)});
+
+    // The vertex buffer is required when there are vertices.
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {TriangleData(nullptr, 3, 1)}));
+
+    // The vertices must be in bounds.
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {Data(4, 20, 4)}));
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {Data(64 - 32, 0, 3)}));
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {Data(68, 0, 3)}));
+
+    // The offset and stride must be multiples of the component size.
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {Data(2, 16, 3)}));
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {Data(0, 14, 3)}));
+
+    // The stride must fit in 32 bits.
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {Data(0, uint64_t(1) << 32, 1, 0)}));
+
+    // The vertex buffer must have the AccelerationStructureInput usage.
+    {
+        wgpu::Buffer vertexOnly =
+            CreateBuffer(64, wgpu::BufferUsage::Vertex | wgpu::BufferUsage::CopyDst);
+        ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {TriangleData(vertexOnly, 3, 1)}));
+    }
+
+    // Triangle geometries don't have AABBs.
+    {
+        wgpu::AccelerationStructureGeometryData data = Data(0, 16, 3);
+        data.AABBBuffer = CreateBuffer(64);
+        ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {data}));
+    }
+
+    // Non-indexed geometries don't have an index buffer.
+    {
+        wgpu::AccelerationStructureGeometryData data = Data(0, 16, 3);
+        data.indexBuffer = CreateBuffer(64);
+        ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {data}));
+    }
+
+    // Components of half-float formats are 2-byte aligned.
+    {
+        wgpu::AccelerationStructure halfBlas = CreateBlas(
+            {TriangleLayout(3, 1, wgpu::IndexFormat::Undefined, wgpu::VertexFormat::Float16x4)});
+        wgpu::AccelerationStructureGeometryData data = Data(2, 10, 3);
+        Build(halfBlas, {data});
+        data.vertexOffset = 1;
+        ASSERT_DEVICE_ERROR(EncodeBuildCommands(halfBlas, {data}));
+    }
+
+    // Indexed geometries.
+    for (wgpu::IndexFormat format : {wgpu::IndexFormat::Uint16, wgpu::IndexFormat::Uint32}) {
+        const uint64_t indexSize = format == wgpu::IndexFormat::Uint16 ? 2 : 4;
+        wgpu::AccelerationStructure indexedBlas = CreateBlas({TriangleLayout(4, 2, format)});
+        wgpu::Buffer indices = CreateBuffer(6 * indexSize + 4);
+
+        auto IndexedData = [&](uint64_t indexOffset, uint32_t primitiveCount) {
+            wgpu::AccelerationStructureGeometryData data =
+                TriangleData(vertices, 4, primitiveCount, indices);
+            data.vertexStride = 16;
+            data.indexOffset = indexOffset;
+            return data;
+        };
+
+        // Success cases.
+        Build(indexedBlas, {IndexedData(0, 2)});
+        Build(indexedBlas, {IndexedData(4, 2)});
+        Build(indexedBlas, {IndexedData(0, 0)});
+        // No index buffer is needed without primitives.
+        Build(indexedBlas, {TriangleData(vertices, 4, 0)});
+
+        // The index buffer is required when there are primitives.
+        ASSERT_DEVICE_ERROR(EncodeBuildCommands(indexedBlas, {TriangleData(vertices, 4, 1)}));
+
+        // Vertices are required when there are primitives.
+        ASSERT_DEVICE_ERROR(
+            EncodeBuildCommands(indexedBlas, {TriangleData(nullptr, 0, 1, indices)}));
+
+        // The indices must be in bounds.
+        ASSERT_DEVICE_ERROR(EncodeBuildCommands(indexedBlas, {IndexedData(4 + indexSize, 2)}));
+
+        // The index offset must be a multiple of the index size.
+        ASSERT_DEVICE_ERROR(EncodeBuildCommands(indexedBlas, {IndexedData(indexSize / 2, 1)}));
+
+        // The index buffer must have the AccelerationStructureInput usage.
+        wgpu::AccelerationStructureGeometryData data = IndexedData(0, 1);
+        data.indexBuffer = CreateBuffer(64, wgpu::BufferUsage::Index | wgpu::BufferUsage::CopyDst);
+        ASSERT_DEVICE_ERROR(EncodeBuildCommands(indexedBlas, {data}));
+    }
+}
