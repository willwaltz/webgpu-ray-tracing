+        blases.push_back(blas);
+    }
+
+    wgpu::AccelerationStructure tlas = CreateTlas(uint32_t(blases.size()));
+    std::vector<InstanceRecord> instances;
+    for (uint32_t i = 0; i < blases.size(); ++i) {
