+// Updates of BLASes and TLASes after changing their inputs.
+TEST_P(AccelerationStructureBuildTests, Updates) {
+    constexpr auto kUpdate = wgpu::AccelerationStructureBuildMode::Update;
+    wgpu::Buffer vertexBuffer = CreateInputBuffer(TriangleVertices(1.0));
+    wgpu::AccelerationStructure blas =
+        CreateBlas({TriangleLayout(3, 1)}, wgpu::AccelerationStructureFlags::AllowUpdate |
+                                               wgpu::AccelerationStructureFlags::PreferFastBuild);
+    Build(blas, {TriangleData(vertexBuffer, 3, 1)});
+
+    wgpu::AccelerationStructure tlas = CreateTlas(1, wgpu::AccelerationStructureFlags::AllowUpdate);
+    WriteInstances(tlas, 0, {blas}, {MakeInstance(0)});
+    Build(tlas, {}, 1);
+    CheckTlasCanBeUsedInComputePass(tlas);
+
+    for (uint32_t i = 0; i < 3; ++i) {
+        std::vector<float> vertices = TriangleVertices(2.0f + i);
+        queue.WriteBuffer(vertexBuffer, 0, vertices.data(), vertices.size() * sizeof(float));
+        WriteInstances(tlas, 0, {blas}, {MakeInstance(0, i, {float(i), 0, 0})});
+
+        wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+        EncodeBuild(encoder, blas, {TriangleData(vertexBuffer, 3, 1)}, 0, kUpdate);
+        EncodeBuild(encoder, tlas, {}, 1, kUpdate);
+        wgpu::CommandBuffer commands = encoder.Finish();
+        queue.Submit(1, &commands);
+        CheckTlasCanBeUsedInComputePass(tlas);
+    }
+}
