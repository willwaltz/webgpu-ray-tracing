+uint32_t GetAccelerationStructureVertexFormatSize(wgpu::VertexFormat format) {
+    // These are the formats that are required to support
+    // VK_FORMAT_FEATURE_ACCELERATION_STRUCTURE_VERTEX_BUFFER_BIT_KHR and that are supported for
+    // D3D12_RAYTRACING_GEOMETRY_TRIANGLES_DESC::VertexFormat without requiring Tier 1.1.
+    switch (format) {
+        case wgpu::VertexFormat::Float32x2:
+            return 8;
+        case wgpu::VertexFormat::Float32x3:
+            return 12;
+        case wgpu::VertexFormat::Float16x2:
+            return 4;
+        case wgpu::VertexFormat::Float16x4:
+            return 8;
+        case wgpu::VertexFormat::Snorm16x2:
+            return 4;
+        case wgpu::VertexFormat::Snorm16x4:
+            return 8;
+        default:
+            return 0;
+    }
+}
+
+uint32_t GetAccelerationStructureVertexFormatComponentSize(wgpu::VertexFormat format) {
+    switch (format) {
+        case wgpu::VertexFormat::Float32x2:
+        case wgpu::VertexFormat::Float32x3:
+            return 4;
+        case wgpu::VertexFormat::Float16x2:
+        case wgpu::VertexFormat::Float16x4:
+        case wgpu::VertexFormat::Snorm16x2:
+        case wgpu::VertexFormat::Snorm16x4:
+            return 2;
+        default:
+            return 0;
+    }
+}
+
+uint32_t GetAccelerationStructureIndexFormatSize(wgpu::IndexFormat format) {
+    switch (format) {
+        case wgpu::IndexFormat::Uint16:
+            return 2;
+        case wgpu::IndexFormat::Uint32:
+            return 4;
+        default:
+            DAWN_UNREACHABLE();
+    }
+}
+
+MaybeError ValidateAccelerationStructureDescriptor(
+    DeviceBase* device,
+    const UnpackedPtr<AccelerationStructureDescriptor>& descriptor) {
+    DAWN_INVALID_IF(!device->HasFeature(Feature::ChromiumExperimentalRayQuery),
+                    "Acceleration structures require the %s feature.",
+                    wgpu::FeatureName::ChromiumExperimentalRayQuery);
+
+    DAWN_TRY(ValidateAccelerationStructureType(descriptor->type));
+    DAWN_TRY(ValidateAccelerationStructureFlags(descriptor->flags));
+    DAWN_INVALID_IF((descriptor->flags & wgpu::AccelerationStructureFlags::PreferFastTrace) &&
+                        (descriptor->flags & wgpu::AccelerationStructureFlags::PreferFastBuild),
+                    "Flags (%s) contain both %s and %s.", descriptor->flags,
+                    wgpu::AccelerationStructureFlags::PreferFastTrace,
+                    wgpu::AccelerationStructureFlags::PreferFastBuild);
+
+    const AccelerationStructureLimits limits = device->GetAccelerationStructureLimits();
+
+    switch (descriptor->type) {
+        case wgpu::AccelerationStructureType::BottomLevel: {
+            DAWN_INVALID_IF(descriptor->maxInstanceCount != 0,
+                            "maxInstanceCount (%u) is not 0 for a bottom-level acceleration "
+                            "structure.",
+                            descriptor->maxInstanceCount);
+            DAWN_INVALID_IF(descriptor->geometries.empty(),
+                            "A bottom-level acceleration structure must have at least one "
+                            "geometry.");
+            DAWN_INVALID_IF(descriptor->geometries.size() > limits.maxGeometryCount,
+                            "The number of geometries (%u) exceeds the maximum (%u).",
+                            descriptor->geometries.size(), limits.maxGeometryCount);
+
+            uint64_t totalPrimitiveCount = 0;
+            const wgpu::AccelerationStructureGeometryType geometryType =
+                descriptor->geometries.front().type;
+            for (auto [i, layout] : Enumerate(descriptor->geometries)) {
+                DAWN_TRY_CONTEXT(ValidateGeometryLayout(layout), "validating geometries[%u]", i);
+                DAWN_INVALID_IF(layout.type != geometryType,
+                                "The type of geometries[%u] (%s) doesn't match the type of "
+                                "geometries[0] (%s). All the geometries of a bottom-level "
+                                "acceleration structure must have the same type.",
+                                i, layout.type, geometryType);
+                totalPrimitiveCount += layout.maxPrimitiveCount;
+            }
+            DAWN_INVALID_IF(totalPrimitiveCount > limits.maxPrimitiveCount,
+                            "The total number of primitives (%u) exceeds the maximum (%u).",
+                            totalPrimitiveCount, limits.maxPrimitiveCount);
+            break;
+        }
+
+        case wgpu::AccelerationStructureType::TopLevel:
+            DAWN_INVALID_IF(!descriptor->geometries.empty(),
+                            "A top-level acceleration structure has %u geometries instead of 0.",
+                            descriptor->geometries.size());
+            DAWN_INVALID_IF(descriptor->maxInstanceCount == 0,
+                            "maxInstanceCount is 0 for a top-level acceleration structure.");
+            DAWN_INVALID_IF(descriptor->maxInstanceCount > limits.maxInstanceCount,
+                            "maxInstanceCount (%u) exceeds the maximum (%u).",
+                            descriptor->maxInstanceCount, limits.maxInstanceCount);
+            break;
+
+        default:
+            DAWN_UNREACHABLE();
+    }
+
+    return {};
+}
+
+MaybeError ValidateAccelerationStructureBuildDescriptor(
+    DeviceBase* device,
+    const AccelerationStructureBuildDescriptor& descriptor) {
+    DAWN_INVALID_IF(descriptor.destination == nullptr, "destination is not set.");
+    DAWN_TRY(device->ValidateObject(descriptor.destination));
+    DAWN_TRY(ValidateAccelerationStructureBuildMode(descriptor.mode));
+
+    AccelerationStructureBase* destination = descriptor.destination;
+    if (descriptor.mode == wgpu::AccelerationStructureBuildMode::Update) {
+        DAWN_INVALID_IF(!(destination->GetFlags() & wgpu::AccelerationStructureFlags::AllowUpdate),
+                        "%s is updated but was not created with %s.", destination,
+                        wgpu::AccelerationStructureFlags::AllowUpdate);
+    }
+
+    if (destination->IsTopLevel()) {
+        DAWN_INVALID_IF(!descriptor.geometries.empty(),
+                        "%u geometries are specified for the top-level %s.",
+                        descriptor.geometries.size(), destination);
+        DAWN_INVALID_IF(descriptor.instanceCount > destination->GetMaxInstanceCount(),
+                        "instanceCount (%u) is larger than the maxInstanceCount (%u) of %s.",
+                        descriptor.instanceCount, destination->GetMaxInstanceCount(), destination);
+        return {};
+    }
+
+    DAWN_INVALID_IF(descriptor.instanceCount != 0,
+                    "instanceCount (%u) is not 0 for the bottom-level %s.",
+                    descriptor.instanceCount, destination);
+
+    const std::vector<AccelerationStructureGeometryLayout>& layouts =
+        destination->GetGeometryLayouts();
+    DAWN_INVALID_IF(descriptor.geometries.size() != layouts.size(),
+                    "The number of geometries (%u) doesn't match the number of geometries (%u) "
+                    "of %s.",
+                    descriptor.geometries.size(), layouts.size(), destination);
+
+    for (auto [i, data] : Enumerate(descriptor.geometries)) {
+        DAWN_TRY_CONTEXT(ValidateGeometryData(device, layouts[i], data),
+                         "validating geometries[%u]", i);
+    }
+
+    return {};
+}
+
+AccelerationStructureBuildShape ComputeAccelerationStructureBuildShape(
+    const AccelerationStructureBuildDescriptor& descriptor) {
+    AccelerationStructureBuildShape shape;
+    const AccelerationStructureBase* destination = descriptor.destination;
+    if (destination->IsTopLevel()) {
+        shape.instanceCount = descriptor.instanceCount;
+        return shape;
+    }
+
+    const std::vector<AccelerationStructureGeometryLayout>& layouts =
+        destination->GetGeometryLayouts();
+    shape.geometries.reserve(descriptor.geometries.size());
+    for (auto [i, data] : Enumerate(descriptor.geometries)) {
+        AccelerationStructureGeometryShape geometry;
+        geometry.primitiveCount = data.primitiveCount;
+        if (i < layouts.size() &&
+            layouts[i].type == wgpu::AccelerationStructureGeometryType::Triangles) {
+            geometry.vertexCount = data.vertexCount;
+        }
+        shape.geometries.push_back(geometry);
+    }
+    return shape;
+}
+
+MaybeError ValidateAccelerationStructureUpdateShape(
+    const AccelerationStructureBase* accelerationStructure,
+    const AccelerationStructureBuildShape& previousShape,
+    const AccelerationStructureBuildShape& updateShape) {
+    DAWN_INVALID_IF(updateShape.instanceCount != previousShape.instanceCount,
+                    "%s is updated with %u instances while it was last built with %u instances.",
+                    accelerationStructure, updateShape.instanceCount, previousShape.instanceCount);
+    DAWN_CHECK(updateShape.geometries.size() == previousShape.geometries.size());
+    for (auto [i, geometry] : Enumerate(updateShape.geometries)) {
+        const AccelerationStructureGeometryShape& previous = previousShape.geometries[i];
+        DAWN_INVALID_IF(geometry.primitiveCount != previous.primitiveCount,
+                        "%s is updated with %u primitives for geometries[%u] while it was last "
+                        "built with %u primitives.",
+                        accelerationStructure, geometry.primitiveCount, i, previous.primitiveCount);
+        DAWN_INVALID_IF(geometry.vertexCount != previous.vertexCount,
+                        "%s is updated with %u vertices for geometries[%u] while it was last built "
+                        "with %u vertices.",
+                        accelerationStructure, geometry.vertexCount, i, previous.vertexCount);
+    }
+    return {};
+}
+
+MaybeError ValidateWriteAccelerationStructureInstances(
+    DeviceBase* device,
+    AccelerationStructureBase* destination,
+    uint32_t firstInstance,
+    Span<AccelerationStructureBase* const> blases,
+    Span<const std::byte> data) {
+    DAWN_TRY(device->ValidateObject(destination));
+    DAWN_INVALID_IF(!destination->IsTopLevel(),
+                    "%s is not a top-level acceleration structure (its type is %s).", destination,
+                    destination->GetAccelerationStructureType());
+    DAWN_TRY(destination->ValidateCanUseInSubmitNow());
+
+    DAWN_INVALID_IF(data.size() % kAccelerationStructureInstanceRecordSize != 0,
+                    "The data size (%u) is not a multiple of the instance record size (%u).",
+                    data.size(), kAccelerationStructureInstanceRecordSize);
+    const uint64_t instanceCount = data.size() / kAccelerationStructureInstanceRecordSize;
+    DAWN_INVALID_IF(uint64_t(firstInstance) + instanceCount > destination->GetMaxInstanceCount(),
+                    "The instances (first: %u, count: %u) don't fit in the maxInstanceCount (%u) "
+                    "of %s.",
+                    firstInstance, instanceCount, destination->GetMaxInstanceCount(), destination);
+
+    for (auto [i, blas] : Enumerate(blases)) {
+        DAWN_INVALID_IF(blas == nullptr, "blases[%u] is null.", i);
+        DAWN_TRY_CONTEXT(device->ValidateObject(blas), "validating blases[%u]", i);
+        DAWN_INVALID_IF(!blas->IsBottomLevel(),
+                        "blases[%u] (%s) is not a bottom-level acceleration structure (its type "
+                        "is %s).",
+                        i, blas, blas->GetAccelerationStructureType());
+        DAWN_TRY_CONTEXT(blas->ValidateCanUseInSubmitNow(), "validating blases[%u]", i);
+    }
+
+    for (uint64_t i = 0; i < instanceCount; ++i) {
+        AccelerationStructureInstanceRecord record;
+        DAWN_UNSAFE_TODO(memcpy(&record, data.data() + i * kAccelerationStructureInstanceRecordSize,
+                                sizeof(record)));
+
+        DAWN_INVALID_IF(record.blasIndex != kInactiveAccelerationStructureInstance &&
+                            record.blasIndex >= blases.size(),
+                        "The blasIndex (%u) of instance record %u is out of bounds of the %u "
+                        "blases (and isn't 0x%08x for an inactive instance).",
+                        record.blasIndex, i, blases.size(), kInactiveAccelerationStructureInstance);
+        const uint32_t instanceFlags = record.sbtOffsetFlags >> 24;
+        DAWN_INVALID_IF((instanceFlags & ~kAccelerationStructureInstanceFlagsMask) != 0,
+                        "The instance flags (0x%02x) of instance record %u contain unknown bits "
+                        "(the known bits are 0x%02x).",
+                        instanceFlags, i, kAccelerationStructureInstanceFlagsMask);
+        DAWN_INVALID_IF(record.reserved != 0,
+                        "The reserved member (0x%08x) of instance record %u is not 0.",
+                        record.reserved, i);
+    }
+
+    return {};
+}
+
+MaybeError ValidateCopyBufferToAccelerationStructureTransforms(
+    DeviceBase* device,
+    BufferBase* source,
+    uint64_t sourceOffset,
+    AccelerationStructureBase* destination,
+    uint32_t firstInstance,
+    uint32_t instanceCount) {
+    DAWN_TRY(device->ValidateObject(source));
+    DAWN_TRY(ValidateCanUseAs(source, wgpu::BufferUsage::Storage));
+    DAWN_INVALID_IF(sourceOffset % 16 != 0, "The source offset (%u) is not a multiple of 16.",
+                    sourceOffset);
+    DAWN_TRY(ValidateInputRange(source, sourceOffset,
+                                uint64_t(instanceCount) * kAccelerationStructureTransformSize,
+                                "transform"));
+
+    DAWN_TRY(device->ValidateObject(destination));
+    DAWN_INVALID_IF(!destination->IsTopLevel(),
+                    "%s is not a top-level acceleration structure (its type is %s).", destination,
+                    destination->GetAccelerationStructureType());
+    DAWN_INVALID_IF(destination->IsDestroyed(), "%s used while destroyed.", destination);
+    DAWN_INVALID_IF(uint64_t(firstInstance) + instanceCount > destination->GetMaxInstanceCount(),
+                    "The instances (first: %u, count: %u) don't fit in the maxInstanceCount (%u) "
+                    "of %s.",
+                    firstInstance, instanceCount, destination->GetMaxInstanceCount(), destination);
+    DAWN_INVALID_IF(destination->GetInstanceBuffer() == nullptr,
+                    "%s doesn't support GPU writes of its transforms.", destination);
+    return {};
+}
+
+// AccelerationStructureBase
+
+AccelerationStructureBase::AccelerationStructureBase(
+    DeviceBase* device,
+    const UnpackedPtr<AccelerationStructureDescriptor>& descriptor)
+    : ApiObjectBase(device, descriptor->label),
+      mType(descriptor->type),
+      mFlags(descriptor->flags),
+      mMaxInstanceCount(descriptor->maxInstanceCount),
+      mState(State::Alive) {
+    if (mType == wgpu::AccelerationStructureType::BottomLevel) {
+        mGeometryLayouts.assign(descriptor->geometries.begin(), descriptor->geometries.end());
+        // The acceleration structure starts with an empty build of all its geometries.
+        mLastBuildShape.geometries.resize(mGeometryLayouts.size());
+    }
+    GetObjectTrackingList()->Track(this);
+}
+
+AccelerationStructureBase::AccelerationStructureBase(
+    DeviceBase* device,
+    const AccelerationStructureDescriptor* descriptor,
+    ObjectBase::ErrorTag tag)
+    : ApiObjectBase(device, tag, descriptor->label),
+      mType(descriptor->type),
+      mFlags(descriptor->flags),
+      mMaxInstanceCount(descriptor->maxInstanceCount),
+      mState(State::Error) {}
+
+AccelerationStructureBase::~AccelerationStructureBase() {
+    DAWN_CHECK(mState == State::Error || mState == State::Destroyed);
+}
+
+void AccelerationStructureBase::DestroyImpl(DestroyReason reason) {
+    mState = State::Destroyed;
+
+    // Drop the references to the BLASes. This might delete them so move the containers to the
+    // stack so that the members are not modified while being cleared.
+    auto referencedBlases = std::move(mReferencedBlases);
+    auto builtBlases = std::move(mBuiltBlases);
+    mReferencedBlases.clear();
+    mBuiltBlases.clear();
+    mInstanceBlases.clear();
+    mBuiltInstanceActivity.clear();
+    mInstanceActivityMismatchCount = 0;
+}
+
+// static
+Ref<AccelerationStructureBase> AccelerationStructureBase::MakeError(
+    DeviceBase* device,
+    const AccelerationStructureDescriptor* descriptor) {
+    return AcquireRef(new ErrorAccelerationStructure(device, descriptor));
+}
+
+ObjectType AccelerationStructureBase::GetType() const {
+    return ObjectType::AccelerationStructure;
+}
+
+wgpu::AccelerationStructureType AccelerationStructureBase::GetAccelerationStructureType() const {
+    return mType;
+}
+
+bool AccelerationStructureBase::IsTopLevel() const {
+    return mType == wgpu::AccelerationStructureType::TopLevel;
+}
+
+bool AccelerationStructureBase::IsBottomLevel() const {
+    return mType == wgpu::AccelerationStructureType::BottomLevel;
+}
+
+wgpu::AccelerationStructureFlags AccelerationStructureBase::GetFlags() const {
+    return mFlags;
+}
+
+const std::vector<AccelerationStructureGeometryLayout>&
+AccelerationStructureBase::GetGeometryLayouts() const {
+    return mGeometryLayouts;
+}
+
+uint32_t AccelerationStructureBase::GetMaxInstanceCount() const {
+    return mMaxInstanceCount;
+}
+
+bool AccelerationStructureBase::IsDestroyed() const {
+    return mState == State::Destroyed;
+}
+
+BufferBase* AccelerationStructureBase::GetInstanceBuffer() const {
+    return nullptr;
+}
+
+MaybeError AccelerationStructureBase::ValidateCanUseInSubmitNow() const {
+    DAWN_CHECK(!IsError());
+    DAWN_INVALID_IF(mState == State::Destroyed, "%s used while destroyed.", this);
+    return {};
+}
+
+MaybeError AccelerationStructureBase::ValidateInstanceBlasesAreAlive() const {
+    DAWN_CHECK(IsTopLevel());
+    for (const auto& [blas, reference] : mReferencedBlases) {
+        DAWN_INVALID_IF(blas->IsDestroyed(),
+                        "%s is used while its instance buffer references %s (in %u instances) "
+                        "which is destroyed.",
+                        this, blas, reference.instanceCount);
+    }
+    return {};
+}
+
+MaybeError AccelerationStructureBase::ValidateBuiltBlasesAreAlive() const {
+    DAWN_CHECK(IsTopLevel());
+    for (const Ref<AccelerationStructureBase>& blas : mBuiltBlases) {
+        DAWN_INVALID_IF(blas->IsDestroyed(),
+                        "%s is used while it was last built with instances referencing %s which "
+                        "is destroyed.",
+                        this, blas.Get());
+    }
+    return {};
+}
+
+MaybeError AccelerationStructureBase::ValidateUpdateKeepsInstanceActivity() const {
+    DAWN_CHECK(IsTopLevel());
+    DAWN_INVALID_IF(mInstanceActivityMismatchCount != 0,
+                    "%s is updated while %u of the instances it was last built with changed "
+                    "between active and inactive. Updates cannot change whether instances are "
+                    "active, a build must be used instead.",
+                    this, mInstanceActivityMismatchCount);
+    return {};
+}
+
+const AccelerationStructureBuildShape& AccelerationStructureBase::GetLastBuildShape() const {
+    return mLastBuildShape;
+}
+
+void AccelerationStructureBase::OnBuildSubmitted(const AccelerationStructureBuildShape& shape) {
+    // Builds of destroyed acceleration structures are skipped (and are validation errors).
+    if (mState != State::Alive) {
+        return;
+    }
+
+    mLastBuildShape = shape;
+
+    if (!IsTopLevel()) {
+        return;
+    }
+
+    // The TLAS now references the BLASes that are currently referenced by its instances.
+    std::vector<Ref<AccelerationStructureBase>> builtBlases;
+    builtBlases.reserve(mReferencedBlases.size());
+    for (const auto& [blas, reference] : mReferencedBlases) {
+        builtBlases.push_back(reference.blas);
+    }
+    // Swap before the old references are released at the end of the scope since releasing them
+    // might delete BLASes.
+    std::swap(builtBlases, mBuiltBlases);
+
+    // Snapshot which of the built instances are active to validate later updates.
+    mBuiltInstanceActivity.assign(shape.instanceCount, false);
+    const size_t trackedInstances = std::min<size_t>(shape.instanceCount, mInstanceBlases.size());
+    for (size_t i = 0; i < trackedInstances; ++i) {
+        mBuiltInstanceActivity[i] = mInstanceBlases[i] != nullptr;
+    }
+    mInstanceActivityMismatchCount = 0;
+}
+
+void AccelerationStructureBase::SetInstanceBlas(uint32_t instance,
+                                                AccelerationStructureBase* blas) {
+    if (instance >= mInstanceBlases.size()) {
+        if (blas == nullptr) {
+            // Instances that were never written are inactive.
+            return;
+        }
+        mInstanceBlases.resize(size_t(instance) + 1, nullptr);
+    }
+
+    AccelerationStructureBase* previous = mInstanceBlases[instance];
+    if (previous == blas) {
+        return;
+    }
+
+    // Track how many instances of the last build changed between active and inactive.
+    if (instance < mBuiltInstanceActivity.size()) {
+        const bool builtActive = mBuiltInstanceActivity[instance];
+        const bool wasMismatched = (previous != nullptr) != builtActive;
+        const bool isMismatched = (blas != nullptr) != builtActive;
+        if (wasMismatched && !isMismatched) {
+            DAWN_CHECK(mInstanceActivityMismatchCount > 0);
+            mInstanceActivityMismatchCount--;
+        } else if (!wasMismatched && isMismatched) {
+            mInstanceActivityMismatchCount++;
+        }
+    }
+
+    if (blas != nullptr) {
+        auto [it, inserted] = mReferencedBlases.try_emplace(blas);
+        if (inserted) {
+            it->second.blas = blas;
+        }
+        it->second.instanceCount++;
+    }
+    mInstanceBlases[instance] = blas;
+
+    if (previous != nullptr) {
+        auto it = mReferencedBlases.find(previous);
+        DAWN_CHECK(it != mReferencedBlases.end());
+        DAWN_CHECK(it->second.instanceCount > 0);
+        if (--it->second.instanceCount == 0) {
+            // Move the reference out before erasing the entry since releasing it might delete the
+            // BLAS.
+            Ref<AccelerationStructureBase> releasedBlas = std::move(it->second.blas);
+            mReferencedBlases.erase(it);
+        }
+    }
+}
+
+MaybeError AccelerationStructureBase::WriteInstances(uint32_t firstInstance,
+                                                     Span<AccelerationStructureBase* const> blases,
+                                                     Span<const std::byte> data) {
+    DAWN_CHECK(IsTopLevel());
+    const size_t instanceCount = data.size() / kAccelerationStructureInstanceRecordSize;
+    if (instanceCount == 0) {
+        return {};
+    }
+
+    DAWN_TRY(WriteInstancesImpl(firstInstance, blases, data));
+
+    for (size_t i = 0; i < instanceCount; ++i) {
+        const uint32_t blasIndex = ReadInstanceBlasIndex(data, i);
+        AccelerationStructureBase* blas =
+            blasIndex == kInactiveAccelerationStructureInstance ? nullptr : blases[blasIndex];
+        SetInstanceBlas(firstInstance + static_cast<uint32_t>(i), blas);
+    }
+    return {};
+}
+
+void AccelerationStructureBase::APIDestroy() {
+    Destroy();
+}
+
+wgpu::AccelerationStructureType AccelerationStructureBase::APIGetType() const {
+    return mType;
+}
+
+}  // namespace dawn::native
