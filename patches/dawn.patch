+// static
+ResultOrError<Ref<AccelerationStructure>> AccelerationStructure::Create(
+    Device* device,
+    const UnpackedPtr<AccelerationStructureDescriptor>& descriptor) {
+    Ref<AccelerationStructure> accelerationStructure =
+        AcquireRef(new AccelerationStructure(device, descriptor));
+    DAWN_TRY(accelerationStructure->Initialize());
+    return accelerationStructure;
+}
+
+AccelerationStructure::AccelerationStructure(
+    Device* device,
+    const UnpackedPtr<AccelerationStructureDescriptor>& descriptor)
+    : AccelerationStructureBase(device, descriptor),
+      mVkType(descriptor->type == wgpu::AccelerationStructureType::TopLevel
+                  ? VK_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR
+                  : VK_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL_KHR),
+      mBuildFlags(VulkanBuildFlags(descriptor->flags)) {}
+
+AccelerationStructure::~AccelerationStructure() = default;
+
+MaybeError AccelerationStructure::Initialize() {
+    Device* device = ToBackend(GetDevice());
+    const VkPhysicalDeviceAccelerationStructurePropertiesKHR& properties =
+        device->GetDeviceInfo().accelerationStructureProperties;
+
+    // Query the sizes needed for the acceleration structure and its scratch buffer using the
+    // maximum counts.
+    std::vector<VkAccelerationStructureGeometryKHR> geometries = GetVkGeometries();
+    std::vector<uint32_t> maxPrimitiveCounts;
+    if (IsTopLevel()) {
+        maxPrimitiveCounts.push_back(GetMaxInstanceCount());
+    } else {
+        for (const AccelerationStructureGeometryLayout& layout : GetGeometryLayouts()) {
+            maxPrimitiveCounts.push_back(layout.maxPrimitiveCount);
+        }
+    }
+
+    VkAccelerationStructureBuildGeometryInfoKHR buildInfo;
+    buildInfo.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_GEOMETRY_INFO_KHR;
+    buildInfo.pNext = nullptr;
+    buildInfo.type = mVkType;
+    buildInfo.flags = mBuildFlags;
+    buildInfo.mode = VK_BUILD_ACCELERATION_STRUCTURE_MODE_BUILD_KHR;
+    buildInfo.srcAccelerationStructure = VK_NULL_HANDLE;
+    buildInfo.dstAccelerationStructure = VK_NULL_HANDLE;
+    buildInfo.geometryCount = static_cast<uint32_t>(geometries.size());
+    buildInfo.pGeometries = geometries.data();
+    buildInfo.ppGeometries = nullptr;
+    buildInfo.scratchData.deviceAddress = 0;
+
+    VkAccelerationStructureBuildSizesInfoKHR sizes;
+    sizes.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_SIZES_INFO_KHR;
+    sizes.pNext = nullptr;
+    sizes.accelerationStructureSize = 0;
+    sizes.updateScratchSize = 0;
+    sizes.buildScratchSize = 0;
+    device->fn.GetAccelerationStructureBuildSizesKHR(
+        device->GetVkDevice(), VK_ACCELERATION_STRUCTURE_BUILD_TYPE_DEVICE_KHR, &buildInfo,
+        maxPrimitiveCounts.data(), &sizes);
+
+    // Create the buffer storing the acceleration structure. Its offset in the buffer must be a
+    // multiple of 256.
+    const VkDeviceSize storageSize = std::max(sizes.accelerationStructureSize, VkDeviceSize(256));
+    DAWN_TRY(CreateBufferWithMemory(storageSize,
+                                    VK_BUFFER_USAGE_ACCELERATION_STRUCTURE_STORAGE_BIT_KHR |
+                                        VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT,
+                                    256, &mStorageBuffer, &mStorageAllocation));
+
+    VkAccelerationStructureCreateInfoKHR createInfo;
+    createInfo.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_CREATE_INFO_KHR;
+    createInfo.pNext = nullptr;
+    createInfo.createFlags = 0;
+    createInfo.buffer = mStorageBuffer;
+    createInfo.offset = 0;
+    createInfo.size = storageSize;
+    createInfo.type = mVkType;
+    createInfo.deviceAddress = 0;
+    DAWN_TRY(CheckVkOOMThenSuccess(device->fn.CreateAccelerationStructureKHR(
+                                       device->GetVkDevice(), &createInfo, nullptr, &*mHandle),
+                                   "vkCreateAccelerationStructureKHR"));
+
+    VkAccelerationStructureDeviceAddressInfoKHR addressInfo;
+    addressInfo.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_DEVICE_ADDRESS_INFO_KHR;
+    addressInfo.pNext = nullptr;
+    addressInfo.accelerationStructure = mHandle;
+    mDeviceAddress =
+        device->fn.GetAccelerationStructureDeviceAddressKHR(device->GetVkDevice(), &addressInfo);
+
+    // Create the scratch buffer, large enough for both builds and updates. Over-allocate by the
+    // alignment so that an aligned address can be found in it regardless of the alignment of the
+    // address of the buffer.
+    VkDeviceSize scratchSize = sizes.buildScratchSize;
+    if (mBuildFlags & VK_BUILD_ACCELERATION_STRUCTURE_ALLOW_UPDATE_BIT_KHR) {
+        scratchSize = std::max(scratchSize, sizes.updateScratchSize);
+    }
+    const VkDeviceSize scratchAlignment = std::max(
+        VkDeviceSize(properties.minAccelerationStructureScratchOffsetAlignment), VkDeviceSize(1));
+    DAWN_TRY(CreateBufferWithMemory(
+        std::max(scratchSize, VkDeviceSize(4)) + scratchAlignment,
+        VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT,
+        scratchAlignment, &mScratchBuffer, &mScratchAllocation));
+
+    VkBufferDeviceAddressInfo scratchAddressInfo;
+    scratchAddressInfo.sType = VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO;
+    scratchAddressInfo.pNext = nullptr;
+    scratchAddressInfo.buffer = mScratchBuffer;
+    mScratchAddress =
+        Align(device->fn.GetBufferDeviceAddressKHR(device->GetVkDevice(), &scratchAddressInfo),
+              scratchAlignment);
+
+    if (IsTopLevel()) {
+        BufferDescriptor instanceBufferDesc;
+        instanceBufferDesc.label = "Dawn_AccelerationStructure_InstanceBuffer";
+        instanceBufferDesc.size =
+            uint64_t(GetMaxInstanceCount()) * sizeof(VkAccelerationStructureInstanceKHR);
+        // Storage for the transforms written by CopyBufferToAccelerationStructureTransforms.
+        instanceBufferDesc.usage = wgpu::BufferUsage::AccelerationStructureInput |
+                                   wgpu::BufferUsage::CopyDst | wgpu::BufferUsage::Storage;
+        Ref<BufferBase> instanceBuffer;
+        DAWN_TRY_ASSIGN(instanceBuffer, device->CreateBuffer(&instanceBufferDesc));
+        mInstanceBuffer = ToBackend(std::move(instanceBuffer));
+    } else {
+        DAWN_TRY(device->EnsureAccelerationStructureDummyInputBuffer());
+    }
+
+    SetLabelImpl();
+
+    // Record an empty build so that the acceleration structure is always valid to use, even
+    // before it is built by the application.
+    CommandRecordingContext* recordingContext =
+        ToBackend(device->GetQueue())->GetPendingRecordingContext();
+    if (IsTopLevel()) {
+        // Zero the instances so that they are all inactive until they are written. This must be
+        // done regardless of the lazy clearing of buffers.
+        mInstanceBuffer->TransitionUsageNow(recordingContext, wgpu::BufferUsage::CopyDst);
+        device->fn.CmdFillBuffer(recordingContext->commandBuffer, mInstanceBuffer->GetHandle(), 0,
+                                 VK_WHOLE_SIZE, 0);
+        mInstanceBuffer->SetInitialized(true);
+    }
+    RecordBuildImpl(recordingContext, /*update=*/false, /*instanceCount=*/0, {});
+
+    return {};
+}
+
+MaybeError AccelerationStructure::CreateBufferWithMemory(VkDeviceSize size,
+                                                         VkBufferUsageFlags usage,
+                                                         VkDeviceSize alignment,
+                                                         VkBuffer* buffer,
+                                                         ResourceMemoryAllocation* allocation) {
+    Device* device = ToBackend(GetDevice());
+
+    VkBufferCreateInfo createInfo;
+    createInfo.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+    createInfo.pNext = nullptr;
+    createInfo.flags = 0;
+    createInfo.size = size;
+    createInfo.usage = usage;
+    createInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    createInfo.queueFamilyIndexCount = 0;
+    createInfo.pQueueFamilyIndices = nullptr;
+    DAWN_TRY(CheckVkOOMThenSuccess(
+        device->fn.CreateBuffer(device->GetVkDevice(), &createInfo, nullptr, &**buffer),
+        "vkCreateBuffer"));
+
+    VkMemoryRequirements requirements;
+    device->fn.GetBufferMemoryRequirements(device->GetVkDevice(), *buffer, &requirements);
+    requirements.alignment = std::max(requirements.alignment, alignment);
+
+    DAWN_TRY_ASSIGN(*allocation, device->GetResourceMemoryAllocator()->Allocate(
+                                     requirements, MemoryKind::Linear | MemoryKind::DeviceLocal));
+
+    DAWN_TRY(CheckVkSuccess(
+        device->fn.BindBufferMemory(device->GetVkDevice(), *buffer,
+                                    ToBackend(allocation->GetResourceHeap())->GetMemory(),
+                                    allocation->GetOffset()),
+        "vkBindBufferMemory"));
+    return {};
+}
+
+std::vector<VkAccelerationStructureGeometryKHR> AccelerationStructure::GetVkGeometries() const {
+    std::vector<VkAccelerationStructureGeometryKHR> geometries;
+
+    if (IsTopLevel()) {
+        VkAccelerationStructureGeometryKHR& geometry = geometries.emplace_back();
+        geometry.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR;
+        geometry.pNext = nullptr;
+        geometry.geometryType = VK_GEOMETRY_TYPE_INSTANCES_KHR;
+        geometry.flags = 0;
+
+        VkAccelerationStructureGeometryInstancesDataKHR& instances = geometry.geometry.instances;
+        instances.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_INSTANCES_DATA_KHR;
+        instances.pNext = nullptr;
+        instances.arrayOfPointers = VK_FALSE;
+        instances.data.deviceAddress = 0;
+        return geometries;
+    }
+
+    for (const AccelerationStructureGeometryLayout& layout : GetGeometryLayouts()) {
+        VkAccelerationStructureGeometryKHR& geometry = geometries.emplace_back();
+        geometry.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR;
+        geometry.pNext = nullptr;
+        geometry.flags = VulkanGeometryFlags(layout.flags);
+
+        switch (layout.type) {
+            case wgpu::AccelerationStructureGeometryType::Triangles: {
+                geometry.geometryType = VK_GEOMETRY_TYPE_TRIANGLES_KHR;
+
+                VkAccelerationStructureGeometryTrianglesDataKHR& triangles =
+                    geometry.geometry.triangles;
+                triangles.sType =
+                    VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_TRIANGLES_DATA_KHR;
+                triangles.pNext = nullptr;
+                triangles.vertexFormat = VulkanVertexFormat(layout.vertexFormat);
+                triangles.vertexData.deviceAddress = 0;
+                triangles.vertexStride =
+                    GetAccelerationStructureVertexFormatSize(layout.vertexFormat);
+                triangles.maxVertex = layout.maxVertexCount > 0 ? layout.maxVertexCount - 1 : 0;
+                triangles.indexType = VulkanIndexType(layout.indexFormat);
+                triangles.indexData.deviceAddress = 0;
+                triangles.transformData.deviceAddress = 0;
+                break;
+            }
+
+            case wgpu::AccelerationStructureGeometryType::AABBs: {
+                geometry.geometryType = VK_GEOMETRY_TYPE_AABBS_KHR;
+
+                VkAccelerationStructureGeometryAabbsDataKHR& aabbs = geometry.geometry.aabbs;
+                aabbs.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_AABBS_DATA_KHR;
+                aabbs.pNext = nullptr;
+                aabbs.data.deviceAddress = 0;
+                aabbs.stride = kAccelerationStructureAABBSize;
+                break;
+            }
+
+            default:
+                DAWN_UNREACHABLE();
+        }
+    }
+
+    return geometries;
+}
+
+VkAccelerationStructureKHR AccelerationStructure::GetHandle() const {
+    return mHandle;
+}
+
+VkDeviceAddress AccelerationStructure::GetDeviceAddress() const {
+    return mDeviceAddress;
+}
+
+BufferBase* AccelerationStructure::GetInstanceBuffer() const {
+    // The transforms written by GPU commands are the first 48 bytes of the 64-byte records.
+    static_assert(sizeof(VkAccelerationStructureInstanceKHR) == 64);
+    static_assert(offsetof(VkAccelerationStructureInstanceKHR, transform) == 0);
+    static_assert(sizeof(VkTransformMatrixKHR) == kAccelerationStructureTransformSize);
+    return mInstanceBuffer.Get();
+}
+
+void AccelerationStructure::RecordBuild(
+    CommandRecordingContext* recordingContext,
+    const BuildAccelerationStructureCmd& build,
+    Span<const BuildAccelerationStructureGeometryCmd> geometries) {
+    RecordBuildImpl(recordingContext, build.mode == wgpu::AccelerationStructureBuildMode::Update,
+                    build.instanceCount, geometries);
+}
+
+void AccelerationStructure::RecordBuildImpl(
+    CommandRecordingContext* recordingContext,
+    bool update,
+    uint32_t instanceCount,
+    Span<const BuildAccelerationStructureGeometryCmd> geometries) {
+    // Builds of destroyed acceleration structures are validation errors at submit time, but skip
+    // them in case validation is disabled.
+    if (mHandle == VK_NULL_HANDLE) {
+        return;
+    }
+
+    Device* device = ToBackend(GetDevice());
+
+    // Returns the buffer to use for an input, or a placeholder buffer if there is no input since
+    // Vulkan requires valid addresses even for empty geometries. The input is prepared for being
+    // read by the build.
+    bool hasDestroyedInput = false;
+    auto UseInput = [&](BufferBase* input) -> Buffer* {
+        Buffer* buffer = input != nullptr ? ToBackend(input)
+                                          : device->GetAccelerationStructureDummyInputBuffer();
+        if (buffer->GetHandle() == VK_NULL_HANDLE) {
+            hasDestroyedInput = true;
+            return buffer;
+        }
+        buffer->EnsureDataInitialized(recordingContext);
+        buffer->TransitionUsageNow(recordingContext, wgpu::BufferUsage::AccelerationStructureInput);
+        return buffer;
+    };
+
+    std::vector<VkAccelerationStructureGeometryKHR> vkGeometries = GetVkGeometries();
+    std::vector<VkAccelerationStructureBuildRangeInfoKHR> ranges(vkGeometries.size());
+    for (VkAccelerationStructureBuildRangeInfoKHR& range : ranges) {
+        range.primitiveCount = 0;
+        range.primitiveOffset = 0;
+        range.firstVertex = 0;
+        range.transformOffset = 0;
+    }
+
+    if (IsTopLevel()) {
+        DAWN_ASSERT(geometries.empty());
+        Buffer* instanceBuffer = UseInput(mInstanceBuffer.Get());
+        vkGeometries[0].geometry.instances.data.deviceAddress = instanceBuffer->GetDeviceAddress();
+        ranges[0].primitiveCount = instanceCount;
+    } else {
+        DAWN_ASSERT(instanceCount == 0);
+        DAWN_ASSERT(geometries.empty() || geometries.size() == vkGeometries.size());
+
+        for (size_t i = 0; i < vkGeometries.size(); ++i) {
+            // An empty `geometries` is used for the initial build with no primitives.
+            BuildAccelerationStructureGeometryCmd emptyGeometry;
+            const BuildAccelerationStructureGeometryCmd& geometry =
+                geometries.empty() ? emptyGeometry : geometries[i];
+            ranges[i].primitiveCount = geometry.primitiveCount;
+
+            switch (vkGeometries[i].geometryType) {
+                case VK_GEOMETRY_TYPE_TRIANGLES_KHR: {
+                    VkAccelerationStructureGeometryTrianglesDataKHR& triangles =
+                        vkGeometries[i].geometry.triangles;
+
+                    // Empty inputs use the placeholder buffer so that addresses are always inside
+                    // a buffer, even if the offset is at the end of the buffer.
+                    const bool hasVertices = geometry.vertexCount > 0;
+                    Buffer* vertexBuffer =
+                        UseInput(hasVertices ? geometry.vertexBuffer.Get() : nullptr);
+                    triangles.vertexData.deviceAddress = vertexBuffer->GetDeviceAddress() +
+                                                         (hasVertices ? geometry.vertexOffset : 0);
+                    if (geometry.vertexStride != 0) {
+                        triangles.vertexStride = geometry.vertexStride;
+                    }
+                    triangles.maxVertex = hasVertices ? geometry.vertexCount - 1 : 0;
+
+                    if (triangles.indexType != VK_INDEX_TYPE_NONE_KHR) {
+                        const bool hasIndices = geometry.primitiveCount > 0;
+                        Buffer* indexBuffer =
+                            UseInput(hasIndices ? geometry.indexBuffer.Get() : nullptr);
+                        triangles.indexData.deviceAddress = indexBuffer->GetDeviceAddress() +
+                                                            (hasIndices ? geometry.indexOffset : 0);
+                    }
+                    break;
+                }
+
+                case VK_GEOMETRY_TYPE_AABBS_KHR: {
+                    VkAccelerationStructureGeometryAabbsDataKHR& aabbs =
+                        vkGeometries[i].geometry.aabbs;
+
+                    const bool hasAABBs = geometry.primitiveCount > 0;
+                    Buffer* aabbBuffer = UseInput(hasAABBs ? geometry.aabbBuffer.Get() : nullptr);
+                    aabbs.data.deviceAddress =
+                        aabbBuffer->GetDeviceAddress() + (hasAABBs ? geometry.aabbOffset : 0);
+                    if (hasAABBs) {
+                        aabbs.stride = geometry.aabbStride;
+                    }
+                    break;
+                }
+
+                default:
+                    DAWN_UNREACHABLE();
+            }
+        }
+    }
+
+    // Inputs can only be destroyed if validation is disabled.
+    if (hasDestroyedInput) {
+        return;
+    }
+
+    RecordBuildCommand(recordingContext, update, vkGeometries, ranges);
+}
+
+void AccelerationStructure::RecordBuildCommand(
+    CommandRecordingContext* recordingContext,
+    bool update,
+    const std::vector<VkAccelerationStructureGeometryKHR>& geometries,
+    const std::vector<VkAccelerationStructureBuildRangeInfoKHR>& ranges) {
+    Device* device = ToBackend(GetDevice());
+    VkCommandBuffer commands = recordingContext->commandBuffer;
+
+    // Make all the previous writes (to the build inputs, to the acceleration structures read by
+    // the build and to the scratch buffer) visible to the build, and make the build wait for
+    // previous uses of the acceleration structure (for example ray queries in shaders).
+    VkMemoryBarrier barrier;
+    barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+    barrier.pNext = nullptr;
+    barrier.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_ACCELERATION_STRUCTURE_READ_BIT_KHR |
+                            VK_ACCESS_ACCELERATION_STRUCTURE_WRITE_BIT_KHR |
+                            VK_ACCESS_SHADER_READ_BIT;
+    device->fn.CmdPipelineBarrier(commands, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                                  VK_PIPELINE_STAGE_ACCELERATION_STRUCTURE_BUILD_BIT_KHR, 0, 1,
+                                  &barrier, 0, nullptr, 0, nullptr);
+
+    VkAccelerationStructureBuildGeometryInfoKHR buildInfo;
+    buildInfo.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_GEOMETRY_INFO_KHR;
+    buildInfo.pNext = nullptr;
+    buildInfo.type = mVkType;
+    buildInfo.flags = mBuildFlags;
+    // Updates are done in place.
+    buildInfo.mode = update ? VK_BUILD_ACCELERATION_STRUCTURE_MODE_UPDATE_KHR
+                            : VK_BUILD_ACCELERATION_STRUCTURE_MODE_BUILD_KHR;
+    buildInfo.srcAccelerationStructure = update ? mHandle : VK_NULL_HANDLE;
+    buildInfo.dstAccelerationStructure = mHandle;
+    buildInfo.geometryCount = static_cast<uint32_t>(geometries.size());
+    buildInfo.pGeometries = geometries.data();
+    buildInfo.ppGeometries = nullptr;
+    buildInfo.scratchData.deviceAddress = mScratchAddress;
+
+    const VkAccelerationStructureBuildRangeInfoKHR* rangeInfos = ranges.data();
+    device->fn.CmdBuildAccelerationStructuresKHR(commands, 1, &buildInfo, &rangeInfos);
+
+    // Make the build visible to later builds and shaders, and make later commands (for example
+    // writes to the build inputs) wait for the build.
+    barrier.srcAccessMask = VK_ACCESS_ACCELERATION_STRUCTURE_WRITE_BIT_KHR;
+    barrier.dstAccessMask = VK_ACCESS_ACCELERATION_STRUCTURE_READ_BIT_KHR |
+                            VK_ACCESS_ACCELERATION_STRUCTURE_WRITE_BIT_KHR |
+                            VK_ACCESS_SHADER_READ_BIT;
+    device->fn.CmdPipelineBarrier(commands, VK_PIPELINE_STAGE_ACCELERATION_STRUCTURE_BUILD_BIT_KHR,
+                                  VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &barrier, 0, nullptr, 0,
+                                  nullptr);
+}
+
+MaybeError AccelerationStructure::WriteInstancesImpl(uint32_t firstInstance,
+                                                     Span<AccelerationStructureBase* const> blases,
+                                                     Span<const std::byte> data) {
+    DAWN_ASSERT(IsTopLevel());
+    static_assert(sizeof(VkAccelerationStructureInstanceKHR) ==
+                  kAccelerationStructureInstanceRecordSize);
+
+    // Translate the instance records to VkAccelerationStructureInstanceKHR, replacing the index of
+    // the BLAS with its address.
+    const size_t instanceCount = data.size() / kAccelerationStructureInstanceRecordSize;
+    std::vector<VkAccelerationStructureInstanceKHR> instances(instanceCount);
+    for (size_t i = 0; i < instanceCount; ++i) {
+        AccelerationStructureInstanceRecord record;
+        DAWN_UNSAFE_TODO(memcpy(&record, data.data() + i * kAccelerationStructureInstanceRecordSize,
+                                sizeof(record)));
+
+        VkAccelerationStructureInstanceKHR& instance = instances[i];
+        static_assert(sizeof(instance.transform) == sizeof(record.transform));
+        DAWN_UNSAFE_TODO(memcpy(&instance.transform, record.transform, sizeof(record.transform)));
+        instance.instanceCustomIndex = record.customIndexMask & 0xFF'FFFF;
+        instance.mask = record.customIndexMask >> 24;
+        instance.instanceShaderBindingTableRecordOffset = record.sbtOffsetFlags & 0xFF'FFFF;
+        instance.flags = record.sbtOffsetFlags >> 24;
+        if (record.blasIndex == kInactiveAccelerationStructureInstance) {
+            // An instance referencing the null acceleration structure is inactive.
+            instance.accelerationStructureReference = 0;
+        } else {
+            DAWN_ASSERT(record.blasIndex < blases.size());
+            instance.accelerationStructureReference =
+                ToBackend(blases[record.blasIndex])->GetDeviceAddress();
+        }
+    }
+
+    return static_cast<BufferBase*>(mInstanceBuffer.Get())
+        ->UploadData(uint64_t(firstInstance) * sizeof(VkAccelerationStructureInstanceKHR),
+                     SpanAsBytes(Span<const VkAccelerationStructureInstanceKHR>(instances)));
+}
+
+void AccelerationStructure::DestroyImpl(DestroyReason reason) {
+    // TODO(crbug.com/dawn/831): DestroyImpl is called from two places.
+    // - It may be called if the acceleration structure is explicitly destroyed with APIDestroy.
+    //   This case is NOT thread-safe and needs proper synchronization with other
+    //   simultaneous uses of the acceleration structure.
+    // - It may be called when the last ref to the acceleration structure is dropped and it is
+    //   implicitly destroyed. This case is thread-safe because there are no other threads using
+    //   the acceleration structure since there are no other live refs.
+    AccelerationStructureBase::DestroyImpl(reason);
+
+    Device* device = ToBackend(GetDevice());
+    if (mHandle != VK_NULL_HANDLE) {
+        device->GetFencedDeleter()->DeleteWhenUnused(mHandle);
+        mHandle = VK_NULL_HANDLE;
+    }
+    if (mStorageBuffer != VK_NULL_HANDLE) {
+        device->GetFencedDeleter()->DeleteWhenUnused(mStorageBuffer);
+        mStorageBuffer = VK_NULL_HANDLE;
+    }
+    device->GetResourceMemoryAllocator()->Deallocate(&mStorageAllocation);
+    if (mScratchBuffer != VK_NULL_HANDLE) {
+        device->GetFencedDeleter()->DeleteWhenUnused(mScratchBuffer);
+        mScratchBuffer = VK_NULL_HANDLE;
+    }
+    device->GetResourceMemoryAllocator()->Deallocate(&mScratchAllocation);
+
+    if (mInstanceBuffer != nullptr) {
+        mInstanceBuffer->Destroy();
+        mInstanceBuffer = nullptr;
+    }
+}
+
+void AccelerationStructure::SetLabelImpl() {
+    Device* device = ToBackend(GetDevice());
+    if (mHandle != VK_NULL_HANDLE) {
+        SetDebugName(device, mHandle, "Dawn_AccelerationStructure", GetLabel());
+    }
+    if (mStorageBuffer != VK_NULL_HANDLE) {
+        SetDebugName(device, mStorageBuffer, "Dawn_AccelerationStructure_Storage", GetLabel());
+    }
+    if (mScratchBuffer != VK_NULL_HANDLE) {
+        SetDebugName(device, mScratchBuffer, "Dawn_AccelerationStructure_Scratch", GetLabel());
+    }
+}
+
+}  // namespace dawn::native::vulkan
