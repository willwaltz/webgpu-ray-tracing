+// Updates are validated against the previous build in queue order, not in encoding order.
+TEST_P(AccelerationStructureValidationTests, UpdateValidatedInSubmitOrder) {
+    constexpr auto kUpdate = wgpu::AccelerationStructureBuildMode::Update;
+    wgpu::Buffer vertices = CreateInputBuffer(std::vector<float>(9, 0.0f));
+    wgpu::AccelerationStructure blas =
+        CreateBlas({TriangleLayout(3, 1)}, wgpu::AccelerationStructureFlags::AllowUpdate);
+
+    wgpu::CommandBuffer build = EncodeBuildCommands(blas, {TriangleData(vertices, 3, 1)});
+    wgpu::CommandBuffer update =
+        EncodeBuildCommands(blas, {TriangleData(vertices, 3, 1)}, 0, kUpdate);
+
+    // The update is submitted before the build: it updates the initial empty build.
+    ASSERT_DEVICE_ERROR(queue.Submit(1, &update));
+
+    // Updates can follow builds in the same submit, or in the same command buffer.
+    update = EncodeBuildCommands(blas, {TriangleData(vertices, 3, 1)}, 0, kUpdate);
+    std::array<wgpu::CommandBuffer, 2> buildThenUpdate = {build, update};
+    queue.Submit(2, buildThenUpdate.data());
+
+    {
+        wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+        EncodeBuild(encoder, blas, {TriangleData(nullptr, 0, 0)});
+        EncodeBuild(encoder, blas, {TriangleData(nullptr, 0, 0)}, 0, kUpdate);
+        wgpu::CommandBuffer commands = encoder.Finish();
+        queue.Submit(1, &commands);
+    }
+
+    // The previous command buffer built the BLAS with 0 primitives.
+    update = EncodeBuildCommands(blas, {TriangleData(vertices, 3, 1)}, 0, kUpdate);
+    ASSERT_DEVICE_ERROR(queue.Submit(1, &update));
+
+    // A submit that fails validation doesn't change the last build.
+    {
+        build = EncodeBuildCommands(blas, {TriangleData(vertices, 3, 1)});
+        wgpu::CommandBuffer invalidUpdate =
+            EncodeBuildCommands(blas, {TriangleData(nullptr, 0, 0)}, 0, kUpdate);
+        std::array<wgpu::CommandBuffer, 2> commands = {build, invalidUpdate};
+        ASSERT_DEVICE_ERROR(queue.Submit(2, commands.data()));
+
+        update = EncodeBuildCommands(blas, {TriangleData(nullptr, 0, 0)}, 0, kUpdate);
+        queue.Submit(1, &update);
+    }
+}
