+
+namespace tint::spirv::writer::raise {
+
+namespace {
+
+/// The lifecycle states of a ray query object, as tracked by the companion state variable.
+enum RayQueryState : uint32_t {
+    /// The ray query has not been (successfully) initialized.
+    kUninitialized = 0,
+    /// The ray query has been initialized, but traversal has not yet started.
+    kInitialized = 1,
+    /// The last call to rayQueryProceed() returned true, so there is a current candidate.
+    kCandidate = 2,
+    /// Traversal is complete (rayQueryProceed() returned false, or the query was terminated).
+    kDone = 3,
+};
+
+/// The 'Intersection' operand of the SPIR-V ray query intersection getters.
+enum Intersection : uint32_t {
+    kCandidateIntersection = 0,  // RayQueryCandidateIntersectionKHR
+    kCommittedIntersection = 1,  // RayQueryCommittedIntersectionKHR
+};
+
+/// SPIR-V Ray Query Candidate Intersection Types.
+constexpr uint32_t kCandidateTriangle = 0;  // RayQueryCandidateIntersectionTriangleKHR
+constexpr uint32_t kCandidateAABB = 1;      // RayQueryCandidateIntersectionAABBKHR
+
+/// SPIR-V Ray Query Committed Intersection Types.
+/// Note: These match the values of RayIntersection::kind for committed intersections.
+constexpr uint32_t kCommittedNone = 0;      // RayQueryCommittedIntersectionNoneKHR
+constexpr uint32_t kCommittedTriangle = 1;  // RayQueryCommittedIntersectionTriangleKHR
+
+/// Values of RayIntersection::kind.
+constexpr uint32_t kKindTriangle = 1;
+constexpr uint32_t kKindAABB = 3;
+
+/// SPIR-V ray flags.
+/// The set of supported ray flags, OpaqueKHR (0x1) to SkipAABBsKHR (0x200). Bits outside of this
+/// mask (e.g. ForceOpacityMicromap2StateEXT, which requires an additional capability) are dropped.
+constexpr uint32_t kRayFlagsMask = 0x3ff;
+/// SkipTrianglesKHR | SkipAABBsKHR. At most one of these can be specified.
+/// See VUID-RuntimeSpirv-OpRayQueryInitializeKHR-06889.
+constexpr uint32_t kRayFlagsSkip = 0x100 | 0x200;
+/// SkipTrianglesKHR | CullBackFacingTrianglesKHR | CullFrontFacingTrianglesKHR. At most one of
+/// these can be specified. See VUID-RuntimeSpirv-OpRayQueryInitializeKHR-06890.
+constexpr uint32_t kRayFlagsTriangleCull = 0x100 | 0x10 | 0x20;
+/// OpaqueKHR | NoOpaqueKHR | CullOpaqueKHR | CullNoOpaqueKHR. At most one of these can be
+/// specified. See VUID-RuntimeSpirv-OpRayQueryInitializeKHR-06891.
+constexpr uint32_t kRayFlagsOpacity = 0x1 | 0x2 | 0x40 | 0x80;
+
+/// The exponent bits of a 32-bit float. A float is finite if and only if not all of these bits
+/// are set.
+constexpr uint32_t kF32ExponentMask = 0x7f800000;
+
+/// PIMPL state for the transform.
+struct State {
+    /// The IR module.
+    core::ir::Module& ir;
+
+    /// The IR builder.
+    core::ir::Builder b{ir};
+
+    /// The type manager.
+    core::type::Manager& ty{ir.Types()};
+
+    /// The structure used to hold the ray query state.
+    const core::type::Struct* state_struct = nullptr;
+
+    /// Map from a ray query root pointer (a variable or a function parameter) to the pointer to
+    /// its companion state.
+    Hashmap<core::ir::Value*, core::ir::Value*, 8> state_ptrs{};
+
+    /// Map from a function to the indices of its ray query pointer parameters.
+    Hashmap<core::ir::Function*, Vector<size_t, 2>, 8> ray_query_params{};
+
+    /// Process the module.
+    void Process() {
+        // Find all of the ray query builtin calls, ray query variables and the user calls.
+        Vector<core::ir::Var*, 8> ray_query_vars;
+        Vector<core::ir::CoreBuiltinCall*, 16> builtin_calls;
+        Vector<core::ir::UserCall*, 16> user_calls;
+        for (auto* inst : ir.Instructions()) {
+            if (auto* var = inst->As<core::ir::Var>()) {
+                if (IsRayQueryPointer(var->Result()->Type())) {
+                    ray_query_vars.Push(var);
+                }
+            } else if (auto* call = inst->As<core::ir::CoreBuiltinCall>()) {
+                if (core::IsRayQuery(call->Func())) {
+                    builtin_calls.Push(call);
+                }
+            } else if (auto* user_call = inst->As<core::ir::UserCall>()) {
+                user_calls.Push(user_call);
+            }
+        }
+        if (ray_query_vars.IsEmpty() && builtin_calls.IsEmpty()) {
+            return;
+        }
+
+        // Create the state variable for each ray query variable.
+        for (auto* var : ray_query_vars) {
+            CreateStateVar(var);
+        }
+
+        // Add a state pointer parameter for each ray query pointer parameter.
+        for (auto& func : ir.functions) {
+            AddStateParams(func);
+        }
+
+        // Pass the state pointers to all functions that take ray query pointer parameters.
+        for (auto* call : user_calls) {
+            if (auto indices = ray_query_params.Get(call->Target())) {
+                for (auto idx : *indices) {
+                    call->AppendArg(StateFor(call->Args()[idx]));
+                }
+            }
+        }
+
+        // Replace all of the ray query builtin calls.
+        for (auto* call : builtin_calls) {
+            Replace(call);
+        }
+    }
+
+    /// @returns true if @p type is a pointer to a ray query
+    bool IsRayQueryPointer(const core::type::Type* type) {
+        auto* ptr = type->As<core::type::Pointer>();
+        return ptr && ptr->StoreType()->Is<core::type::RayQuery>();
+    }
+
+    /// @returns the ray query state structure
+    const core::type::Struct* StateStruct() {
+        if (!state_struct) {
+            state_struct = ty.Struct(ir.symbols.New("tint_ray_query_state"),
+                                     {
+                                         {ir.symbols.Register("state"), ty.u32()},
+                                         {ir.symbols.Register("t_max"), ty.f32()},
+                                     });
+        }
+        return state_struct;
+    }
+
+    /// @returns the type of a pointer to the ray query state, in the address space @p space
+    const core::type::Pointer* StatePtrType(core::AddressSpace space) {
+        return ty.ptr(space, StateStruct(), core::Access::kReadWrite);
+    }
+
+    /// Creates the companion state variable for the ray query variable @p var.
+    /// @param var the ray query variable
+    void CreateStateVar(core::ir::Var* var) {
+        auto space = var->Result()->Type()->As<core::type::Pointer>()->AddressSpace();
+        auto* state = b.Var(StatePtrType(space));
+        if (space == core::AddressSpace::kFunction) {
+            // Explicitly initialize the state so that it is reset each time the declaration of the
+            // ray query is executed (e.g. when declared in the body of a loop).
+            state->SetInitializer(b.Zero(StateStruct()));
+        }
+        state->InsertAfter(var);
+        if (auto name = ir.NameOf(var)) {
+            ir.SetName(state, name.Name() + "_state");
+        }
+        state_ptrs.Add(var->Result(), state->Result());
+    }
+
+    /// Adds a state pointer parameter for each ray query pointer parameter of @p func.
+    /// @param func the function
+    void AddStateParams(core::ir::Function* func) {
+        Vector<size_t, 2> indices;
+        Vector<core::ir::FunctionParam*, 2> state_params;
+        auto params = func->Params();
+        for (size_t i = 0; i < params.Length(); i++) {
+            auto* param = params[i];
+            if (!IsRayQueryPointer(param->Type())) {
+                continue;
+            }
+            auto space = param->Type()->As<core::type::Pointer>()->AddressSpace();
+            auto* state = b.FunctionParam(StatePtrType(space));
+            if (auto name = ir.NameOf(param)) {
+                ir.SetName(state, name.Name() + "_state");
+            }
+            state_ptrs.Add(param, state);
+            indices.Push(i);
+            state_params.Push(state);
+        }
+        for (auto* state : state_params) {
+            func->AppendParam(state);
+        }
+        if (!indices.IsEmpty()) {
+            ray_query_params.Add(func, std::move(indices));
+        }
+    }
+
+    /// @returns the pointer to the ray query state for the ray query pointer @p ptr
+    core::ir::Value* StateFor(core::ir::Value* ptr) {
+        while (true) {
+            if (auto state = state_ptrs.Get(ptr)) {
+                return *state;
+            }
+            // Strip away any let instructions to get to the root variable or parameter.
+            auto* res = ptr->As<core::ir::InstructionResult>();
+            auto* let = res ? res->Instruction()->As<core::ir::Let>() : nullptr;
+            if (!let) {
+                TINT_IR_ICE(ir) << "unable to determine the root of a ray query pointer";
+            }
+            ptr = let->Value();
+        }
+    }
+
+    /// @returns a pointer to a member of the ray query state
+    /// @param state the pointer to the ray query state
+    /// @param member_ty the type of the member
+    /// @param index the index of the member
+    core::ir::Value* StateMemberPtr(core::ir::Value* state,
+                                    const core::type::Type* member_ty,
+                                    uint32_t index) {
+        auto space = state->Type()->As<core::type::Pointer>()->AddressSpace();
+        return b.Access(ty.ptr(space, member_ty, core::Access::kReadWrite), state, u32(index));
+    }
+
+    /// Loads the `state` member of the ray query state.
+    /// @param state the pointer to the ray query state
+    /// @returns the loaded value
+    core::ir::Value* LoadState(core::ir::Value* state) {
+        return b.Load(StateMemberPtr(state, ty.u32(), 0))->Result();
+    }
+
+    /// Stores to the `state` member of the ray query state.
+    /// @param state the pointer to the ray query state
+    /// @param value the new state
+    void StoreState(core::ir::Value* state, RayQueryState value) {
+        StoreState(state, b.Constant(u32(value)));
+    }
+
+    /// Stores a value to the `state` member of the ray query state.
+    /// @param state the pointer to the ray query state
+    /// @param value the new state
+    void StoreState(core::ir::Value* state, core::ir::Value* value) {
+        b.Store(StateMemberPtr(state, ty.u32(), 0), value);
+    }
+
+    /// @returns a pointer to the `t_max` member of the ray query state
+    /// @param state the pointer to the ray query state
+    core::ir::Value* TMaxPtr(core::ir::Value* state) { return StateMemberPtr(state, ty.f32(), 1); }
+
+    /// Calls a SPIR-V ray query builtin.
+    /// @param result_ty the result type
+    /// @param fn the builtin function
+    /// @param args the arguments
+    /// @returns the result of the call
+    template <typename... ARGS>
+    core::ir::Value* SpirvCall(const core::type::Type* result_ty,
+                               spirv::BuiltinFn fn,
+                               ARGS&&... args) {
+        return b.Call<spirv::ir::BuiltinCall>(result_ty, fn, std::forward<ARGS>(args)...)->Result();
+    }
+
+    /// Calls a SPIR-V ray query intersection getter.
+    /// @param result_ty the result type
+    /// @param fn the builtin function
+    /// @param rq the ray query pointer
+    /// @param intersection the intersection to query
+    /// @returns the result of the call
+    core::ir::Value* GetIntersection(const core::type::Type* result_ty,
+                                     spirv::BuiltinFn fn,
+                                     core::ir::Value* rq,
+                                     Intersection intersection) {
+        auto* intersection_value = b.Constant(u32(intersection));
+        return SpirvCall(result_ty, fn, rq, intersection_value);
+    }
+
+    /// @returns true if all components of the vec3<f32> @p v are finite (not infinity or NaN)
+    core::ir::Value* AllFinite(core::ir::Value* v) {
+        auto* bits = b.Bitcast(ty.vec3u(), v);
+        auto* mask = b.Splat(ty.vec3u(), u32(kF32ExponentMask));
+        auto* exponent = b.And(bits, mask);
+        auto* finite = b.NotEqual(exponent, mask);
+        return b.Call(ty.bool_(), core::BuiltinFn::kAll, finite);
+    }
+
+    /// @returns true if at most one of the bits of @p flags in @p mask are set
+    core::ir::Value* AtMostOneBitSet(core::ir::Value* flags, uint32_t mask) {
+        auto* bits = b.And(flags, u32(mask));
+        auto* bits_minus_one = b.Subtract(bits, 1_u);
+        auto* lowest_cleared = b.And(bits, bits_minus_one);
+        return b.Equal(lowest_cleared, 0_u);
+    }
+
+    /// Replace a ray query builtin call.
+    /// @param call the builtin call
+    void Replace(core::ir::CoreBuiltinCall* call) {
+        auto* rq = call->Args()[0];
+        auto* state = StateFor(rq);
+        b.InsertBefore(call, [&] {
+            switch (call->Func()) {
+                case core::BuiltinFn::kRayQueryInitialize:
+                    Initialize(call, rq, state);
+                    break;
+                case core::BuiltinFn::kRayQueryProceed:
+                    Proceed(call, rq, state);
+                    break;
+                case core::BuiltinFn::kRayQueryGenerateIntersection:
+                    GenerateIntersection(call, rq, state);
+                    break;
+                case core::BuiltinFn::kRayQueryConfirmIntersection:
+                    ConfirmIntersection(rq, state);
+                    break;
+                case core::BuiltinFn::kRayQueryTerminate:
+                    Terminate(rq, state);
+                    break;
+                case core::BuiltinFn::kRayQueryGetCommittedIntersection:
+                    GetCommittedIntersection(call, rq, state);
+                    break;
+                case core::BuiltinFn::kRayQueryGetCandidateIntersection:
+                    GetCandidateIntersection(call, rq, state);
+                    break;
+                default:
+                    TINT_IR_UNREACHABLE(ir) << "unhandled ray query builtin " << call->Func();
+            }
+        });
+        call->Destroy();
+    }
+
+    /// Replace a call to rayQueryInitialize().
+    void Initialize(core::ir::CoreBuiltinCall* call, core::ir::Value* rq, core::ir::Value* state) {
+        auto* as = call->Args()[1];
+        auto* desc = call->Args()[2];
+        TINT_IR_ASSERT(ir, core::type::IsRayDesc(desc->Type()));
+
+        // Extract the members of the ray description.
+        auto* flags_in = b.Access(ty.u32(), desc, u32(core::type::RayDescMember::kFlags));
+        auto* cull_mask = b.Access(ty.u32(), desc, u32(core::type::RayDescMember::kCullMask));
+        auto* t_min = b.Access(ty.f32(), desc, u32(core::type::RayDescMember::kTMin));
+        auto* t_max = b.Access(ty.f32(), desc, u32(core::type::RayDescMember::kTMax));
+        auto* origin = b.Access(ty.vec3f(), desc, u32(core::type::RayDescMember::kOrigin));
+        auto* dir = b.Access(ty.vec3f(), desc, u32(core::type::RayDescMember::kDir));
+
+        // Drop any flags that require additional capabilities.
+        auto* flags = b.And(flags_in, u32(kRayFlagsMask));
+
+        // Validate the ray flags.
+        auto* skip = b.And(flags, u32(kRayFlagsSkip));
+        auto* skip_ok = b.NotEqual(skip, u32(kRayFlagsSkip));
+        auto* triangle_cull_ok = AtMostOneBitSet(flags, kRayFlagsTriangleCull);
+        auto* opacity_ok = AtMostOneBitSet(flags, kRayFlagsOpacity);
+
+        // Validate the ray.
+        // Note: The comparisons are ordered, so will be false if either t_min or t_max is NaN.
+        auto* t_min_ok = b.GreaterThanEqual(t_min, 0_f);
+        auto* t_range_ok = b.LessThanEqual(t_min, t_max);
+        auto* origin_ok = AllFinite(origin);
+        auto* dir_ok = AllFinite(dir);
+
+        auto* flags_ok = b.And(skip_ok, triangle_cull_ok);
+        flags_ok = b.And(flags_ok, opacity_ok);
+        auto* t_ok = b.And(t_min_ok, t_range_ok);
+        auto* ray_ok = b.And(origin_ok, dir_ok);
+        ray_ok = b.And(ray_ok, t_ok);
+        auto* valid = b.And(flags_ok, ray_ok);
+
+        auto* if_valid = b.If(valid);
+        b.Append(if_valid->True(), [&] {
+            b.Call<spirv::ir::BuiltinCall>(ty.void_(), spirv::BuiltinFn::kRayQueryInitialize, rq,
+                                           as, flags, cull_mask, origin, t_min, dir, t_max);
+            StoreState(state, kInitialized);
+            b.Store(TMaxPtr(state), t_max);
+            b.ExitIf(if_valid);
+        });
+        b.Append(if_valid->False(), [&] {
+            // The ray description is invalid, so the ray query is left uninitialized.
+            StoreState(state, kUninitialized);
+            b.ExitIf(if_valid);
+        });
+    }
+
+    /// Replace a call to rayQueryProceed().
+    void Proceed(core::ir::CoreBuiltinCall* call, core::ir::Value* rq, core::ir::Value* state) {
+        auto* s = LoadState(state);
+        auto* is_initialized = b.Equal(s, u32(kInitialized));
+        auto* is_candidate = b.Equal(s, u32(kCandidate));
+        auto* can_proceed = b.Or(is_initialized, is_candidate);
+
+        auto* if_can_proceed = b.If(can_proceed);
+        if_can_proceed->SetResult(call->DetachResult());
+        b.Append(if_can_proceed->True(), [&] {
+            auto* proceeded = SpirvCall(ty.bool_(), spirv::BuiltinFn::kRayQueryProceed, rq);
+            auto* done = b.Constant(u32(kDone));
+            auto* candidate = b.Constant(u32(kCandidate));
+            auto* new_state =
+                b.Call(ty.u32(), core::BuiltinFn::kSelect, done, candidate, proceeded);
+            StoreState(state, new_state);
+            b.ExitIf(if_can_proceed, proceeded);
+        });
+        b.Append(if_can_proceed->False(), [&] {  //
+            b.ExitIf(if_can_proceed, false);
+        });
+    }
+
+    /// Emits code that executes @p cb if the ray query has a current candidate intersection of
+    /// the type @p candidate_type.
+    template <typename CALLBACK>
+    void IfCandidateOfType(core::ir::Value* rq,
+                           core::ir::Value* state,
+                           uint32_t candidate_type,
+                           CALLBACK&& cb) {
+        auto* s = LoadState(state);
+        auto* is_candidate = b.Equal(s, u32(kCandidate));
+        auto* if_candidate = b.If(is_candidate);
+        b.Append(if_candidate->True(), [&] {
+            auto* type = GetIntersection(ty.u32(), spirv::BuiltinFn::kRayQueryGetIntersectionType,
+                                         rq, kCandidateIntersection);
+            auto* is_type = b.Equal(type, u32(candidate_type));
+            auto* if_type = b.If(is_type);
+            b.Append(if_type->True(), [&] {
+                cb();
+                b.ExitIf(if_type);
+            });
+            b.ExitIf(if_candidate);
+        });
+    }
+
+    /// Replace a call to rayQueryGenerateIntersection().
+    void GenerateIntersection(core::ir::CoreBuiltinCall* call,
+                              core::ir::Value* rq,
+                              core::ir::Value* state) {
+        auto* hit_t = call->Args()[1];
+        IfCandidateOfType(rq, state, kCandidateAABB, [&] {
+            // `hit_t` must lie within [t_min, t_max], where t_max is the T of the current committed
+            // intersection, or the ray's t_max if there is no committed intersection.
+            // See VUID-RuntimeSpirv-OpRayQueryGenerateIntersectionKHR-06353.
+            auto* t_min = SpirvCall(ty.f32(), spirv::BuiltinFn::kRayQueryGetRayTMin, rq);
+            auto* committed_type =
+                GetIntersection(ty.u32(), spirv::BuiltinFn::kRayQueryGetIntersectionType, rq,
+                                kCommittedIntersection);
+            auto* has_committed = b.NotEqual(committed_type, u32(kCommittedNone));
+            auto* if_has_committed = b.If(has_committed);
+            auto* t_max = b.InstructionResult(ty.f32());
+            if_has_committed->SetResult(t_max);
+            b.Append(if_has_committed->True(), [&] {
+                auto* committed_t =
+                    GetIntersection(ty.f32(), spirv::BuiltinFn::kRayQueryGetIntersectionT, rq,
+                                    kCommittedIntersection);
+                b.ExitIf(if_has_committed, committed_t);
+            });
+            b.Append(if_has_committed->False(), [&] {
+                auto* ray_t_max = b.Load(TMaxPtr(state));
+                b.ExitIf(if_has_committed, ray_t_max);
+            });
+
+            // Note: The comparisons are ordered, so will be false if hit_t is NaN.
+            auto* ge_t_min = b.GreaterThanEqual(hit_t, t_min);
+            auto* le_t_max = b.LessThanEqual(hit_t, t_max);
+            auto* in_range = b.And(ge_t_min, le_t_max);
+            auto* if_in_range = b.If(in_range);
+            b.Append(if_in_range->True(), [&] {
+                b.Call<spirv::ir::BuiltinCall>(
+                    ty.void_(), spirv::BuiltinFn::kRayQueryGenerateIntersection, rq, hit_t);
+                b.ExitIf(if_in_range);
+            });
+        });
+    }
+
+    /// Replace a call to rayQueryConfirmIntersection().
+    void ConfirmIntersection(core::ir::Value* rq, core::ir::Value* state) {
+        IfCandidateOfType(rq, state, kCandidateTriangle, [&] {
+            b.Call<spirv::ir::BuiltinCall>(ty.void_(),
+                                           spirv::BuiltinFn::kRayQueryConfirmIntersection, rq);
+        });
+    }
+
+    /// Replace a call to rayQueryTerminate().
+    void Terminate(core::ir::Value* rq, core::ir::Value* state) {
+        auto* s = LoadState(state);
+
+        // OpRayQueryTerminateKHR is only called when there is a current candidate, as behavior is
+        // undefined if a prior call to OpRayQueryProceedKHR returned false.
+        // If traversal has not yet started, the ray query is simply marked as done, which has the
+        // same observable behavior.
+        auto* is_candidate = b.Equal(s, u32(kCandidate));
+        auto* if_candidate = b.If(is_candidate);
+        b.Append(if_candidate->True(), [&] {
+            b.Call<spirv::ir::BuiltinCall>(ty.void_(), spirv::BuiltinFn::kRayQueryTerminate, rq);
+            b.ExitIf(if_candidate);
+        });
+
+        auto* is_initialized = b.Equal(s, u32(kInitialized));
+        auto* is_active = b.Or(is_initialized, is_candidate);
+        auto* if_active = b.If(is_active);
+        b.Append(if_active->True(), [&] {
+            StoreState(state, kDone);
+            b.ExitIf(if_active);
+        });
+    }
+
+    /// The common members of a RayIntersection.
+    struct IntersectionMembers {
+        core::ir::Value* instance_custom_data = nullptr;
+        core::ir::Value* instance_index = nullptr;
+        core::ir::Value* sbt_record_offset = nullptr;
+        core::ir::Value* geometry_index = nullptr;
+        core::ir::Value* primitive_index = nullptr;
+        core::ir::Value* object_to_world = nullptr;
+        core::ir::Value* world_to_object = nullptr;
+    };
+
+    /// Queries the intersection members that are common to all intersection types.
+    IntersectionMembers GetCommonMembers(core::ir::Value* rq, Intersection intersection) {
+        IntersectionMembers m;
+        m.instance_custom_data =
+            GetIntersection(ty.u32(), spirv::BuiltinFn::kRayQueryGetIntersectionInstanceCustomIndex,
+                            rq, intersection);
+        m.instance_index = GetIntersection(
+            ty.u32(), spirv::BuiltinFn::kRayQueryGetIntersectionInstanceId, rq, intersection);
+        m.sbt_record_offset = GetIntersection(
+            ty.u32(),
+            spirv::BuiltinFn::kRayQueryGetIntersectionInstanceShaderBindingTableRecordOffset, rq,
+            intersection);
+        m.geometry_index = GetIntersection(
+            ty.u32(), spirv::BuiltinFn::kRayQueryGetIntersectionGeometryIndex, rq, intersection);
+        m.primitive_index = GetIntersection(
+            ty.u32(), spirv::BuiltinFn::kRayQueryGetIntersectionPrimitiveIndex, rq, intersection);
+        auto* mat4x3f = ty.mat4x3(ty.f32());
+        m.object_to_world = GetIntersection(
+            mat4x3f, spirv::BuiltinFn::kRayQueryGetIntersectionObjectToWorld, rq, intersection);
+        m.world_to_object = GetIntersection(
+            mat4x3f, spirv::BuiltinFn::kRayQueryGetIntersectionWorldToObject, rq, intersection);
+        return m;
+    }
+
+    /// Builds a RayIntersection structure.
+    core::ir::Value* BuildIntersection(const core::type::Type* ray_intersection,
+                                       core::ir::Value* kind,
+                                       core::ir::Value* t,
+                                       const IntersectionMembers& m,
+                                       core::ir::Value* barycentrics,
+                                       core::ir::Value* front_face) {
+        // Note: The order must match the members of RayIntersection.
+        static_assert(static_cast<uint32_t>(core::type::RayIntersectionMember::kKind) == 0);
+        static_assert(static_cast<uint32_t>(core::type::RayIntersectionMember::kWorldToObject) ==
+                      10);
+        return b.Construct(ray_intersection, kind, t, m.instance_custom_data, m.instance_index,
+                           m.sbt_record_offset, m.geometry_index, m.primitive_index, barycentrics,
+                           front_face, m.object_to_world, m.world_to_object);
+    }
+
+    /// Replace a call to rayQueryGetCommittedIntersection().
+    void GetCommittedIntersection(core::ir::CoreBuiltinCall* call,
+                                  core::ir::Value* rq,
+                                  core::ir::Value* state) {
+        auto* ray_intersection = call->Result()->Type();
+        TINT_IR_ASSERT(ir, core::type::IsRayIntersection(ray_intersection));
+
+        // The committed intersection can be queried at any point after the ray query has been
+        // initialized.
+        auto* s = LoadState(state);
+        auto* is_initialized = b.NotEqual(s, u32(kUninitialized));
+        auto* if_initialized = b.If(is_initialized);
+        if_initialized->SetResult(call->DetachResult());
+        b.Append(if_initialized->True(), [&] {
+            // The committed intersection types map directly to RayIntersection::kind.
+            auto* kind = GetIntersection(ty.u32(), spirv::BuiltinFn::kRayQueryGetIntersectionType,
+                                         rq, kCommittedIntersection);
+            auto* has_committed = b.NotEqual(kind, u32(kCommittedNone));
+            auto* if_has_committed = b.If(has_committed);
+            auto* result = b.InstructionResult(ray_intersection);
+            if_has_committed->SetResult(result);
+            b.Append(if_has_committed->True(), [&] {
+                auto* t = GetIntersection(ty.f32(), spirv::BuiltinFn::kRayQueryGetIntersectionT, rq,
+                                          kCommittedIntersection);
+                auto members = GetCommonMembers(rq, kCommittedIntersection);
+
+                // The barycentrics and front face are only available for triangles.
+                auto* is_triangle = b.Equal(kind, u32(kCommittedTriangle));
+                auto* if_triangle = b.If(is_triangle);
+                auto* barycentrics = b.InstructionResult(ty.vec2f());
+                auto* front_face = b.InstructionResult(ty.bool_());
+                if_triangle->SetResults(barycentrics, front_face);
+                b.Append(if_triangle->True(), [&] {
+                    auto* bary = GetIntersection(
+                        ty.vec2f(), spirv::BuiltinFn::kRayQueryGetIntersectionBarycentrics, rq,
+                        kCommittedIntersection);
+                    auto* ff = GetIntersection(ty.bool_(),
+                                               spirv::BuiltinFn::kRayQueryGetIntersectionFrontFace,
+                                               rq, kCommittedIntersection);
+                    b.ExitIf(if_triangle, bary, ff);
+                });
+                b.Append(if_triangle->False(), [&] {
+                    auto* zero_bary = b.Zero(ty.vec2f());
+                    auto* zero_ff = b.Constant(false);
+                    b.ExitIf(if_triangle, zero_bary, zero_ff);
+                });
+
+                auto* intersection =
+                    BuildIntersection(ray_intersection, kind, t, members, barycentrics, front_face);
+                b.ExitIf(if_has_committed, intersection);
+            });
+            b.Append(if_has_committed->False(), [&] {
+                auto* none = b.Zero(ray_intersection);
+                b.ExitIf(if_has_committed, none);
+            });
+            b.ExitIf(if_initialized, result);
+        });
+        b.Append(if_initialized->False(), [&] {
+            auto* none = b.Zero(ray_intersection);
+            b.ExitIf(if_initialized, none);
+        });
+    }
+
+    /// Replace a call to rayQueryGetCandidateIntersection().
+    void GetCandidateIntersection(core::ir::CoreBuiltinCall* call,
+                                  core::ir::Value* rq,
+                                  core::ir::Value* state) {
+        auto* ray_intersection = call->Result()->Type();
+        TINT_IR_ASSERT(ir, core::type::IsRayIntersection(ray_intersection));
+
+        // The candidate intersection can only be queried when the last call to proceed returned
+        // true.
+        auto* s = LoadState(state);
+        auto* is_candidate = b.Equal(s, u32(kCandidate));
+        auto* if_candidate = b.If(is_candidate);
+        if_candidate->SetResult(call->DetachResult());
+        b.Append(if_candidate->True(), [&] {
+            auto* candidate_type =
+                GetIntersection(ty.u32(), spirv::BuiltinFn::kRayQueryGetIntersectionType, rq,
+                                kCandidateIntersection);
+            auto* is_triangle = b.Equal(candidate_type, u32(kCandidateTriangle));
+            auto* kind_triangle = b.Constant(u32(kKindTriangle));
+            auto* kind_aabb = b.Constant(u32(kKindAABB));
+            auto* kind =
+                b.Call(ty.u32(), core::BuiltinFn::kSelect, kind_aabb, kind_triangle, is_triangle);
+            auto members = GetCommonMembers(rq, kCandidateIntersection);
+
+            // The T, barycentrics and front face are only available for triangles.
+            auto* if_triangle = b.If(is_triangle);
+            auto* t = b.InstructionResult(ty.f32());
+            auto* barycentrics = b.InstructionResult(ty.vec2f());
+            auto* front_face = b.InstructionResult(ty.bool_());
+            if_triangle->SetResults(t, barycentrics, front_face);
+            b.Append(if_triangle->True(), [&] {
+                auto* tri_t = GetIntersection(ty.f32(), spirv::BuiltinFn::kRayQueryGetIntersectionT,
+                                              rq, kCandidateIntersection);
+                auto* bary = GetIntersection(ty.vec2f(),
+                                             spirv::BuiltinFn::kRayQueryGetIntersectionBarycentrics,
+                                             rq, kCandidateIntersection);
+                auto* ff =
+                    GetIntersection(ty.bool_(), spirv::BuiltinFn::kRayQueryGetIntersectionFrontFace,
+                                    rq, kCandidateIntersection);
+                b.ExitIf(if_triangle, tri_t, bary, ff);
+            });
+            b.Append(if_triangle->False(), [&] {
+                auto* zero_t = b.Constant(0_f);
+                auto* zero_bary = b.Zero(ty.vec2f());
+                auto* zero_ff = b.Constant(false);
+                b.ExitIf(if_triangle, zero_t, zero_bary, zero_ff);
+            });
+
+            auto* intersection =
+                BuildIntersection(ray_intersection, kind, t, members, barycentrics, front_face);
+            b.ExitIf(if_candidate, intersection);
+        });
+        b.Append(if_candidate->False(), [&] {
+            auto* none = b.Zero(ray_intersection);
+            b.ExitIf(if_candidate, none);
+        });
+    }
+};
+
+}  // namespace
+
+Result<SuccessType> RayQuery(core::ir::Module& ir) {
+    core::ir::AssertValid(ir, "before spirv.RayQuery");
+
+    State{ir}.Process();
+
+    return Success;
+}
+
+}  // namespace tint::spirv::writer::raise
