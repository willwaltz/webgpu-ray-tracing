+WireResult Server::DoQueueWriteAccelerationStructureInstances(
+    Known<WGPUQueue> queue,
+    WGPUAccelerationStructure destination,
+    uint32_t firstInstance,
+    Span<const WGPUAccelerationStructure> blases,
+    Span<const volatile std::byte> data) {
+    // Unlike WriteBuffer's data, the instance records are validated (their indices in `blases`)
+    // before they are used, so they are copied out of the command memory that the client can
+    // still write to, to avoid TOCTOU issues.
+    auto records = HeapArray<std::byte>(data.size(), std::nothrow);
+    if (!records) {
+        return WireResult::FatalError;
+    }
+    std::ranges::copy(data, records.begin());
+
+    mProcs->queueWriteAccelerationStructureInstances(queue->handle, destination, firstInstance,
+                                                     blases.size(), blases.data(), records.data(),
+                                                     records.size());
+    return WireResult::Success;
+}
