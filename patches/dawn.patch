+#ifndef SRC_TINT_LANG_SPIRV_WRITER_RAISE_RAY_QUERY_H_
+#define SRC_TINT_LANG_SPIRV_WRITER_RAISE_RAY_QUERY_H_
+
+#include "src/tint/utils/result.h"
+
+// Forward declarations.
+namespace tint::core::ir {
+class Module;
+}  // namespace tint::core::ir
+
+namespace tint::spirv::writer::raise {
+
+/// RayQuery is a transform that replaces the core ray query builtin function calls (from the
+/// `chromium_experimental_ray_query` extension) with calls to the SPIR-V ray query builtins
+/// (SPV_KHR_ray_query).
+///
+/// The SPIR-V ray query instructions have a number of pre-conditions that, if not satisfied,
+/// result in undefined behavior. To ensure that no undefined behavior can be reached from WGSL,
+/// each ray query variable is paired with a state variable which tracks the lifecycle of the ray
+/// query object, and each ray query operation is guarded so that it is only executed when it is
+/// valid to do so:
+///  * Invalid ray descriptions (non-finite origin / direction, negative or NaN t_min / t_max,
+///    t_min > t_max, or a conflicting combination of ray flags) leave the ray query uninitialized.
+///  * Proceed returns false unless the ray query has been initialized and traversal is incomplete.
+///  * GenerateIntersection is a no-op unless the current candidate is an AABB and hit_t lies
+///    within [t_min, t_max], where t_max is the T of the current committed intersection.
+///  * ConfirmIntersection is a no-op unless the current candidate is a triangle.
+///  * Terminate is a no-op unless traversal is incomplete.
+///  * The intersection getters only query the properties that are well-defined for the current
+///    state of the ray query, and return zero values for all other members.
+///
+/// Must be run after DirectVariableAccess, as pointers to ray queries must be either a variable or
+/// a function parameter.
+///
+/// @param module the module to transform
+/// @returns success or failure
+Result<SuccessType> RayQuery(core::ir::Module& module);
+
+}  // namespace tint::spirv::writer::raise
+
+#endif  // SRC_TINT_LANG_SPIRV_WRITER_RAISE_RAY_QUERY_H_
