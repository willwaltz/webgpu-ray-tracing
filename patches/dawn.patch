+    wgpu::AccelerationStructure blas = CreateBlas({TriangleLayout(3, 1)});
+    EXPECT_EQ(blas.GetType(), wgpu::AccelerationStructureType::BottomLevel);
+    CreateBlas({TriangleLayout(4, 2, wgpu::IndexFormat::Uint16)});
+    CreateBlas({TriangleLayout(4, 2, wgpu::IndexFormat::Uint32)});
+
+    // AABBs.
+    blas = CreateBlas({AABBLayout(2)});
+    EXPECT_EQ(blas.GetType(), wgpu::AccelerationStructureType::BottomLevel);
+
+    // Multiple geometries of the same type.
+    CreateBlas({TriangleLayout(3, 1), TriangleLayout(6, 2, wgpu::IndexFormat::Uint16)});
+    CreateBlas({AABBLayout(1), AABBLayout(3)});
+
+    // Geometries without primitives.
+    CreateBlas({TriangleLayout(0, 0)});
+    CreateBlas({AABBLayout(0)});
+
+    // All the geometry flags.
+    CreateBlas({TriangleLayout(3, 1, wgpu::IndexFormat::Undefined, wgpu::VertexFormat::Float32x3,
+                               wgpu::AccelerationStructureGeometryFlags::Opaque |
+                                   wgpu::AccelerationStructureGeometryFlags::NoDuplicateAnyHit)});
+
+    // Various flags.
+    CreateBlas({TriangleLayout(3, 1)}, wgpu::AccelerationStructureFlags::None);
+    CreateBlas({TriangleLayout(3, 1)}, wgpu::AccelerationStructureFlags::AllowUpdate |
+                                           wgpu::AccelerationStructureFlags::PreferFastBuild |
+                                           wgpu::AccelerationStructureFlags::LowMemory);
+    CreateBlas({TriangleLayout(3, 1)}, wgpu::AccelerationStructureFlags::AllowUpdate |
+                                           wgpu::AccelerationStructureFlags::PreferFastTrace);
+
+    wgpu::AccelerationStructure tlas = CreateTlas(4);
+    EXPECT_EQ(tlas.GetType(), wgpu::AccelerationStructureType::TopLevel);
+    CreateTlas(1, wgpu::AccelerationStructureFlags::AllowUpdate |
+                      wgpu::AccelerationStructureFlags::PreferFastBuild);
