+TEST_F(SpirvWriterRayQueryTest, TypesCapabilitiesAndExtension) {
+    ComputeWithRayQuery([&](core::ir::Var*) {});
+
+    auto result = Generate();
+    ASSERT_EQ(result, Success) << result.Failure() << output_;
+    EXPECT_INST("OpCapability RayQueryKHR");
+    EXPECT_INST("OpCapability RayTraversalPrimitiveCullingKHR");
+    EXPECT_INST(R"(OpExtension "SPV_KHR_ray_query")");
+    EXPECT_INST("OpDecorate %tlas DescriptorSet 0");
+    EXPECT_INST("OpDecorate %tlas Binding 1");
+    EXPECT_INST("%3 = OpTypeAccelerationStructureKHR");
+    EXPECT_INST("%_ptr_UniformConstant_3 = OpTypePointer UniformConstant %3");
+    EXPECT_INST("%tlas = OpVariable %_ptr_UniformConstant_3 UniformConstant");
+    EXPECT_INST("OpTypeRayQueryKHR");
+    // The ray query variable must not have an initializer.
+    EXPECT_THAT(output_,
+                testing::ContainsRegex("%rq = OpVariable %_ptr_Function_[0-9]+ Function\n"))
+        << output_;
+    // The ray query must never be loaded or stored.
+    EXPECT_THAT(output_, testing::Not(testing::ContainsRegex("OpLoad %[0-9]+ %rq[ \n]")));
+    EXPECT_THAT(output_, testing::Not(testing::HasSubstr("OpStore %rq ")));
+}
