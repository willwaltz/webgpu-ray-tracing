+
+namespace tint::core::type {
+namespace {
+
+using AccelerationStructureTest = TestHelper;
+
+TEST_F(AccelerationStructureTest, Creation) {
+    Manager ty;
+    auto* a = ty.acceleration_structure();
+    auto* b = ty.acceleration_structure();
+    EXPECT_EQ(a, b);
+}
+
+TEST_F(AccelerationStructureTest, Hash) {
+    Manager ty;
+    auto* a = ty.acceleration_structure();
+    auto* b = ty.acceleration_structure();
+    EXPECT_EQ(a->unique_hash, b->unique_hash);
+}
+
+TEST_F(AccelerationStructureTest, Equals) {
+    Manager ty;
+    auto* a = ty.acceleration_structure();
+    auto* b = ty.acceleration_structure();
+    EXPECT_TRUE(a->Equals(*b));
+    EXPECT_FALSE(a->Equals(Void{}));
+    EXPECT_FALSE(a->Equals(RayQuery{}));
+}
+
+TEST_F(AccelerationStructureTest, FriendlyName) {
+    AccelerationStructure a;
+    EXPECT_EQ(a.FriendlyName(), "acceleration_structure");
+}
+
+TEST_F(AccelerationStructureTest, Flags) {
+    Manager ty;
+    auto* a = ty.acceleration_structure();
+    EXPECT_TRUE(a->IsHandle());
+    EXPECT_FALSE(a->IsConstructible());
+    EXPECT_FALSE(a->HasCreationFixedFootprint());
+    EXPECT_FALSE(a->HasFixedFootprint());
+}
+
+TEST_F(AccelerationStructureTest, Clone) {
+    Manager ty;
+    auto* a = ty.acceleration_structure();
+
+    core::type::Manager mgr;
+    core::type::CloneContext ctx{{nullptr}, {nullptr, &mgr}};
+
+    auto* b = a->Clone(ctx);
+    ASSERT_TRUE(b->Is<AccelerationStructure>());
+    EXPECT_EQ(b, mgr.acceleration_structure());
+}
+
+}  // namespace
