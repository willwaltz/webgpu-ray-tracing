+  %rq_state:ptr<private, tint_ray_query_state, read_write> = var undef
+}
+
+%foo = func():void {
+  $B2: {
+    %4:ptr<private, u32, read_write> = access %rq_state, 0u
+    %5:u32 = load %4
+    %6:bool = eq %5, 2u
+    if %6 [t: $B3] {  # if_1
+      $B3: {  # true
+        %7:void = spirv.ray_query_terminate %rq
+        exit_if  # if_1
+      }
+    }
+    %8:bool = eq %5, 1u
+    %9:bool = or %8, %6
+    if %9 [t: $B4] {  # if_2
+      $B4: {  # true
+        %10:ptr<private, u32, read_write> = access %rq_state, 0u
+        store %10, 3u
+        exit_if  # if_2
+      }
+    }
+    ret
+  }
+}
+)";
+
+    Run(RayQuery);
+
+    EXPECT_EQ(expect, str());
+}
