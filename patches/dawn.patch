+// Builds with no primitives and no instances.
+TEST_P(AccelerationStructureBuildTests, EmptyBuilds) {
+    wgpu::AccelerationStructure blas =
+        CreateBlas({TriangleLayout(3, 1, wgpu::IndexFormat::Uint32), TriangleLayout(3, 1)});
+    Build(blas, {TriangleData(nullptr, 0, 0), TriangleData(nullptr, 0, 0)});
+    wgpu::AccelerationStructure aabbBlas = CreateBlas({AABBLayout(4)});
