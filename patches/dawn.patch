+MaybeError ValidateInputBuffer(DeviceBase* device, BufferBase* buffer) {
+    DAWN_TRY(device->ValidateObject(buffer));
+    DAWN_TRY(ValidateCanUseAs(buffer, wgpu::BufferUsage::AccelerationStructureInput));
+    return {};
+}
+
+MaybeError ValidateInputRange(BufferBase* buffer,
+                              uint64_t offset,
+                              uint64_t requiredSize,
+                              const char* name) {
+    uint64_t bufferSize = buffer->GetSize();
+    DAWN_INVALID_IF(offset > bufferSize || requiredSize > bufferSize - offset,
+                    "The %s data (offset: %u, size: %u) doesn't fit in %s (size: %u).", name,
+                    offset, requiredSize, buffer, bufferSize);
+    return {};
+}
+
+MaybeError ValidateGeometryData(DeviceBase* device,
+                                const AccelerationStructureGeometryLayout& layout,
+                                const AccelerationStructureGeometryData& data) {
+    DAWN_INVALID_IF(data.primitiveCount > layout.maxPrimitiveCount,
+                    "primitiveCount (%u) is larger than the maxPrimitiveCount (%u) of the "
+                    "geometry.",
+                    data.primitiveCount, layout.maxPrimitiveCount);
+
+    switch (layout.type) {
+        case wgpu::AccelerationStructureGeometryType::Triangles: {
+            DAWN_INVALID_IF(data.AABBBuffer != nullptr,
+                            "AABBBuffer (%s) is set for a triangle geometry.", data.AABBBuffer);
+            DAWN_INVALID_IF(data.vertexCount > layout.maxVertexCount,
+                            "vertexCount (%u) is larger than the maxVertexCount (%u) of the "
+                            "geometry.",
+                            data.vertexCount, layout.maxVertexCount);
+
+            const uint32_t formatSize =
+                GetAccelerationStructureVertexFormatSize(layout.vertexFormat);
+            const uint32_t componentSize =
+                GetAccelerationStructureVertexFormatComponentSize(layout.vertexFormat);
+            const uint64_t vertexStride = data.vertexStride != 0 ? data.vertexStride : formatSize;
+            DAWN_INVALID_IF(vertexStride % componentSize != 0,
+                            "vertexStride (%u) is not a multiple of %u (the size of a component of "
+                            "%s).",
+                            vertexStride, componentSize, layout.vertexFormat);
+            DAWN_INVALID_IF(vertexStride > std::numeric_limits<uint32_t>::max(),
+                            "vertexStride (%u) is larger than %u.", vertexStride,
+                            std::numeric_limits<uint32_t>::max());
+            DAWN_INVALID_IF(data.vertexOffset % componentSize != 0,
+                            "vertexOffset (%u) is not a multiple of %u (the size of a component of "
+                            "%s).",
+                            data.vertexOffset, componentSize, layout.vertexFormat);
+
+            const bool indexed = layout.indexFormat != wgpu::IndexFormat::Undefined;
+            if (indexed) {
+                DAWN_INVALID_IF(data.primitiveCount > 0 && data.indexBuffer == nullptr,
+                                "indexBuffer is not set for an indexed geometry with %u "
+                                "triangles.",
+                                data.primitiveCount);
+                DAWN_INVALID_IF(data.primitiveCount > 0 && data.vertexCount == 0,
+                                "vertexCount is 0 for an indexed geometry with %u triangles.",
+                                data.primitiveCount);
+            } else {
+                DAWN_INVALID_IF(data.indexBuffer != nullptr,
+                                "indexBuffer (%s) is set for a geometry without an index format.",
+                                data.indexBuffer);
+                DAWN_INVALID_IF(uint64_t(data.primitiveCount) * 3 > data.vertexCount,
+                                "vertexCount (%u) is smaller than the %u vertices needed for %u "
+                                "non-indexed triangles.",
+                                data.vertexCount, uint64_t(data.primitiveCount) * 3,
+                                data.primitiveCount);
+            }
+
+            DAWN_INVALID_IF(data.vertexCount > 0 && data.vertexBuffer == nullptr,
+                            "vertexBuffer is not set for a geometry with %u vertices.",
+                            data.vertexCount);
+            if (data.vertexBuffer != nullptr) {
+                DAWN_TRY_CONTEXT(ValidateInputBuffer(device, data.vertexBuffer),
+                                 "validating vertexBuffer");
+                const uint64_t requiredSize =
+                    data.vertexCount == 0
+                        ? 0
+                        : (uint64_t(data.vertexCount) - 1) * vertexStride + formatSize;
+                DAWN_TRY(ValidateInputRange(data.vertexBuffer, data.vertexOffset, requiredSize,
+                                            "vertex"));
+            }
+
+            if (data.indexBuffer != nullptr) {
+                DAWN_TRY_CONTEXT(ValidateInputBuffer(device, data.indexBuffer),
+                                 "validating indexBuffer");
+                const uint32_t indexSize =
+                    GetAccelerationStructureIndexFormatSize(layout.indexFormat);
+                DAWN_INVALID_IF(data.indexOffset % indexSize != 0,
+                                "indexOffset (%u) is not a multiple of %u (the size of %s).",
+                                data.indexOffset, indexSize, layout.indexFormat);
+                const uint64_t requiredSize = uint64_t(data.primitiveCount) * 3 * indexSize;
+                DAWN_TRY(
+                    ValidateInputRange(data.indexBuffer, data.indexOffset, requiredSize, "index"));
+            }
+            break;
+        }
+
+        case wgpu::AccelerationStructureGeometryType::AABBs: {
+            DAWN_INVALID_IF(data.vertexBuffer != nullptr || data.indexBuffer != nullptr,
+                            "vertexBuffer (%s) or indexBuffer (%s) is set for an AABB geometry.",
+                            data.vertexBuffer, data.indexBuffer);
+            DAWN_INVALID_IF(data.vertexCount != 0,
+                            "vertexCount (%u) is not 0 for an AABB geometry.", data.vertexCount);
+            DAWN_INVALID_IF(data.AABBStride % 8 != 0, "AABBStride (%u) is not a multiple of 8.",
+                            data.AABBStride);
+            DAWN_INVALID_IF(data.AABBStride > std::numeric_limits<uint32_t>::max(),
+                            "AABBStride (%u) is larger than %u.", data.AABBStride,
+                            std::numeric_limits<uint32_t>::max());
+            DAWN_INVALID_IF(data.AABBOffset % 8 != 0, "AABBOffset (%u) is not a multiple of 8.",
+                            data.AABBOffset);
+            DAWN_INVALID_IF(data.primitiveCount > 0 && data.AABBBuffer == nullptr,
+                            "AABBBuffer is not set for a geometry with %u AABBs.",
+                            data.primitiveCount);
+            if (data.AABBBuffer != nullptr) {
+                DAWN_TRY_CONTEXT(ValidateInputBuffer(device, data.AABBBuffer),
+                                 "validating AABBBuffer");
+                const uint64_t requiredSize =
+                    data.primitiveCount == 0
+                        ? 0
+                        : (uint64_t(data.primitiveCount) - 1) * data.AABBStride +
+                              kAccelerationStructureAABBSize;
+                DAWN_TRY(
+                    ValidateInputRange(data.AABBBuffer, data.AABBOffset, requiredSize, "AABB"));
+            }
+            break;
+        }
+
+        default:
+            DAWN_UNREACHABLE();
+    }
+
+    return {};
+}
