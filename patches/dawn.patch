+class Device;
+
+class AccelerationStructure final : public AccelerationStructureBase {
+  public:
+    static ResultOrError<Ref<AccelerationStructure>> Create(
+        Device* device,
+        const UnpackedPtr<AccelerationStructureDescriptor>& descriptor);
+
+    // VK_NULL_HANDLE after the acceleration structure is destroyed.
+    VkAccelerationStructureKHR GetHandle() const;
+    // The address used to reference this bottom-level acceleration structure in instances.
+    VkDeviceAddress GetDeviceAddress() const;
+
+    BufferBase* GetInstanceBuffer() const override;
+
+    // Records the (validated) build or update of the acceleration structure in
+    // `recordingContext`, including the synchronization with previous and later commands.
+    void RecordBuild(CommandRecordingContext* recordingContext,
+                     const BuildAccelerationStructureCmd& build,
+                     Span<const BuildAccelerationStructureGeometryCmd> geometries);
+
+  private:
+    AccelerationStructure(Device* device,
+                          const UnpackedPtr<AccelerationStructureDescriptor>& descriptor);
+    ~AccelerationStructure() override;
+
+    MaybeError Initialize();
+    void DestroyImpl(DestroyReason reason) override;
+    void SetLabelImpl() override;
+    MaybeError WriteInstancesImpl(uint32_t firstInstance,
+                                  Span<AccelerationStructureBase* const> blases,
+                                  Span<const std::byte> data) override;
+
+    // Creates a buffer with dedicated memory (sub-)allocated from the device local memory.
+    MaybeError CreateBufferWithMemory(VkDeviceSize size,
+                                      VkBufferUsageFlags usage,
+                                      VkDeviceSize alignment,
+                                      VkBuffer* buffer,
+                                      ResourceMemoryAllocation* allocation);
+
+    // Returns the Vulkan geometry descriptions used for builds and size queries. The addresses
+    // and counts are filled by the caller.
+    std::vector<VkAccelerationStructureGeometryKHR> GetVkGeometries() const;
+
+    // Records a build (or update) with `instanceCount` instances for top-level acceleration
+    // structures or `geometries` for bottom-level ones. Empty `geometries` means a build with no
+    // primitives in each of the geometries.
+    void RecordBuildImpl(CommandRecordingContext* recordingContext,
+                         bool update,
+                         uint32_t instanceCount,
+                         Span<const BuildAccelerationStructureGeometryCmd> geometries);
+
+    // Records vkCmdBuildAccelerationStructuresKHR and the barriers around it.
+    void RecordBuildCommand(CommandRecordingContext* recordingContext,
+                            bool update,
+                            const std::vector<VkAccelerationStructureGeometryKHR>& geometries,
+                            const std::vector<VkAccelerationStructureBuildRangeInfoKHR>& ranges);
+
+    VkAccelerationStructureTypeKHR mVkType = VK_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL_KHR;
+    VkBuildAccelerationStructureFlagsKHR mBuildFlags = 0;
+
+    VkAccelerationStructureKHR mHandle = VK_NULL_HANDLE;
+    VkDeviceAddress mDeviceAddress = 0;
+
+    // The buffer storing the acceleration structure.
+    VkBuffer mStorageBuffer = VK_NULL_HANDLE;
+    ResourceMemoryAllocation mStorageAllocation;
+
+    // The scratch buffer used by builds and updates of this acceleration structure.
+    VkBuffer mScratchBuffer = VK_NULL_HANDLE;
+    ResourceMemoryAllocation mScratchAllocation;
+    VkDeviceAddress mScratchAddress = 0;
+
+    // For top-level acceleration structures: the VkAccelerationStructureInstanceKHR for each
+    // instance.
+    Ref<Buffer> mInstanceBuffer;
+};
+
+}  // namespace dawn::native::vulkan
