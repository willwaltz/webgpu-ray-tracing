+TEST_F(ResolverRayQueryWgslTest, Uniformity_ProceedResultIsNonUniform) {
+    ExpectErrorContains(
+        WithTlas(R"(
+@group(0) @binding(1) var t : texture_2d<f32>;
+@group(0) @binding(2) var s : sampler;
+@fragment fn main() -> @location(0) vec4f {
+  var rq : ray_query;
+  rayQueryInitialize(&rq, tlas, RayDesc());
+  if (rayQueryProceed(&rq)) {
+    return textureSample(t, s, vec2f());
+  }
+  return vec4f();
+}
+)"),
+        R"(10:12 error: 'textureSample' must only be called from uniform control flow
+9:3 note: control flow depends on possibly non-uniform value
+9:7 note: return value of 'rayQueryProceed' may be non-uniform)");
+}
