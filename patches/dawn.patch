+// Validation of the destination and mode of builds.
+TEST_P(AccelerationStructureValidationTests, BuildInvalidDestinationOrMode) {
+    wgpu::AccelerationStructure tlas = CreateTlas(1);
+
+    // The destination must be set. (The wire client can't serialize null non-optional objects.)
+    if (!UsesWire()) {
+        wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+        wgpu::AccelerationStructureBuildDescriptor descriptor;
+        descriptor.mode = wgpu::AccelerationStructureBuildMode::Build;
+        encoder.BuildAccelerationStructure(&descriptor);
+        ASSERT_DEVICE_ERROR(encoder.Finish());
+    }
+
+    // The destination must be valid.
+    {
+        wgpu::AccelerationStructure errorTlas;
+        ASSERT_DEVICE_ERROR(errorTlas = CreateTlas(0));
+        wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+        EncodeBuild(encoder, errorTlas, {});
+        ASSERT_DEVICE_ERROR(encoder.Finish());
+    }
+
+    // An undefined mode defaults to Build (an update would fail since the TLAS doesn't have the
+    // AllowUpdate flag).
+    Build(tlas, {}, 0, wgpu::AccelerationStructureBuildMode::Undefined);
+
+    // The mode must be valid.
+    {
+        wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+        EncodeBuild(encoder, tlas, {}, 0, static_cast<wgpu::AccelerationStructureBuildMode>(0x42));
+        ASSERT_DEVICE_ERROR(encoder.Finish());
+    }
+
+    // Builds can't be encoded while a pass is open.
+    {
+        wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+        wgpu::ComputePassEncoder pass = encoder.BeginComputePass();
+        EncodeBuild(encoder, tlas, {});
+        pass.End();
+        ASSERT_DEVICE_ERROR(encoder.Finish());
+    }
+
+    // Building a destroyed acceleration structure is an error at submit time.
+    {
+        wgpu::CommandBuffer commands = EncodeBuildCommands(tlas, {});
+        tlas.Destroy();
+        ASSERT_DEVICE_ERROR(queue.Submit(1, &commands));
+    }
+}
