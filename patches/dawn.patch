+AccelerationStructureBase* BindGroupBase::GetBindingAsAccelerationStructure(
+    BindingIndex bindingIndex) const {
+    DAWN_CHECK(!IsError());
+    const BindGroupLayoutInternalBase* layout = GetLayout();
+    DAWN_CHECK(bindingIndex < layout->GetBindingCount());
+    DAWN_CHECK(std::holds_alternative<AccelerationStructureBindingInfo>(
+        layout->GetBindingInfo(bindingIndex).bindingLayout));
+    return static_cast<AccelerationStructureBase*>(mBindingData.bindings[bindingIndex].Get());
