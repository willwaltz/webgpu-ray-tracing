+TEST_F(SpirvWriter_RayQueryTest, VarInLoop) {
+    auto* fn = b.Function("foo", ty.void_());
+    b.Append(fn->Block(), [&] {
+        auto* loop = b.Loop();
+        b.Append(loop->Body(), [&] {
+            auto* rq = b.Var("rq", ty.ptr(function, ty.ray_query()));
+            b.Call(ty.void_(), core::BuiltinFn::kRayQueryTerminate, rq);
+            b.Continue(loop);
+        });
+        b.Append(loop->Continuing(), [&] { b.BreakIf(loop, true); });
+        b.Return(fn);
+    });
+
+    auto* src = R"(
+%foo = func():void {
+  $B1: {
+    loop [b: $B2, c: $B3] {  # loop_1
+      $B2: {  # body
+        %rq:ptr<function, ray_query, read_write> = var undef
+        %3:void = rayQueryTerminate %rq
+        continue  # -> $B3
+      }
+      $B3: {  # continuing
+        break_if true  # -> [t: exit_loop loop_1, f: $B2]
+      }
+    }
+    ret
+  }
+}
+)";
+    EXPECT_EQ(src, str());
+
+    // The state is explicitly initialized at the point of declaration of the ray query, so that it
+    // is reset on each iteration of the loop.
+    auto* expect = R"(
+tint_ray_query_state = struct @align(4) {
+  state:u32 @offset(0)
+  t_max:f32 @offset(4)
+}
+
+%foo = func():void {
+  $B1: {
+    loop [b: $B2, c: $B3] {  # loop_1
+      $B2: {  # body
+        %rq:ptr<function, ray_query, read_write> = var undef
+        %rq_state:ptr<function, tint_ray_query_state, read_write> = var tint_ray_query_state(0u, 0.0f)
+        %4:ptr<function, u32, read_write> = access %rq_state, 0u
+        %5:u32 = load %4
+        %6:bool = eq %5, 2u
+        if %6 [t: $B4] {  # if_1
+          $B4: {  # true
+            %7:void = spirv.ray_query_terminate %rq
+            exit_if  # if_1
+          }
+        }
+        %8:bool = eq %5, 1u
+        %9:bool = or %8, %6
+        if %9 [t: $B5] {  # if_2
+          $B5: {  # true
+            %10:ptr<function, u32, read_write> = access %rq_state, 0u
+            store %10, 3u
+            exit_if  # if_2
+          }
+        }
+        continue  # -> $B3
+      }
+      $B3: {  # continuing
+        break_if true  # -> [t: exit_loop loop_1, f: $B2]
+      }
+    }
+    ret
+  }
+}
+)";
+
+    Run(RayQuery);
+
+    EXPECT_EQ(expect, str());
+}
