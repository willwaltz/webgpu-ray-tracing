+// Validation of CommandEncoder::CopyBufferToAccelerationStructureTransforms.
+TEST_P(AccelerationStructureValidationTests, CopyTransforms) {
+    wgpu::AccelerationStructure blas = CreateBuiltTriangleBlas();
+    wgpu::AccelerationStructure tlas = CreateTlas(4);
+    wgpu::Buffer transforms = CreateBuffer(3 * 48, wgpu::BufferUsage::Storage);
+
+    auto Copy = [&](const wgpu::Buffer& source, uint64_t sourceOffset,
+                    const wgpu::AccelerationStructure& destination, uint32_t firstInstance,
+                    uint32_t instanceCount) {
+        wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+        encoder.CopyBufferToAccelerationStructureTransforms(source, sourceOffset, destination,
+                                                            firstInstance, instanceCount);
+        return encoder.Finish();
+    };
+    auto Submit = [&](const wgpu::CommandBuffer& commands) { queue.Submit(1, &commands); };
+
+    // Success cases.
+    Submit(Copy(transforms, 0, tlas, 0, 3));
+    Submit(Copy(transforms, 48, tlas, 3, 1));
+    Submit(Copy(transforms, 96, tlas, 1, 1));
+    Submit(Copy(transforms, 144, tlas, 4, 0));
+
+    // The source must have the Storage usage, a 16-byte aligned offset, and the transforms.
+    ASSERT_DEVICE_ERROR(Copy(CreateBuffer(3 * 48), 0, tlas, 0, 1));
+    ASSERT_DEVICE_ERROR(Copy(transforms, 8, tlas, 0, 1));
+    ASSERT_DEVICE_ERROR(Copy(transforms, 112, tlas, 0, 1));
+    ASSERT_DEVICE_ERROR(Copy(transforms, 0, tlas, 0, 4));
+
+    // The instances must fit in the TLAS.
+    ASSERT_DEVICE_ERROR(Copy(transforms, 0, tlas, 2, 3));
+    ASSERT_DEVICE_ERROR(Copy(transforms, 0, tlas, 0xFFFF'FFFFu, 1));
+
+    // The destination must be a valid, non-destroyed TLAS.
+    ASSERT_DEVICE_ERROR(Copy(transforms, 0, blas, 0, 1));
+    {
+        wgpu::AccelerationStructure errorTlas;
+        ASSERT_DEVICE_ERROR(errorTlas = CreateTlas(0));
+        ASSERT_DEVICE_ERROR(Copy(transforms, 0, errorTlas, 0, 0));
+    }
+    {
+        wgpu::AccelerationStructure destroyedTlas = CreateTlas(1);
+        destroyedTlas.Destroy();
+        ASSERT_DEVICE_ERROR(Copy(transforms, 0, destroyedTlas, 0, 1));
+    }
+
+    // The TLAS and the source must not be destroyed at submit.
+    {
+        wgpu::AccelerationStructure destroyedTlas = CreateTlas(1);
+        wgpu::CommandBuffer commands = Copy(transforms, 0, destroyedTlas, 0, 1);
+        destroyedTlas.Destroy();
+        ASSERT_DEVICE_ERROR(Submit(commands));
+    }
+    {
+        wgpu::Buffer destroyedSource = CreateBuffer(48, wgpu::BufferUsage::Storage);
+        wgpu::CommandBuffer commands = Copy(destroyedSource, 0, tlas, 0, 1);
+        destroyedSource.Destroy();
+        ASSERT_DEVICE_ERROR(Submit(commands));
+    }
+}
