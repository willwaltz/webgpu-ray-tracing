+MaybeError ValidateGeometryLayout(const AccelerationStructureGeometryLayout& layout) {
+    DAWN_TRY(ValidateAccelerationStructureGeometryType(layout.type));
+    DAWN_TRY(ValidateAccelerationStructureGeometryFlags(layout.flags));
+
+    switch (layout.type) {
+        case wgpu::AccelerationStructureGeometryType::Triangles:
+            DAWN_TRY(ValidateVertexFormat(layout.vertexFormat));
+            DAWN_INVALID_IF(GetAccelerationStructureVertexFormatSize(layout.vertexFormat) == 0,
+                            "Vertex format (%s) is not supported for acceleration structures. The "
+                            "supported formats are %s, %s, %s, %s, %s and %s.",
+                            layout.vertexFormat, wgpu::VertexFormat::Float32x2,
+                            wgpu::VertexFormat::Float32x3, wgpu::VertexFormat::Float16x2,
+                            wgpu::VertexFormat::Float16x4, wgpu::VertexFormat::Snorm16x2,
+                            wgpu::VertexFormat::Snorm16x4);
+            DAWN_INVALID_IF(layout.indexFormat != wgpu::IndexFormat::Undefined &&
+                                layout.indexFormat != wgpu::IndexFormat::Uint16 &&
+                                layout.indexFormat != wgpu::IndexFormat::Uint32,
+                            "Index format (%s) is not %s, %s or %s.", layout.indexFormat,
+                            wgpu::IndexFormat::Undefined, wgpu::IndexFormat::Uint16,
+                            wgpu::IndexFormat::Uint32);
+            break;
+
+        case wgpu::AccelerationStructureGeometryType::AABBs:
+            DAWN_INVALID_IF(layout.indexFormat != wgpu::IndexFormat::Undefined,
+                            "Index format (%s) is not %s for an AABB geometry.", layout.indexFormat,
+                            wgpu::IndexFormat::Undefined);
+            DAWN_INVALID_IF(layout.maxVertexCount != 0,
+                            "maxVertexCount (%u) is not 0 for an AABB geometry.",
+                            layout.maxVertexCount);
+            break;
+
+        default:
+            DAWN_UNREACHABLE();
+    }
+
+    return {};
+}
