+VkBuildAccelerationStructureFlagsKHR VulkanBuildFlags(wgpu::AccelerationStructureFlags flags) {
+    VkBuildAccelerationStructureFlagsKHR vkFlags = 0;
+    if (flags & wgpu::AccelerationStructureFlags::AllowUpdate) {
+        vkFlags |= VK_BUILD_ACCELERATION_STRUCTURE_ALLOW_UPDATE_BIT_KHR;
+    }
+    if (flags & wgpu::AccelerationStructureFlags::PreferFastTrace) {
+        vkFlags |= VK_BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_TRACE_BIT_KHR;
+    }
+    if (flags & wgpu::AccelerationStructureFlags::PreferFastBuild) {
+        vkFlags |= VK_BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_BUILD_BIT_KHR;
+    }
+    if (flags & wgpu::AccelerationStructureFlags::LowMemory) {
+        vkFlags |= VK_BUILD_ACCELERATION_STRUCTURE_LOW_MEMORY_BIT_KHR;
+    }
+    return vkFlags;
+}
+
+VkGeometryFlagsKHR VulkanGeometryFlags(wgpu::AccelerationStructureGeometryFlags flags) {
+    VkGeometryFlagsKHR vkFlags = 0;
+    if (flags & wgpu::AccelerationStructureGeometryFlags::Opaque) {
+        vkFlags |= VK_GEOMETRY_OPAQUE_BIT_KHR;
+    }
+    if (flags & wgpu::AccelerationStructureGeometryFlags::NoDuplicateAnyHit) {
+        vkFlags |= VK_GEOMETRY_NO_DUPLICATE_ANY_HIT_INVOCATION_BIT_KHR;
+    }
+    return vkFlags;
+}
+
+VkFormat VulkanVertexFormat(wgpu::VertexFormat format) {
+    // These formats are required to support
+    // VK_FORMAT_FEATURE_ACCELERATION_STRUCTURE_VERTEX_BUFFER_BIT_KHR when the accelerationStructure
+    // feature is supported.
+    switch (format) {
+        case wgpu::VertexFormat::Float32x2:
+            return VK_FORMAT_R32G32_SFLOAT;
+        case wgpu::VertexFormat::Float32x3:
+            return VK_FORMAT_R32G32B32_SFLOAT;
+        case wgpu::VertexFormat::Float16x2:
+            return VK_FORMAT_R16G16_SFLOAT;
+        case wgpu::VertexFormat::Float16x4:
+            return VK_FORMAT_R16G16B16A16_SFLOAT;
+        case wgpu::VertexFormat::Snorm16x2:
+            return VK_FORMAT_R16G16_SNORM;
+        case wgpu::VertexFormat::Snorm16x4:
+            return VK_FORMAT_R16G16B16A16_SNORM;
+        default:
+            DAWN_UNREACHABLE();
+    }
+}
+
+VkIndexType VulkanIndexType(wgpu::IndexFormat format) {
+    switch (format) {
+        case wgpu::IndexFormat::Undefined:
+            return VK_INDEX_TYPE_NONE_KHR;
+        case wgpu::IndexFormat::Uint16:
+            return VK_INDEX_TYPE_UINT16;
+        case wgpu::IndexFormat::Uint32:
+            return VK_INDEX_TYPE_UINT32;
+    }
+    DAWN_UNREACHABLE();
+}
