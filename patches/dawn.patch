+    wgpu::AccelerationStructure tlas = CreateTlas(2);
+    WriteInstances(tlas, 0, {blas, aabbBlas}, {MakeInstance(0), MakeInstance(1)});
+    Build(tlas, {}, 2);
+    CheckTlasCanBeUsedInComputePass(tlas);
+}
+
+// Several builds, instance writes and uses in a row, including builds of BLASes and TLASes in the
+// same command buffer, and instance writes while the previous build is in flight.
+TEST_P(AccelerationStructureBuildTests, ManyBuildsAndWrites) {
+    wgpu::Buffer vertexBuffer = CreateInputBuffer(TriangleVertices(1.0));
+    wgpu::AccelerationStructure blasA = CreateBlas({TriangleLayout(3, 1)});
+    wgpu::AccelerationStructure blasB = CreateBlas({TriangleLayout(3, 1)});
+    wgpu::AccelerationStructure tlas = CreateTlas(8);
+
+    for (uint32_t i = 0; i < 4; ++i) {
+        std::vector<InstanceRecord> instances;
+        for (uint32_t j = 0; j < 8; ++j) {
+            instances.push_back((i + j) % 3 == 0 ? MakeInstance(kInactiveInstance)
+                                                 : MakeInstance(j % 2, j, {float(j), 0, 0}));
+        }
+        WriteInstances(tlas, 0, {blasA, blasB}, instances);
+
+        wgpu::Buffer result = CreateResultBuffer();
+        wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+        EncodeBuild(encoder, blasA, {TriangleData(vertexBuffer, 3, 1)});
+        EncodeBuild(encoder, blasB, {TriangleData(vertexBuffer, 3, i % 2)});
+        EncodeBuild(encoder, tlas, {}, 8 - i);
+        EncodeComputePassUsingTlas(encoder, tlas, result);
+        wgpu::CommandBuffer commands = encoder.Finish();
+        queue.Submit(1, &commands);
+        EXPECT_BUFFER_U32_EQ(42u, result, 0);
+    }
+}
+
+// Acceleration structures and their inputs can be destroyed right after being used.
+TEST_P(AccelerationStructureBuildTests, DestroyAfterSubmit) {
+    for (uint32_t i = 0; i < 3; ++i) {
+        wgpu::Buffer vertexBuffer = CreateInputBuffer(TriangleVertices(1.0));
+        wgpu::AccelerationStructure blas = CreateBlas({TriangleLayout(3, 1)});
+        wgpu::AccelerationStructure tlas = CreateTlas(1);
+        WriteInstances(tlas, 0, {blas}, {MakeInstance(0)});
+
+        wgpu::Buffer result = CreateResultBuffer();
+        wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+        EncodeBuild(encoder, blas, {TriangleData(vertexBuffer, 3, 1)});
+        EncodeBuild(encoder, tlas, {}, 1);
+        EncodeComputePassUsingTlas(encoder, tlas, result);
+        wgpu::CommandBuffer commands = encoder.Finish();
+        queue.Submit(1, &commands);
+
+        vertexBuffer.Destroy();
+        tlas.Destroy();
+        blas.Destroy();
+        EXPECT_BUFFER_U32_EQ(42u, result, 0);
+    }
+}
