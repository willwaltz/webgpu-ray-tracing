+// At most 16 acceleration structures can be used by a pipeline layout.
+TEST_P(AccelerationStructureValidationTests, BindingCountLimit) {
+    constexpr uint32_t kMaxAccelerationStructures = 16;
+    wgpu::AccelerationStructureBindingLayout accelerationStructureLayout;
+    auto CreateLayout = [&](uint32_t count) {
+        std::vector<wgpu::BindGroupLayoutEntry> entries(count);
+        for (uint32_t i = 0; i < count; ++i) {
+            entries[i].binding = i;
+            entries[i].visibility = wgpu::ShaderStage::Compute | wgpu::ShaderStage::Fragment;
+            entries[i].nextInChain = &accelerationStructureLayout;
+        }
+        wgpu::BindGroupLayoutDescriptor descriptor;
+        descriptor.entryCount = entries.size();
+        descriptor.entries = entries.data();
+        return device.CreateBindGroupLayout(&descriptor);
+    };
+
+    CreateLayout(kMaxAccelerationStructures);
+    ASSERT_DEVICE_ERROR(CreateLayout(kMaxAccelerationStructures + 1));
+
+    // The limit applies to the whole pipeline layout.
+    wgpu::BindGroupLayout half = CreateLayout(kMaxAccelerationStructures / 2);
+    utils::MakePipelineLayout(device, {half, half});
+    wgpu::BindGroupLayout halfPlusOne = CreateLayout(kMaxAccelerationStructures / 2 + 1);
+    ASSERT_DEVICE_ERROR(utils::MakePipelineLayout(device, {half, halfPlusOne}));
+}
