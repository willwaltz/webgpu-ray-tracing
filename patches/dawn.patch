+void CommandEncoder::APIBuildAccelerationStructure(
+    const AccelerationStructureBuildDescriptor* rawDescriptor) {
+    mEncodingContext.TryEncode(
+        this,
+        [&](CommandAllocator* allocator) -> MaybeError {
+            AccelerationStructureBuildDescriptor descriptor =
+                WithTrivialFrontendDefaults(*rawDescriptor);
+
+            if (GetDevice()->IsValidationEnabled()) {
+                // There are no chained structs for AccelerationStructureBuildDescriptor, this
+                // checks that nextInChain is nullptr.
+                [[maybe_unused]] UnpackedPtr<AccelerationStructureBuildDescriptor> unpacked;
+                DAWN_TRY_ASSIGN(unpacked, ValidateAndUnpack(rawDescriptor));
+                DAWN_TRY(ValidateAccelerationStructureBuildDescriptor(GetDevice(), descriptor));
+            } else {
+                DAWN_TRY(GetDevice()->IsNotErrorObject(descriptor.destination));
+            }
+
+            AccelerationStructureBase* destination = descriptor.destination;
+
+            BuildAccelerationStructureCmd* cmd = allocator->Allocate<BuildAccelerationStructureCmd>(
+                Command::BuildAccelerationStructure);
+            cmd->destination = destination;
+            cmd->mode = descriptor.mode;
+            if (destination->IsTopLevel()) {
+                cmd->instanceCount = descriptor.instanceCount;
+            } else {
+                cmd->geometryCount = descriptor.geometries.size();
+            }
+
+            if (cmd->geometryCount > 0) {
+                const std::vector<AccelerationStructureGeometryLayout>& layouts =
+                    destination->GetGeometryLayouts();
+                DAWN_CHECK(layouts.size() == descriptor.geometries.size());
+
+                Span<BuildAccelerationStructureGeometryCmd> geometries =
+                    allocator->AllocateData<BuildAccelerationStructureGeometryCmd>(
+                        cmd->geometryCount);
+                for (auto [i, data] : Enumerate(descriptor.geometries)) {
+                    const AccelerationStructureGeometryLayout& layout = layouts[i];
+                    BuildAccelerationStructureGeometryCmd& geometry = geometries[i];
+                    geometry.primitiveCount = data.primitiveCount;
+
+                    switch (layout.type) {
+                        case wgpu::AccelerationStructureGeometryType::Triangles:
+                            geometry.vertexBuffer = data.vertexBuffer;
+                            geometry.vertexOffset = data.vertexOffset;
+                            geometry.vertexStride =
+                                data.vertexStride != 0
+                                    ? data.vertexStride
+                                    : GetAccelerationStructureVertexFormatSize(layout.vertexFormat);
+                            geometry.vertexCount = data.vertexCount;
+                            if (layout.indexFormat != wgpu::IndexFormat::Undefined) {
+                                geometry.indexBuffer = data.indexBuffer;
+                                geometry.indexOffset = data.indexOffset;
+                            }
+                            break;
+                        case wgpu::AccelerationStructureGeometryType::AABBs:
+                            geometry.aabbBuffer = data.AABBBuffer;
+                            geometry.aabbOffset = data.AABBOffset;
+                            geometry.aabbStride = data.AABBStride;
+                            break;
+                        default:
+                            DAWN_UNREACHABLE();
+                    }
+
+                    for (BufferBase* buffer :
+                         {geometry.vertexBuffer.Get(), geometry.indexBuffer.Get(),
+                          geometry.aabbBuffer.Get()}) {
+                        if (buffer != nullptr) {
+                            mTopLevelBuffers.insert(buffer);
+                        }
+                    }
+                }
+            }
+
+            AccelerationStructureBuildRecord record;
+            record.accelerationStructure = destination;
+            record.mode = descriptor.mode;
+            record.shape = ComputeAccelerationStructureBuildShape(descriptor);
+            record.renderPassesBefore = mEncodingContext.GetRenderPassUsages().size();
+            record.computePassesBefore = mEncodingContext.GetComputePassUsages().size();
+            mAccelerationStructureBuilds.push_back(std::move(record));
+
+            return {};
+        },
+        "encoding %s.BuildAccelerationStructure(destination: %s).", this,
+        rawDescriptor->destination);
+}
+
+void CommandEncoder::APICopyBufferToAccelerationStructureTransforms(
+    BufferBase* source,
+    uint64_t sourceOffset,
+    AccelerationStructureBase* destination,
+    uint32_t firstInstance,
+    uint32_t instanceCount) {
+    mEncodingContext.TryEncode(
+        this,
+        [&](CommandAllocator*) -> MaybeError {
+            // Validated even with validation disabled: the bound ranges must stay in the buffers.
+            DAWN_TRY(ValidateCopyBufferToAccelerationStructureTransforms(
+                GetDevice(), source, sourceOffset, destination, firstInstance, instanceCount));
+            if (instanceCount == 0) {
+                return {};
+            }
+
+            auto deviceGuard = GetDevice()->GetGuard();
+            return EncodeCopyBufferToAccelerationStructureTransforms(
+                this, source, sourceOffset, destination, firstInstance, instanceCount);
+        },
+        "encoding %s.CopyBufferToAccelerationStructureTransforms(%s, %u, %s, %u, %u).", this,
+        source, sourceOffset, destination, firstInstance, instanceCount);
+}
