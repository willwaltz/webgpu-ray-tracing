+// Updates must use the same number of primitives and vertices as the build they update.
+TEST_P(AccelerationStructureValidationTests, UpdateMustKeepCounts) {
+    constexpr auto kUpdate = wgpu::AccelerationStructureBuildMode::Update;
+    wgpu::Buffer vertices = CreateInputBuffer(std::vector<float>(18, 0.0f));
+    wgpu::AccelerationStructure blas = CreateBlas({TriangleLayout(6, 2), TriangleLayout(6, 2)},
+                                                  wgpu::AccelerationStructureFlags::AllowUpdate);
+
+    // Acceleration structures start with an empty build, that can be updated.
+    Build(blas, {TriangleData(nullptr, 0, 0), TriangleData(nullptr, 0, 0)}, 0, kUpdate);
+    wgpu::CommandBuffer commands = EncodeBuildCommands(
+        blas, {TriangleData(vertices, 3, 1), TriangleData(nullptr, 0, 0)}, 0, kUpdate);
+    ASSERT_DEVICE_ERROR(queue.Submit(1, &commands));
+
+    Build(blas, {TriangleData(vertices, 3, 1), TriangleData(vertices, 6, 2)});
+    Build(blas, {TriangleData(vertices, 3, 1), TriangleData(vertices, 6, 2)}, 0, kUpdate);
+
+    // Different primitive counts.
+    commands = EncodeBuildCommands(
+        blas, {TriangleData(vertices, 3, 1), TriangleData(vertices, 6, 1)}, 0, kUpdate);
+    ASSERT_DEVICE_ERROR(queue.Submit(1, &commands));
+
+    // Different vertex counts.
+    commands = EncodeBuildCommands(
+        blas, {TriangleData(vertices, 4, 1), TriangleData(vertices, 6, 2)}, 0, kUpdate);
+    ASSERT_DEVICE_ERROR(queue.Submit(1, &commands));
+
+    // Updates of TLASes must have the same instance count.
+    wgpu::AccelerationStructure tlas = CreateTlas(2, wgpu::AccelerationStructureFlags::AllowUpdate);
+    Build(tlas, {}, 2);
+    Build(tlas, {}, 2, kUpdate);
+    commands = EncodeBuildCommands(tlas, {}, 1, kUpdate);
+    ASSERT_DEVICE_ERROR(queue.Submit(1, &commands));
