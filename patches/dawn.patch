+Struct* CreateRayDesc(Manager& types, SymbolTable& symbols) {
+    auto symbol = symbols.Register(tint::ToString(core::BuiltinType::kRayDesc));
+    if (auto* existing = types.Find<type::Struct>(symbol, /* is_wgsl_internal */ true)) {
+        return existing;
+    }
+    auto* vec3f = types.vec3(types.f32());
+    return types.WgslInternalStruct(symbol, {
+                                                {symbols.Register("flags"), types.u32()},
+                                                {symbols.Register("cull_mask"), types.u32()},
+                                                {symbols.Register("t_min"), types.f32()},
+                                                {symbols.Register("t_max"), types.f32()},
+                                                {symbols.Register("origin"), vec3f},
+                                                {symbols.Register("dir"), vec3f},
+                                            });
+}
+
+Struct* CreateRayIntersection(Manager& types, SymbolTable& symbols) {
+    auto symbol = symbols.Register(tint::ToString(core::BuiltinType::kRayIntersection));
+    if (auto* existing = types.Find<type::Struct>(symbol, /* is_wgsl_internal */ true)) {
+        return existing;
+    }
+    auto* mat4x3f = types.mat4x3(types.f32());
+    return types.WgslInternalStruct(symbol,
+                                    {
+                                        {symbols.Register("kind"), types.u32()},
+                                        {symbols.Register("t"), types.f32()},
+                                        {symbols.Register("instance_custom_data"), types.u32()},
+                                        {symbols.Register("instance_index"), types.u32()},
+                                        {symbols.Register("sbt_record_offset"), types.u32()},
+                                        {symbols.Register("geometry_index"), types.u32()},
+                                        {symbols.Register("primitive_index"), types.u32()},
+                                        {symbols.Register("barycentrics"), types.vec2(types.f32())},
+                                        {symbols.Register("front_face"), types.bool_()},
+                                        {symbols.Register("object_to_world"), mat4x3f},
+                                        {symbols.Register("world_to_object"), mat4x3f},
+                                    });
+}
+
+namespace {
+bool IsBuiltinStructNamed(const Type* ty, core::BuiltinType builtin) {
+    if (auto* s = ty->As<Struct>()) {
+        return s->IsWgslInternal() && s->Name().NameView() == tint::ToString(builtin);
+    }
+    return false;
+}
+}  // namespace
+
+bool IsRayDesc(const Type* ty) {
+    return IsBuiltinStructNamed(ty, core::BuiltinType::kRayDesc);
+}
+
+bool IsRayIntersection(const Type* ty) {
+    return IsBuiltinStructNamed(ty, core::BuiltinType::kRayIntersection);
+}
+
 }  // namespace tint::core::type
