+@fragment fn main() -> @location(0) vec4f {
+  var rq : ray_query;
+  rayQueryInitialize(&rq, tlas, RayDesc());
+  let i = rayQueryGetCommittedIntersection(&rq);
+  if (i.kind == 1u) {
+    return textureSample(t, s, vec2f());
+  }
+  return vec4f();
+}
+)"),
+                        "note: return value of 'rayQueryGetCommittedIntersection' may be "
