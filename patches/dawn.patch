+TEST(SpirvWriterOptionHelpersTest, AccelerationStructure_Valid) {
+    Options options;
+    options.bindings.storage.emplace(BindingPoint{0, 0}, BindingPoint{0, 0});
+    options.bindings.acceleration_structure.emplace(BindingPoint{0, 1}, BindingPoint{2, 3});
+
+    auto res = ValidateBindingOptions(options);
+    EXPECT_EQ(res, Success);
+}
+
+TEST(SpirvWriterOptionHelpersTest, AccelerationStructure_DuplicateWgslBindingPoint) {
+    Options options;
+    options.bindings.storage.emplace(BindingPoint{0, 0}, BindingPoint{0, 0});
+    options.bindings.acceleration_structure.emplace(BindingPoint{0, 0}, BindingPoint{0, 1});
+
+    auto res = ValidateBindingOptions(options);
+    EXPECT_NE(res, Success);
+    EXPECT_EQ(res.Failure().reason,
+              R"(error: found duplicate WGSL binding point: [group: 0, binding: 0]
+note: when processing acceleration_structure)");
+}
+
+TEST(SpirvWriterOptionHelpersTest, AccelerationStructure_DuplicateSpirvBindingPoint) {
+    Options options;
+    options.bindings.texture.emplace(BindingPoint{0, 0}, BindingPoint{1, 1});
+    options.bindings.acceleration_structure.emplace(BindingPoint{0, 1}, BindingPoint{1, 1});
+
+    auto res = ValidateBindingOptions(options);
+    EXPECT_NE(res, Success);
+    EXPECT_EQ(res.Failure().reason,
+              R"(error: found duplicate SPIR-V binding point: [group: 1, binding: 1]
+note: when processing acceleration_structure)");
+}
+
+TEST(SpirvWriterOptionHelpersTest, AccelerationStructure_Remapping) {
+    Options options;
+    options.bindings.acceleration_structure.emplace(BindingPoint{0, 1}, BindingPoint{2, 3});
+
+    RemapperData remapper_data;
+    tint::transform::multiplanar::BindingsMap multiplanar_map;
+    PopulateRemapperAndMultiplanarOptions(options, remapper_data, multiplanar_map);
+    ASSERT_EQ(remapper_data.size(), 1u);
+    EXPECT_EQ(remapper_data[(BindingPoint{0, 1})], (BindingPoint{2, 3}));
+    EXPECT_TRUE(multiplanar_map.empty());
+}
