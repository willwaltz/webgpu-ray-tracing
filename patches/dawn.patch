+// Validation of the buffers of AABB geometries.
+TEST_P(AccelerationStructureValidationTests, BuildAABBBuffers) {
+    // Room for 2 AABBs with a 32-byte stride.
+    wgpu::Buffer aabbs = CreateBuffer(64);
+    wgpu::AccelerationStructure blas = CreateBlas({AABBLayout(2)});
+
+    auto Data = [&](uint64_t offset, uint64_t stride, uint32_t count) {
+        wgpu::AccelerationStructureGeometryData data = AABBData(aabbs, count);
+        data.AABBOffset = offset;
+        data.AABBStride = stride;
+        return data;
+    };
+
+    // Success cases, the last AABB can end at the end of the buffer.
+    Build(blas, {Data(0, 32, 2)});
+    Build(blas, {Data(64 - 24 - 24, 24, 2)});
+    Build(blas, {Data(0, 24, 0)});
+    Build(blas, {AABBData(nullptr, 0)});
+
+    // The AABB buffer is required when there are AABBs.
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {AABBData(nullptr, 1)}));
+
+    // The AABBs must be in bounds.
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {Data(16, 32, 2)}));
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {Data(72, 24, 1)}));
+
+    // The offset and stride must be multiples of 8.
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {Data(4, 24, 1)}));
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {Data(0, 28, 1)}));
+
+    // The stride must fit in 32 bits.
+    ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {Data(0, uint64_t(1) << 32, 1)}));
+
+    // The number of AABBs is limited by the layout.
+    {
+        wgpu::Buffer moreAABBs = CreateBuffer(24 * 3);
+        ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {AABBData(moreAABBs, 3)}));
+    }
+
+    // AABB geometries don't have vertices or indices.
+    {
+        wgpu::AccelerationStructureGeometryData data = Data(0, 24, 1);
+        data.vertexBuffer = CreateBuffer(64);
+        ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {data}));
+    }
+    {
+        wgpu::AccelerationStructureGeometryData data = Data(0, 24, 1);
+        data.indexBuffer = CreateBuffer(64);
+        ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {data}));
+    }
+    {
+        wgpu::AccelerationStructureGeometryData data = Data(0, 24, 1);
+        data.vertexCount = 3;
+        ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {data}));
+    }
+
+    // The AABB buffer must have the AccelerationStructureInput usage.
+    {
+        wgpu::Buffer storageOnly =
+            CreateBuffer(64, wgpu::BufferUsage::Storage | wgpu::BufferUsage::CopyDst);
+        ASSERT_DEVICE_ERROR(EncodeBuildCommands(blas, {AABBData(storageOnly, 1)}));
+    }
+}
