+////////////////////////////////////////////////////////////////////////////////
+// Ray queries
+////////////////////////////////////////////////////////////////////////////////
+TEST_F(IRToProgramRoundtripTest, RayQuery_AllBuiltins) {
+    RUN_TEST(R"(
+enable chromium_experimental_ray_query;
+
+@group(0u) @binding(0u) var tlas : acceleration_structure;
+
+@compute @workgroup_size(1i, 1i, 1i)
+fn main() {
+  var rq : ray_query;
+  rayQueryInitialize(&(rq), tlas, RayDesc(1u, 255u, 0.0f, 100.0f, vec3<f32>(), vec3<f32>(0.0f, 0.0f, 1.0f)));
+  while(rayQueryProceed(&(rq))) {
+    let c = rayQueryGetCandidateIntersection(&(rq));
+    if ((c.kind == 3u)) {
+      rayQueryGenerateIntersection(&(rq), c.t);
+    } else {
+      rayQueryConfirmIntersection(&(rq));
+    }
+  }
+  let h = rayQueryGetCommittedIntersection(&(rq));
+  if ((h.kind == 0u)) {
+    rayQueryTerminate(&(rq));
+  }
+}
+)");
+}
+
+TEST_F(IRToProgramRoundtripTest, RayQuery_PointerParameters) {
+    RUN_TEST(R"(
+enable chromium_experimental_ray_query;
+
+@group(0u) @binding(0u) var tlas : acceleration_structure;
+
+var<private> prq : ray_query;
+
+fn trace(rq : ptr<function, ray_query>, accel : acceleration_structure, desc : RayDesc) -> RayIntersection {
+  rayQueryInitialize(rq, accel, desc);
+  while(rayQueryProceed(rq)) {
+    rayQueryConfirmIntersection(rq);
+  }
+  return rayQueryGetCommittedIntersection(rq);
+}
+
+fn trace_private(rq : ptr<private, ray_query>) -> bool {
+  return rayQueryProceed(rq);
+}
+
+@fragment
+fn main() -> @location(0u) vec4<f32> {
+  var rq : ray_query;
+  let i = trace(&(rq), tlas, RayDesc());
+  rayQueryInitialize(&(prq), tlas, RayDesc());
+  let p = trace_private(&(prq));
+  return vec4<f32>(i.t, f32(i.kind), i.barycentrics);
+}
+)");
+}
+
+TEST_F(IRToProgramRoundtripTest, RayQuery_RayStructs) {
+    RUN_TEST(R"(
+enable chromium_experimental_ray_query;
+
+@group(0u) @binding(0u) var<storage, read_write> descs : array<RayDesc>;
+
+struct S {
+  desc : RayDesc,
+  intersection : RayIntersection,
+}
+
+fn f() -> f32 {
+  var s : S;
+  s.desc = descs[0i];
+  s.desc.t_max = 10.0f;
+  descs[1i] = s.desc;
+  return (s.intersection.t + s.desc.t_max);
+}
+)");
+}
+
+TEST_F(IRToProgramRoundtripTest, RayQuery_ShadowedRayStructs) {
+    // User-declared structures can shadow the names of the builtin ray query structures. The
+    // user-declared structures are renamed, as the builtin type names may need to be emitted.
+    RUN_TEST(R"(
+enable chromium_experimental_ray_query;
+
+struct RayDesc {
+  a : f32,
+}
+
+struct RayIntersection {
+  b : u32,
+}
+
+@group(0u) @binding(0u) var tlas : acceleration_structure;
+
+fn f() -> f32 {
+  var rq : ray_query;
+  var i = rayQueryGetCommittedIntersection(&(rq));
+  let d = RayDesc(i.t);
+  let u = RayIntersection(i.kind);
+  return (d.a + f32(u.b));
+}
+)",
+             R"(
+enable chromium_experimental_ray_query;
+
+@group(0u) @binding(0u) var tlas : acceleration_structure;
+
+struct S {
+  a : f32,
+}
+
+struct RayIntersection_1 {
+  b : u32,
+}
+
+fn f() -> f32 {
+  var rq : ray_query;
+  var i : RayIntersection = rayQueryGetCommittedIntersection(&(rq));
+  let d = S(i.t);
+  let u = RayIntersection_1(i.kind);
+  return (d.a + f32(u.b));
+}
+)");
+}
+
