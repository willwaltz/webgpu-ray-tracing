+
+    // The second geometry is a triangle at z = 2 translated by 5 in X.
+    std::vector<float> triangle = {5, 0, 2, 6, 0, 2, 5, 1, 2};
+    wgpu::Buffer triangleBuffer = CreateInputBuffer(triangle);
+
+    wgpu::AccelerationStructure blas =
+        CreateBlas({TriangleLayout(4, 2, wgpu::IndexFormat::Uint32), TriangleLayout(3, 1)});
+    wgpu::AccelerationStructureGeometryData indexed = TriangleData(vertexBuffer, 4, 2, indexBuffer);
+    indexed.vertexOffset = 32;
+    indexed.vertexStride = 16;
