+TEST_F(InspectorGetResourceBindingsTest, AccelerationStructure) {
+    auto* src = R"(
+enable chromium_experimental_ray_query;
+
+@group(0) @binding(2) var tlas1 : acceleration_structure;
+@group(3) @binding(1) var tlas2 : acceleration_structure;
+@group(1) @binding(0) var unused : acceleration_structure;
+
+fn trace(accel : acceleration_structure) -> bool {
+  var rq : ray_query;
+  rayQueryInitialize(&rq, accel, RayDesc());
+  return rayQueryProceed(&rq);
+}
+
+@fragment
+fn main() {
+  _ = trace(tlas1);
+  _ = trace(tlas2);
+}
+)";
+
+    Inspector& inspector = Initialize(src);
+    auto result = inspector.GetResourceBindings("main");
+    ASSERT_FALSE(inspector.has_error()) << inspector.error();
+    ASSERT_EQ(2u, result.size());
+
+    EXPECT_EQ(ResourceBinding::ResourceType::kAccelerationStructure, result[0].resource_type);
+    EXPECT_EQ(0u, result[0].bind_group);
+    EXPECT_EQ(2u, result[0].binding);
+    EXPECT_EQ("tlas1", result[0].variable_name);
+
+    EXPECT_EQ(ResourceBinding::ResourceType::kAccelerationStructure, result[1].resource_type);
+    EXPECT_EQ(3u, result[1].bind_group);
+    EXPECT_EQ(1u, result[1].binding);
+    EXPECT_EQ("tlas2", result[1].variable_name);
+}
+
 TEST_F(InspectorGetResourceBindingsTest, MissingEntryPoint) {
